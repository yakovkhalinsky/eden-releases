---
import Base from '../layouts/Base.astro';
---

<Base>
  <!-- Banner -->
  <div class="banner">
    <div class="container">
      <p><strong>Private preview</strong> — invite password required until public launch. Site password is not your od3sa account.</p>
    </div>
  </div>

  <!-- Nav -->
  <header class="nav">
    <div class="container nav-inner">
      <a href="/" class="wordmark">od3sa</a>
      <nav class="nav-links">
        <a href="https://0d3sa.com/docs" class="nav-link">Docs</a>
        <a href="#install" class="nav-link">Install</a>
        <a href="#register" class="btn btn-primary btn-nav">Register</a>
      </nav>
      <button class="mobile-menu-btn" aria-label="Open menu" aria-expanded="false">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <line x1="3" y1="6" x2="21" y2="6"></line>
          <line x1="3" y1="12" x2="21" y2="12"></line>
          <line x1="3" y1="18" x2="21" y2="18"></line>
        </svg>
      </button>
    </div>
  </header>

  <!-- Mobile Nav -->
  <div class="mobile-nav" id="mobile-nav">
    <nav class="mobile-nav-links">
      <a href="https://0d3sa.com/docs" class="mobile-nav-link">Docs</a>
      <a href="#install" class="mobile-nav-link">Install</a>
      <a href="#register" class="btn btn-primary btn-full">Register</a>
    </nav>
  </div>

  <main>
    <!-- Hero -->
    <section class="hero">
      <div class="container hero-inner">
        <div class="hero-story">
          <span class="eyebrow">Memory</span>
          <h1>Memory on your machine. An account when you sync.</h1>
          <p class="hero-sub">Local-first recall for coding agents. Register for org and keys; optional sync via self-hosted relay.</p>
          <div class="hero-ctas">
            <a href="#register" class="btn btn-primary">Register</a>
            <a href="#install" class="btn btn-secondary">Install locally</a>
          </div>
          <p class="hero-trust text-mute text-small">No cloud account for local recall · Register is optional if you only run local</p>
        </div>
        <div class="hero-card-wrap" id="register">
          <div class="register-card card">
            <h2>Create account</h2>
            <p>After the site password, create your od3sa account — then org, keys, and relay connect on the staging console.</p>
            <button class="btn btn-primary btn-full" disabled aria-disabled="true">
              Create account
            </button>
            <p class="register-micro text-mute text-xs">Continues on staging console (preview — not public launch). Site password ≠ your account.</p>
            <div class="disabled-label">
              <span class="disabled-dot"></span>
              Coming soon — open signup wiring
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Why Register -->
    <section class="why-section">
      <div class="container">
        <div class="why-grid">
          <div class="why-beat">
            <h3>Org</h3>
            <p>Create or join an organisation so teammates share a control-plane home.</p>
          </div>
          <div class="why-beat">
            <h3>Devices</h3>
            <p>Issue tenant API keys and connect devices without pasting secrets in chat.</p>
          </div>
          <div class="why-beat">
            <h3>Optional relay</h3>
            <p>Point at a self-hosted <code>od3sa-relay</code> for encrypted multi-device sync (not a hosted Team product claim).</p>
          </div>
        </div>
      </div>
    </section>

    <!-- Install -->
    <section class="install-section" id="install">
      <div class="container">
        <div class="install-well card">
          <span class="install-label text-small">No account needed</span>
          <h2>Install local memory</h2>
          <p class="install-sub">One binary on your machine. Hosted on digit-zero <code>0d3sa.com</code> until launch cutover.</p>
          
          <div class="install-steps">
            <div class="install-step">
              <span class="step-num">1</span>
              <div class="code-block">
                <code>curl -fsSL https://0d3sa.com/memory/install.sh | sh</code>
              </div>
            </div>
            <div class="install-step">
              <span class="step-num">2</span>
              <div class="code-block">
                <code>cd ~/my-project && od3sa-memory setup claude</code>
              </div>
            </div>
            <div class="install-step">
              <span class="step-num">3</span>
              <div class="code-block">
                <code>od3sa-memory health</code>
              </div>
            </div>
          </div>
          
          <p class="install-hint text-mute text-small">Then ask your agent to remember something — or follow Docs.</p>
        </div>
      </div>
    </section>

    <!-- Honesty Strip -->
    <section class="honesty-section">
      <div class="container">
        <p class="honesty-text">Local recall and the <code>od3sa-memory</code> / <code>od3sa-relay</code> CLIs do not require Register. Register does not license the binaries.</p>
      </div>
    </section>
  </main>

  <!-- Footer -->
  <footer class="footer">
    <div class="container footer-inner">
      <p class="footer-copy">© 2026 0d3sa · Private preview</p>
      <nav class="footer-links">
        <a href="https://0d3sa.com/docs">Docs</a>
        <a href="mailto:support@od3sa.com">support@od3sa.com</a>
      </nav>
    </div>
  </footer>
</Base>

<style>
  /* Banner */
  .banner {
    background: var(--paper-2);
    border-bottom: 1px solid var(--line);
    padding: 12px 0;
    text-align: center;
  }

  .banner p {
    font-size: 0.875rem;
    color: var(--ink-mute);
    margin: 0;
  }

  /* Nav */
  .nav {
    position: sticky;
    top: 0;
    z-index: 100;
    background: var(--paper);
    border-bottom: 1px solid var(--line);
    padding: 16px 0;
  }

  .nav-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
  }

  .wordmark {
    font-family: var(--font-ui);
    font-size: 1.25rem;
    font-weight: 600;
    color: var(--ink);
    text-decoration: none;
    letter-spacing: -0.01em;
  }

  .wordmark:hover {
    color: var(--ink);
  }

  .nav-links {
    display: flex;
    align-items: center;
    gap: 32px;
  }

  .nav-link {
    font-size: 0.9375rem;
    font-weight: 500;
    color: var(--ink-mute);
    text-decoration: none;
  }

  .nav-link:hover {
    color: var(--ink);
  }

  .btn-nav {
    padding: 10px 20px;
    min-height: 40px;
  }

  .mobile-menu-btn {
    display: none;
    background: none;
    border: none;
    padding: 4px;
    cursor: pointer;
    color: var(--ink);
  }

  .mobile-nav {
    display: none;
    position: fixed;
    top: 65px;
    left: 0;
    right: 0;
    background: var(--paper);
    border-bottom: 1px solid var(--line);
    padding: 24px;
    z-index: 99;
  }

  .mobile-nav.open {
    display: block;
  }

  .mobile-nav-links {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .mobile-nav-link {
    font-size: 1rem;
    font-weight: 500;
    color: var(--ink);
    text-decoration: none;
    padding: 8px 0;
  }

  /* Hero */
  .hero {
    padding: 64px 0 80px;
  }

  .hero-inner {
    display: grid;
    grid-template-columns: 1fr 380px;
    gap: 48px;
    align-items: start;
  }

  .hero-story {
    padding-top: 16px;
  }

  .eyebrow {
    display: inline-block;
    font-size: 0.8125rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--clay);
    margin-bottom: 16px;
  }

  .hero h1 {
    margin-bottom: 20px;
  }

  .hero-sub {
    font-size: 1.125rem;
    line-height: 1.55;
    color: var(--ink-mute);
    margin-bottom: 28px;
    max-width: 520px;
  }

  .hero-ctas {
    display: flex;
    gap: 12px;
    margin-bottom: 20px;
  }

  .hero-trust {
    margin: 0;
  }

  /* Register Card */
  .hero-card-wrap {
    scroll-margin-top: 100px;
  }

  .register-card {
    padding: 32px;
  }

  .register-card h2 {
    margin-bottom: 12px;
  }

  .register-card > p {
    margin-bottom: 24px;
    line-height: 1.55;
  }

  .register-micro {
    margin-top: 16px;
    margin-bottom: 20px;
  }

  .disabled-label {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 0.8125rem;
    color: var(--ink-mute);
    padding: 12px 16px;
    background: var(--paper);
    border: 1px solid var(--line);
    border-radius: var(--r-sm);
  }

  .disabled-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--warn);
  }

  .btn-full {
    width: 100%;
  }

  /* Why Section */
  .why-section {
    padding: 64px 0;
    background: var(--fog);
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
  }

  .why-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 32px;
  }

  .why-beat h3 {
    margin-bottom: 8px;
  }

  .why-beat p {
    line-height: 1.55;
  }

  .why-beat code {
    background: var(--paper-2);
    padding: 2px 6px;
    border-radius: var(--r-sm);
    font-size: 0.8125rem;
  }

  /* Install Section */
  .install-section {
    padding: 80px 0;
    scroll-margin-top: 80px;
  }

  .install-well {
    max-width: 680px;
    margin: 0 auto;
    padding: 40px;
  }

  .install-label {
    display: inline-block;
    font-weight: 600;
    color: var(--good);
    margin-bottom: 12px;
  }

  .install-well h2 {
    margin-bottom: 12px;
  }

  .install-sub {
    margin-bottom: 32px;
    line-height: 1.55;
  }

  .install-sub code {
    background: var(--paper-2);
    padding: 2px 6px;
    border-radius: var(--r-sm);
    font-size: 0.875rem;
  }

  .install-steps {
    display: flex;
    flex-direction: column;
    gap: 16px;
    margin-bottom: 24px;
  }

  .install-step {
    display: flex;
    align-items: center;
    gap: 16px;
  }

  .step-num {
    flex-shrink: 0;
    width: 28px;
    height: 28px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--ink-mute);
    background: var(--paper);
    border: 1px solid var(--line);
    border-radius: 50%;
  }

  .install-step .code-block {
    flex: 1;
  }

  .install-hint {
    margin: 0;
  }

  /* Honesty Section */
  .honesty-section {
    padding: 48px 0;
    background: var(--paper-2);
    border-top: 1px solid var(--line);
  }

  .honesty-text {
    text-align: center;
    font-size: 0.9375rem;
    color: var(--ink-mute);
    max-width: 640px;
    margin: 0 auto;
  }

  .honesty-text code {
    background: var(--paper);
    padding: 2px 6px;
    border-radius: var(--r-sm);
    font-size: 0.8125rem;
  }

  /* Footer */
  .footer {
    padding: 32px 0;
    border-top: 1px solid var(--line);
  }

  .footer-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
  }

  .footer-copy {
    font-size: 0.875rem;
    color: var(--ink-mute);
    margin: 0;
  }

  .footer-links {
    display: flex;
    gap: 24px;
  }

  .footer-links a {
    font-size: 0.875rem;
    color: var(--ink-mute);
  }

  .footer-links a:hover {
    color: var(--ink);
  }

  /* Responsive */
  @media (max-width: 900px) {
    .hero-inner {
      grid-template-columns: 1fr;
      gap: 40px;
    }

    .hero-card-wrap {
      max-width: 420px;
    }

    .why-grid {
      grid-template-columns: 1fr;
      gap: 24px;
    }
  }

  @media (max-width: 600px) {
    .nav-links {
      display: none;
    }

    .mobile-menu-btn {
      display: block;
    }

    .hero {
      padding: 40px 0 60px;
    }

    .hero-ctas {
      flex-direction: column;
    }

    .hero-ctas .btn {
      width: 100%;
    }

    .register-card {
      padding: 24px;
    }

    .install-well {
      padding: 24px;
    }

    .install-step {
      flex-direction: column;
      align-items: flex-start;
      gap: 8px;
    }

    .step-num {
      width: 24px;
      height: 24px;
      font-size: 0.75rem;
    }

    .footer-inner {
      flex-direction: column;
      text-align: center;
    }
  }

  @media (max-width: 390px) {
    .hero-ctas .btn-primary {
      width: 100%;
    }
  }
</style>

<script>
  const menuBtn = document.querySelector('.mobile-menu-btn');
  const mobileNav = document.getElementById('mobile-nav');

  if (menuBtn && mobileNav) {
    menuBtn.addEventListener('click', () => {
      const isOpen = mobileNav.classList.toggle('open');
      menuBtn.setAttribute('aria-expanded', String(isOpen));
    });

    mobileNav.querySelectorAll('a').forEach(link => {
      link.addEventListener('click', () => {
        mobileNav.classList.remove('open');
        menuBtn?.setAttribute('aria-expanded', 'false');
      });
    });
  }
</script>
