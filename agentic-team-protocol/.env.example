# Example project-level ATP environment configuration.
# Copy this file to .env in your project root and adjust the values.
# Generated values (org_id, workspace_id) are normally written by
# `eden-memory setup claude`; this template adds the metrics experiment flags.

EDEN_DB_PATH=${HOME}/.eden-memory/default.db
EDEN_AGENT_ID=claude-code-cli
EDEN_USER_ID=<your-user-id>
EDEN_ORG_ID=<your-org-id>
EDEN_WORKSPACE_ID=<your-workspace-id>
EDEN_MEMORY_BIN=${HOME}/.local/bin/eden-memory
EDEN_LOG_LEVEL=INFO

# Stable device identifier used in ATP metrics (privacy-safe, no PII).
# Derive deterministically from the hostname, or set an explicit value.
EDEN_DEVICE_ID=${EDEN_DEVICE_ID:-$(sh ./agentic-team-protocol/lib/device_id.sh)}

# ATP mode and default fallback.
ATP_MODE=lite
ATP_DEFAULT_BACKEND=ollama
ATP_DEFAULT_MODEL=ollama:kimi-k2.7-code:cloud

# Per-role model configuration. Uncomment or change to match your backend.
# ATP_DISPATCHER_MODEL=ollama:kimi-k2.7-code:cloud
# ATP_DISPATCHER_BACKEND=ollama
# ATP_DISPATCHER_EFFORT=medium

# ATP_ROUTER_MODEL=ollama:kimi-k2.7-code:cloud
# ATP_ROUTER_BACKEND=ollama
# ATP_ROUTER_EFFORT=medium

# ATP_RESEARCHER_MODEL=ollama:deepseek-v4-pro:cloud
# ATP_RESEARCHER_BACKEND=ollama
# ATP_RESEARCHER_EFFORT=high

# ATP_BUILDER_MODEL=ollama:kimi-k2.7-code:cloud
# ATP_BUILDER_BACKEND=ollama
# ATP_BUILDER_EFFORT=medium

# ATP_RUNTIME_MODEL=ollama:deepseek-v4-pro:cloud
# ATP_RUNTIME_BACKEND=ollama
# ATP_RUNTIME_EFFORT=medium

# ATP_VERIFIER_MODEL=ollama:minimax-m3:cloud
# ATP_VERIFIER_BACKEND=ollama
# ATP_VERIFIER_EFFORT=high

# ATP_ARCHIVIST_MODEL=ollama:deepseek-v4-flash:cloud
# ATP_ARCHIVIST_BACKEND=ollama
# ATP_ARCHIVIST_EFFORT=medium

# --- ATP token-efficiency metrics experiment (experimental) ---
# Set to 1 to make every ATP role append a `metrics` object to run_log metadata.
# See agentic-team-protocol/runbooks/atp-metrics-collection.md for the schema.
ATP_METRICS_ENABLED=0

# Optional: path to the local SQLite aggregate database used by atp-metrics.
ATP_METRICS_DB_PATH=${HOME}/.eden-memory/atp-metrics.db

# Optional: override the built-in per-model price table (USD per 1M tokens).
# Accepts a JSON file path or inline JSON. See the runbook for the default table.
# ATP_METRICS_PRICE_TABLE='{"claude-sonnet":{"input":3,"output":15}}'

# Ollama Cloud wiring example.
# ANTHROPIC_BASE_URL=https://ollama.com
# ANTHROPIC_AUTH_TOKEN=${OLLAMA_API_KEY:-}
# ANTHROPIC_API_KEY=
