---
// Docs landing page for 0d3sa.com/docs.
// Visual world: Production Call Sheet.
// ATP is the primary path; components are grouped below for deep configuration.

const roles = [
  { name: 'Dispatcher', duty: 'Assigns goals and routes work' },
  { name: 'Researcher', duty: 'Investigates options and reports' },
  { name: 'Builder', duty: 'Implements the chosen approach' },
  { name: 'Verifier', duty: 'Reviews for correctness and charter compliance' },
  { name: 'Archivist', duty: 'Records lifecycle and manages memory hygiene' },
  { name: 'Runtime', duty: 'Executes operational actions (charter-gated)' },
];

const atpQuadrants = [
  { label: 'Quick start', hint: 'Install and ratify', href: '/agentic-team-protocol/getting-started/' },
  { label: 'Tutorial', hint: 'Run your first team goal', href: '/agentic-team-protocol/tutorials/first-team-goal/' },
  { label: 'Concepts', hint: 'Lifecycle and roles', href: '/agentic-team-protocol/lifecycle/' },
  { label: 'Reference', hint: 'Agent prompts and commands', href: '/agentic-team-protocol/reference/slash-commands/' },
];

const components = [
  {
    tag: 'Memory & sync',
    name: 'eden-memory',
    desc: 'Local-first SQLite memory with vector embeddings, MCP server, and encrypted multi-device sync.',
    links: [
      { label: 'Quick start', href: '/eden-memory/getting-started/' },
      { label: 'Tools', href: '/eden-memory/reference/tools/' },
      { label: 'Sync', href: '/eden-memory/multi-device-sync/' },
    ],
    href: '/eden-memory/',
  },
  {
    tag: 'Relay server',
    name: 'eden-relay',
    desc: 'Self-hosted relay for multi-device sync. TLS, systemd, and VPS hardening guides.',
    links: [
      { label: 'Run a relay', href: '/eden-relay/how-to/run-relay-server/' },
      { label: 'Deploy on VPS', href: '/eden-relay/how-to/deploy-public-vps/' },
    ],
    href: '/eden-relay/',
  },
  {
    tag: 'Headless supervisor',
    name: 'eden-team',
    desc: 'Headless ATP supervisor for CI, cron, or automated agent-team workflows.',
    links: [
      { label: 'Set up headless', href: '/eden-team/tutorials/headless-supervisor/' },
    ],
    href: '/eden-team/',
  },
];
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Docs — 0d3sa</title>
  <meta name="description" content="Agentic Team Protocol documentation, plus component guides for eden-memory, eden-relay, and eden-team." />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Chakra+Petch:wght@400;500;600;700&family=Saira:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;700&display=swap" rel="stylesheet" />
</head>
<body>
  <!--
    THESIS: The docs landing page foregrounds the ATP doc path: a quick scan of the install reminder, the role roster, and the component reference.
    OWN-WORLD: Dark board ground, panel fills, hairline borders, paper text, alert coral for primary actions, action blue for links, status chips. Chakra Petch display, Saira body, JetBrains Mono for commands.
    STORY: A developer looking for docs finds the ATP path immediately, sees the four doc quadrants, and can drop down to component reference without losing context.
    FIRST VIEWPORT: Left-aligned production title and lead; below, a two-column install-reminder panel with ATP doc quadrants on one side and the commands on the other.
    FORM: Production Call Sheet (#7 of 7 grounded directions; seed key 05d59870).
    FINISH: unreviewed and undocumented is unfinished; this build ends with the finish review, the verdict, and DESIGN.md.
  -->

  <header class="site-header">
    <div class="wrap nav">
      <a href="/" class="brand" aria-label="0d3sa home">
        <span class="brand-mark" aria-hidden="true">0</span>
        <span class="brand-name">0d3sa</span>
      </a>
      <nav class="nav-links" aria-label="Primary">
        <a href="/">Home</a>
        <a href="https://github.com/yakovkhalinsky/eden-releases" target="_blank" rel="noreferrer">GitHub</a>
        <a href="/eden-memory/reference/downloads/" class="btn btn-sm">Downloads</a>
      </nav>
    </div>
  </header>

  <main>
    <section class="hero" aria-labelledby="hero-title">
      <div class="wrap hero-wrap">
        <div class="production-meta">
          <span class="status-chip ready"><span class="status-dot" aria-hidden="true"></span>Documentation</span>
          <span class="production-id">ATP-DOCS-001</span>
        </div>
        <h1 id="hero-title">AGENTIC TEAM PROTOCOL</h1>
        <p class="lead">
          Docs for the protocol, the roles, and the components that power it. Start with the ATP path; drop into eden-memory, eden-relay, or eden-team when you need a specific part.
        </p>
      </div>
    </section>

    <section class="call-sheet" aria-labelledby="docs-path-title">
      <div class="wrap">
        <div class="sheet-head">
          <div class="sheet-title-group">
            <h2 id="docs-path-title">Docs path</h2>
            <p class="sheet-subtitle">Start with the protocol path, then pick a component reference.</p>
          </div>
          <a href="/agentic-team-protocol/getting-started/" class="btn btn-primary">Install ATP</a>
        </div>

        <div class="sheet-body">
          <div class="sheet-block sheet-block-wide">
            <div class="block-label">Start here</div>
            <div class="quadrant-grid">
              {atpQuadrants.map(q => (
                <a href={q.href} class="quadrant-card">
                  <span class="quadrant-label">{q.label}</span>
                  <span class="quadrant-hint">{q.hint}</span>
                </a>
              ))}
            </div>
          </div>

          <div class="sheet-block">
            <div class="block-label">Install reminder</div>
            <p class="reminder-text">
              New to ATP? Install the binaries and wire the project first.
            </p>
            <div class="reminder-commands">
              <code class="cmd">curl -fsSL https://0d3sa.com/eden-memory/install.sh | sh</code>
              <code class="cmd">curl -fsSL https://0d3sa.com/agentic-team-protocol/install.sh | sh</code>
            </div>
            <a href="/agentic-team-protocol/getting-started/" class="reminder-link">Full quick start →</a>
          </div>
        </div>
      </div>
    </section>

    <section class="section roles-section" aria-labelledby="roles-title">
      <div class="wrap">
        <div class="section-head">
          <h2 id="roles-title">Role roster</h2>
          <p class="section-lead">Six roles, each with a scope and a decision right. Read the <a href="/agentic-team-protocol/agents/">agents</a> and <a href="/agentic-team-protocol/lifecycle/">lifecycle</a> pages for the full protocol.</p>
        </div>
        <ul class="role-grid" role="list">
          {roles.map(role => (
            <li class="role-card">
              <div class="role-head">
                <span class="role-name">{role.name}</span>
              </div>
              <p class="role-duty">{role.duty}</p>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <section class="section components-section" aria-labelledby="components-title">
      <div class="wrap">
        <div class="section-head">
          <h2 id="components-title">Component reference</h2>
          <p class="section-lead">Three single-file binaries power the protocol. Pick a component for deep configuration.</p>
        </div>
        <div class="component-grid">
          {components.map(c => (
            <a href={c.href} class="component-card">
              <div class="component-meta">
                <span class="component-tag">{c.tag}</span>
              </div>
              <h3 class="component-name">{c.name}</h3>
              <p class="component-desc">{c.desc}</p>
              <div class="component-links">
                {c.links.map(link => <span class="component-link">{link.label}</span>)}
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>
  </main>

  <footer class="site-footer">
    <div class="wrap footer-row">
      <span class="footer-copy">© 2026 0d3sa. Open source under Apache-2.0.</span>
      <nav class="footer-links" aria-label="Footer">
        <a href="https://github.com/yakovkhalinsky/eden-releases">GitHub</a>
        <span class="sep" aria-hidden="true">·</span>
        <a href="/docs/">Docs</a>
        <span class="sep" aria-hidden="true">·</span>
        <a href="/eden-memory/reference/downloads/">Downloads</a>
        <span class="sep" aria-hidden="true">·</span>
        <a href="https://github.com/yakovkhalinsky/eden-releases/releases">Releases</a>
      </nav>
    </div>
  </footer>
</body>
</html>

<style>
  :root {
    --board: #0d1117;
    --panel: #161b22;
    --panel-raised: #21262d;
    --border: #30363d;
    --border-subtle: #21262d;
    --text: #c9d1d9;
    --text-muted: #8b949e;
    --text-dim: #6e7681;
    --alert: #f78166;
    --alert-soft: rgba(247, 129, 102, 0.12);
    --action: #58a6ff;
    --action-soft: rgba(88, 166, 255, 0.12);
    --ready: #3fb950;
    --radius-sm: 8px;
    --radius: 12px;
    --max: 1100px;
    --display: Chakra Petch, Saira, -apple-system, BlinkMacSystemFont, sans-serif;
    --body: Saira, -apple-system, BlinkMacSystemFont, sans-serif;
    --mono: JetBrains Mono, ui-monospace, monospace;
  }

  *, *::before, *::after { box-sizing: border-box; }

  html, body {
    margin: 0;
    padding: 0;
    font-family: var(--body);
    color: var(--text);
    background: var(--board);
    line-height: 1.6;
    -webkit-font-smoothing: antialiased;
  }

  a {
    color: var(--action);
    text-decoration: none;
  }
  a:hover { text-decoration: underline; }

  code {
    font-family: var(--mono);
    font-size: 0.92em;
    background: var(--panel-raised);
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    padding: 2px 6px;
  }

  .wrap {
    max-width: var(--max);
    margin: 0 auto;
    padding: 0 24px;
  }

  /* Header */
  .site-header {
    border-bottom: 1px solid var(--border);
    background: var(--board);
    position: sticky;
    top: 0;
    z-index: 50;
  }

  .nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 60px;
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 10px;
    color: var(--text);
    font-weight: 700;
    font-size: 1.05rem;
  }
  .brand:hover { text-decoration: none; }

  .brand-mark {
    width: 28px;
    height: 28px;
    border-radius: var(--radius-sm);
    background: var(--alert);
    color: var(--board);
    display: grid;
    place-items: center;
    font-family: var(--mono);
    font-size: 0.85rem;
    font-weight: 700;
  }

  .nav-links {
    display: flex;
    gap: 22px;
    align-items: center;
    font-size: 0.88rem;
  }

  .nav-links a {
    color: var(--text-muted);
    font-weight: 500;
  }
  .nav-links a:hover { color: var(--text); text-decoration: none; }

  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    padding: 12px 20px;
    border-radius: var(--radius-sm);
    font-weight: 600;
    font-size: 0.92rem;
    border: 1px solid transparent;
    cursor: pointer;
    transition: background-color .12s ease, border-color .12s ease, color .12s ease;
    text-decoration: none;
    line-height: 1;
  }
  .btn:hover { text-decoration: none; }

  .btn-primary {
    background: var(--alert);
    color: var(--board);
  }
  .btn-primary:hover { background: #ff9a80; }

  .btn-sm {
    padding: 8px 14px;
    font-size: 0.82rem;
    background: var(--panel-raised);
    border-color: var(--border);
    color: var(--text);
  }
  .btn-sm:hover { border-color: var(--alert); color: var(--alert); background: var(--panel-raised); }

  /* Status chips */
  .status-chip {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 4px 10px;
    border-radius: 999px;
    font-size: 0.72rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.03em;
    border: 1px solid transparent;
    white-space: nowrap;
  }

  .status-chip.ready {
    background: rgba(63, 185, 80, 0.12);
    color: var(--ready);
    border-color: rgba(63, 185, 80, 0.25);
  }

  .status-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: currentColor;
  }

  /* Hero */
  .hero {
    padding: 56px 0 40px;
    border-bottom: 1px solid var(--border-subtle);
  }

  .hero-wrap {
    max-width: 860px;
  }

  .production-meta {
    display: flex;
    gap: 14px;
    align-items: center;
    margin-bottom: 18px;
    flex-wrap: wrap;
  }

  .production-id {
    font-family: var(--mono);
    font-size: 0.78rem;
    color: var(--text-dim);
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  h1 {
    font-family: var(--display);
    font-size: clamp(2.4rem, 6vw, 4.2rem);
    line-height: 0.98;
    font-weight: 700;
    letter-spacing: -0.03em;
    margin: 0 0 16px;
    color: var(--text);
  }

  .lead {
    font-size: clamp(1rem, 1.6vw, 1.2rem);
    color: var(--text-muted);
    max-width: 680px;
    margin: 0;
    line-height: 1.55;
  }

  /* Call sheet */
  .call-sheet {
    padding: 40px 0 64px;
  }

  .sheet-head {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 18px;
    margin-bottom: 22px;
    flex-wrap: wrap;
  }

  .sheet-title-group h2 {
    font-family: var(--display);
    font-size: 1.5rem;
    font-weight: 700;
    margin: 0 0 4px;
    letter-spacing: -0.02em;
  }

  .sheet-subtitle {
    color: var(--text-muted);
    margin: 0;
    font-size: 0.95rem;
  }

  .sheet-body {
    display: grid;
    grid-template-columns: 2fr 1fr;
    gap: 18px;
  }

  .sheet-block {
    background: var(--panel);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 20px;
  }

  .block-label {
    font-family: var(--mono);
    font-size: 0.72rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--text-dim);
    margin-bottom: 16px;
    padding-bottom: 10px;
    border-bottom: 1px solid var(--border-subtle);
  }

  .quadrant-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 12px;
  }

  .quadrant-card {
    display: flex;
    flex-direction: column;
    gap: 4px;
    background: var(--board);
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    padding: 16px;
    color: var(--text);
    transition: border-color .12s ease;
  }
  .quadrant-card:hover {
    border-color: var(--action);
    text-decoration: none;
  }

  .quadrant-label {
    font-weight: 700;
    font-size: 1rem;
  }

  .quadrant-hint {
    color: var(--text-muted);
    font-size: 0.82rem;
  }

  .reminder-text {
    color: var(--text-muted);
    font-size: 0.9rem;
    margin: 0 0 14px;
    line-height: 1.5;
  }

  .reminder-commands {
    display: flex;
    flex-direction: column;
    gap: 10px;
    margin-bottom: 14px;
  }

  .cmd {
    display: block;
    background: var(--board);
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    padding: 10px 12px;
    font-size: 0.78rem;
    color: var(--text);
    overflow-x: auto;
    white-space: nowrap;
  }

  .reminder-link {
    font-weight: 600;
    font-size: 0.9rem;
    color: var(--alert);
  }

  /* Sections */
  .section {
    padding: 64px 0;
    border-top: 1px solid var(--border-subtle);
  }

  .section-head {
    margin-bottom: 32px;
  }

  .section-head h2 {
    font-family: var(--display);
    font-size: 1.5rem;
    font-weight: 700;
    margin: 0 0 8px;
    letter-spacing: -0.02em;
  }

  .section-lead {
    color: var(--text-muted);
    margin: 0;
    max-width: 640px;
    font-size: 0.98rem;
  }

  /* Roles */
  .role-grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
  }

  .role-card {
    background: var(--panel);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 18px;
  }

  .role-head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 10px;
    margin-bottom: 8px;
  }

  .role-name {
    font-family: var(--display);
    font-size: 1.15rem;
    font-weight: 700;
  }

  .role-duty {
    color: var(--text-muted);
    font-size: 0.88rem;
    margin: 0;
    line-height: 1.45;
  }

  /* Components */
  .components-section {
    background: var(--panel);
    border-top: 1px solid var(--border);
  }

  .component-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
  }

  .component-card {
    display: flex;
    flex-direction: column;
    background: var(--board);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 20px;
    color: var(--text);
    transition: border-color .12s ease;
  }
  .component-card:hover {
    border-color: var(--action);
    text-decoration: none;
  }

  .component-tag {
    display: inline-block;
    padding: 4px 10px;
    border-radius: 999px;
    background: var(--action-soft);
    color: var(--action);
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .component-name {
    font-family: var(--display);
    font-size: 1.25rem;
    font-weight: 700;
    margin: 12px 0 8px;
  }

  .component-desc {
    color: var(--text-muted);
    font-size: 0.9rem;
    margin: 0 0 16px;
    line-height: 1.5;
    flex: 1;
  }

  .component-links {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .component-link {
    font-size: 0.78rem;
    padding: 5px 10px;
    border-radius: var(--radius-sm);
    background: var(--panel-raised);
    border: 1px solid var(--border);
    color: var(--text-muted);
    font-weight: 500;
  }

  /* Footer */
  .site-footer {
    border-top: 1px solid var(--border);
    padding: 32px 0;
    color: var(--text-muted);
    font-size: 0.84rem;
    background: var(--board);
  }

  .footer-row {
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 14px;
  }

  .footer-links a { color: var(--text-muted); }
  .footer-links a:hover { color: var(--text); }
  .footer-links .sep { margin: 0 6px; color: var(--text-dim); }

  /* Responsive */
  @media (max-width: 900px) {
    .sheet-body { grid-template-columns: 1fr; }
    .role-grid { grid-template-columns: repeat(2, 1fr); }
    .component-grid { grid-template-columns: repeat(2, 1fr); }
  }

  @media (max-width: 640px) {
    .hero { padding: 40px 0 32px; }
    .call-sheet { padding: 32px 0 48px; }
    .section { padding: 48px 0; }
    .quadrant-grid { grid-template-columns: 1fr; }
    .role-grid { grid-template-columns: 1fr; }
    .component-grid { grid-template-columns: 1fr; }
    .sheet-head { align-items: flex-start; flex-direction: column; }
    .sheet-head .btn { width: 100%; justify-content: center; }
  }
</style>
