---
// Docs landing page for 0d3sa.com/docs.
// Navigation-focused: doc quadrants, role roster, compact component reference.

const roles = [
  { name: 'Dispatcher', duty: 'Assigns goals and routes work' },
  { name: 'Researcher', duty: 'Investigates options and reports' },
  { name: 'Builder', duty: 'Implements the chosen approach' },
  { name: 'Verifier', duty: 'Reviews for correctness and charter compliance' },
  { name: 'Archivist', duty: 'Records lifecycle and manages memory hygiene' },
  { name: 'Runtime', duty: 'Executes operational actions (charter-gated)' },
];

const atpQuadrants = [
  { label: 'Quick start', hint: 'Install and ratify', href: '/agentic-team-protocol/getting-started/' },
  { label: 'Tutorial', hint: 'Run your first team goal', href: '/agentic-team-protocol/tutorials/first-team-goal/' },
  { label: 'Concepts', hint: 'Lifecycle and roles', href: '/agentic-team-protocol/lifecycle/' },
  { label: 'Reference', hint: 'Agent prompts and commands', href: '/agentic-team-protocol/reference/slash-commands/' },
];

const memoryQuadrants = [
  { label: 'Quick start', hint: 'Install and verify', href: '/eden-memory/getting-started/' },
  { label: 'Tutorials', hint: 'Connect clients and sync devices', href: '/eden-memory/tutorials/connect-claude-code/' },
  { label: 'Concepts', hint: 'Memory model, sync, security', href: '/eden-memory/concepts/memory-model/' },
  { label: 'Reference', hint: 'Tools, CLI, environment', href: '/eden-memory/reference/tools/' },
];

const components = [
  {
    tag: 'Memory & sync',
    name: 'eden-memory',
    desc: 'Local-first SQLite memory with vector embeddings, MCP server, and encrypted multi-device sync.',
    links: [
      { label: 'Quick start', href: '/eden-memory/getting-started/' },
      { label: 'Tools', href: '/eden-memory/reference/tools/' },
      { label: 'Sync', href: '/eden-memory/multi-device-sync/' },
    ],
    href: '/eden-memory/',
  },
  {
    tag: 'Relay server',
    name: 'eden-relay',
    desc: 'Self-hosted relay for multi-device sync. TLS, systemd, and VPS hardening guides.',
    links: [
      { label: 'Run a relay', href: '/eden-relay/how-to/run-relay-server/' },
      { label: 'Deploy on VPS', href: '/eden-relay/how-to/deploy-public-vps/' },
    ],
    href: '/eden-relay/',
  },
  {
    tag: 'Headless supervisor',
    name: 'eden-team',
    desc: 'Headless ATP supervisor for CI, cron, or automated agent-team workflows.',
    links: [
      { label: 'Set up headless', href: '/eden-team/tutorials/headless-supervisor/' },
    ],
    href: '/eden-team/',
  },
];
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Docs — 0d3sa</title>
  <meta name="description" content="Agentic Team Protocol documentation, plus component guides for eden-memory, eden-relay, and eden-team." />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Chakra+Petch:wght@400;500;700&family=Saira:wght@400;500;700&family=JetBrains+Mono:wght@400;500;700&display=swap" rel="stylesheet" />
</head>
<body>
  <header class="site-header">
    <div class="wrap nav">
      <a href="/" class="brand" aria-label="0d3sa home">
        <img src="/images/brand-mark.svg" alt="" class="brand-mark" width="32" height="32" aria-hidden="true" />
        <span class="brand-name">0d3sa</span>
      </a>
      <nav class="nav-links" aria-label="Primary">
        <a href="/">Home</a>
        <a href="https://github.com/yakovkhalinsky/eden-releases" target="_blank" rel="noreferrer">GitHub</a>
        <a href="/eden-memory/reference/downloads/" class="btn btn-sm">Downloads</a>
      </nav>
    </div>
  </header>

  <main>
    <section class="hero" aria-labelledby="hero-title">
      <div class="wrap hero-wrap">
        <div class="hero-text">
          <div class="product-meta">
            <span class="status-chip ready"><span class="status-dot" aria-hidden="true"></span>Documentation</span>
            <span class="call-sheet-id">Call sheet ATP-DOCS-001</span>
          </div>
          <h1 id="hero-title">0d3sa docs</h1>
          <p class="lead">
            Find the protocol, the roles, and the component guides. Start with the ATP path, or drop into eden-memory, eden-relay, or eden-team.
          </p>
          <div class="hero-actions">
            <a href="/agentic-team-protocol/getting-started/" class="btn btn-primary">Install ATP</a>
            <a href="/" class="btn btn-secondary">Back to home</a>
          </div>
        </div>
        <div class="hero-visual" aria-hidden="true">
          <svg viewBox="0 0 420 280" width="100%" height="auto" xmlns="http://www.w3.org/2000/svg">
            <rect x="20" y="180" width="380" height="80" rx="16" fill="#0e1a19" stroke="#424f4f" stroke-width="1.5" />

            <g transform="translate(60, 90)">
              <path d="M0 40 L60 15 L120 40 L60 65 Z" fill="#0e1a19" stroke="#3ddc91" stroke-width="1.5" />
              <path d="M0 40 L0 85 L60 110 L60 65 Z" fill="#132322" stroke="#3ddc91" stroke-width="1.5" />
              <path d="M60 65 L60 110 L120 85 L120 40 Z" fill="#0a1615" stroke="#3ddc91" stroke-width="1.5" />
              <text x="60" y="50" text-anchor="middle" font-family="JetBrains Mono, ui-monospace, monospace" font-size="10" font-weight="700" fill="#3ddc91">DOCS</text>
            </g>

            <g transform="translate(190, 50)">
              <path d="M0 40 L60 15 L120 40 L60 65 Z" fill="#0e1a19" stroke="#ffcd48" stroke-width="1.5" />
              <path d="M0 40 L0 85 L60 110 L60 65 Z" fill="#132322" stroke="#ffcd48" stroke-width="1.5" />
              <path d="M60 65 L60 110 L120 85 L120 40 Z" fill="#0a1615" stroke="#ffcd48" stroke-width="1.5" />
              <text x="60" y="50" text-anchor="middle" font-family="JetBrains Mono, ui-monospace, monospace" font-size="10" font-weight="700" fill="#ffcd48">ROLES</text>
            </g>

            <g transform="translate(270, 130)">
              <path d="M0 40 L60 15 L120 40 L60 65 Z" fill="#0e1a19" stroke="#97ddbc" stroke-width="1.5" />
              <path d="M0 40 L0 85 L60 110 L60 65 Z" fill="#132322" stroke="#97ddbc" stroke-width="1.5" />
              <path d="M60 65 L60 110 L120 85 L120 40 Z" fill="#0a1615" stroke="#97ddbc" stroke-width="1.5" />
              <text x="60" y="50" text-anchor="middle" font-family="JetBrains Mono, ui-monospace, monospace" font-size="10" font-weight="700" fill="#97ddbc">TOOLS</text>
            </g>
          </svg>
        </div>
      </div>
    </section>

    <section class="docs-path" aria-labelledby="docs-path-title">
      <div class="wrap">
        <div class="path-card">
          <div class="path-head">
            <div class="path-title-group">
              <span class="eyebrow">Start with the protocol</span>
              <h2 id="docs-path-title">ATP doc quadrants</h2>
              <p class="path-subtitle">The Agentic Team Protocol docs are organized by how you use them.</p>
            </div>
            <a href="/agentic-team-protocol/getting-started/" class="btn btn-primary">Quick start</a>
          </div>

          <div class="quadrant-grid">
            {atpQuadrants.map(q => (
              <a href={q.href} class="quadrant-card">
                <span class="quadrant-label">{q.label}</span>
                <span class="quadrant-hint">{q.hint}</span>
              </a>
            ))}
          </div>
        </div>
      </div>
    </section>

    <section class="section memory-section" aria-labelledby="memory-title">
      <div class="wrap">
        <div class="path-card">
          <div class="path-head">
            <div class="path-title-group">
              <span class="eyebrow">Component deep dive</span>
              <h2 id="memory-title">eden-memory quadrants</h2>
              <p class="path-subtitle">Docs for the memory and sync component.</p>
            </div>
            <a href="/eden-memory/getting-started/" class="btn btn-primary">Quick start</a>
          </div>

          <div class="quadrant-grid">
            {memoryQuadrants.map(q => (
              <a href={q.href} class="quadrant-card">
                <span class="quadrant-label">{q.label}</span>
                <span class="quadrant-hint">{q.hint}</span>
              </a>
            ))}
          </div>
        </div>
      </div>
    </section>

    <section class="section roles-section" aria-labelledby="roles-title">
      <div class="wrap">
        <div class="section-head">
          <span class="eyebrow">Role roster</span>
          <h2 id="roles-title">Six roles, one lifecycle</h2>
        </div>
        <ul class="role-grid" role="list">
          {roles.map(role => (
            <li class="role-card">
              <span class="role-name">{role.name}</span>
              <p class="role-duty">{role.duty}</p>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <section class="section components-section" aria-labelledby="components-title">
      <div class="wrap">
        <div class="section-head">
          <span class="eyebrow">Component reference</span>
          <h2 id="components-title">Three single-file binaries</h2>
        </div>
        <div class="component-grid">
          {components.map(c => (
            <a href={c.href} class="component-card">
              <span class="component-tag">{c.tag}</span>
              <h3 class="component-name">{c.name}</h3>
              <p class="component-desc">{c.desc}</p>
              <div class="component-links">
                {c.links.map(link => <span class="component-link">{link.label}</span>)}
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>
  </main>

  <footer class="site-footer">
    <div class="wrap footer-row">
      <span class="footer-copy">© 2026 0d3sa. Open source under Apache-2.0.</span>
      <nav class="footer-links" aria-label="Footer">
        <a href="https://github.com/yakovkhalinsky/eden-releases">GitHub</a>
        <span class="sep" aria-hidden="true">·</span>
        <a href="/docs/">Docs</a>
        <span class="sep" aria-hidden="true">·</span>
        <a href="/eden-memory/reference/downloads/">Downloads</a>
        <span class="sep" aria-hidden="true">·</span>
        <a href="https://github.com/yakovkhalinsky/eden-releases/releases">Release notes</a>
      </nav>
    </div>
  </footer>
</body>
</html>

<style>
  :root {
    --obsidian: #132322;
    --abyss: #0e1a19;
    --charcoal: #070f0f;
    --neon: #3ddc91;
    --mint: #97ddbc;
    --yellow: #ffcd48;
    --white: #ffffff;
    --slate: #828786;
    --graphite: #424f4f;
    --fog: #d0d3d3;
    --mint-frost: #edf7f5;
    --neon-soft: rgba(61, 220, 145, 0.12);
    --neon-border: rgba(61, 220, 145, 0.3);
    --radius-sm: 10px;
    --radius-md: 20px;
    --radius-lg: 60px;
    --radius-pill: 56px;
    --max: 1200px;
    --display: "Chakra Petch", "Saira", -apple-system, BlinkMacSystemFont, sans-serif;
    --body: "Saira", -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    --mono: "JetBrains Mono", ui-monospace, monospace;
  }

  *, *::before, *::after { box-sizing: border-box; }

  html, body {
    margin: 0;
    padding: 0;
    font-family: var(--body);
    color: var(--white);
    background: var(--obsidian);
    line-height: 1.6;
    -webkit-font-smoothing: antialiased;
  }

  a {
    color: var(--neon);
    text-decoration: none;
  }
  a:hover { text-decoration: underline; }

  code {
    font-family: var(--mono);
    font-size: 0.9em;
    background: var(--abyss);
    border: 1px solid var(--graphite);
    border-radius: var(--radius-sm);
    padding: 2px 6px;
    color: var(--white);
  }

  .wrap {
    max-width: var(--max);
    margin: 0 auto;
    padding: 0 24px;
  }

  /* Header */
  .site-header {
    border-bottom: 1px solid var(--graphite);
    background: var(--obsidian);
    position: sticky;
    top: 0;
    z-index: 50;
  }

  .nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 64px;
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 10px;
    color: var(--white);
    font-weight: 500;
    font-size: 1.1rem;
    font-family: var(--display);
  }
  .brand:hover { text-decoration: none; }

  .brand-mark {
    width: 32px;
    height: 32px;
    border-radius: var(--radius-sm);
    display: block;
  }

  .nav-links {
    display: flex;
    gap: 28px;
    align-items: center;
    font-size: 0.92rem;
  }

  .nav-links a {
    color: var(--slate);
    font-weight: 400;
  }
  .nav-links a:hover { color: var(--white); text-decoration: none; }

  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    padding: 14px 28px;
    border-radius: var(--radius-pill);
    font-weight: 500;
    font-size: 0.92rem;
    border: 1.5px solid transparent;
    cursor: pointer;
    transition: background-color .15s ease, border-color .15s ease, color .15s ease;
    text-decoration: none;
    line-height: 1;
    font-family: var(--body);
  }
  .btn:hover { text-decoration: none; }

  .btn-primary {
    background: var(--neon);
    color: var(--obsidian);
  }
  .btn-primary:hover { background: var(--mint); }

  .btn-secondary {
    background: transparent;
    border-color: var(--white);
    color: var(--white);
  }
  .btn-secondary:hover { background: rgba(255, 255, 255, 0.08); }

  .btn-sm {
    padding: 8px 16px;
    font-size: 0.82rem;
    background: var(--abyss);
    border-color: var(--graphite);
    color: var(--slate);
  }
  .btn-sm:hover { border-color: var(--neon); color: var(--neon); background: var(--abyss); }

  /* Status chips */
  .status-chip {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 4px 10px;
    border-radius: 999px;
    font-size: 0.72rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    border: 1px solid transparent;
    white-space: nowrap;
    font-family: var(--mono);
  }

  .status-chip.ready {
    background: var(--neon-soft);
    color: var(--neon);
    border-color: var(--neon-border);
  }

  .status-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: currentColor;
  }

  /* Hero */
  .hero {
    padding: 64px 0 48px;
    border-bottom: 1px solid var(--graphite);
    background: var(--obsidian);
  }

  .hero-wrap {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 48px;
    align-items: center;
  }

  .product-meta {
    display: flex;
    gap: 14px;
    align-items: center;
    margin-bottom: 18px;
    flex-wrap: wrap;
  }

  .call-sheet-id {
    font-family: var(--mono);
    font-size: 0.72rem;
    color: var(--slate);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  h1 {
    font-family: var(--display);
    font-size: clamp(2.2rem, 5vw, 3.4rem);
    line-height: 1.05;
    font-weight: 500;
    letter-spacing: -0.03em;
    margin: 0 0 14px;
    color: var(--white);
  }

  .lead {
    font-size: clamp(1.05rem, 1.6vw, 1.2rem);
    color: var(--slate);
    margin: 0 0 24px;
    line-height: 1.55;
    max-width: 520px;
  }

  .hero-actions {
    display: flex;
    gap: 14px;
    flex-wrap: wrap;
  }

  .hero-visual svg {
    width: 100%;
    height: auto;
    max-width: 420px;
  }

  /* Path cards */
  .docs-path {
    padding: 64px 0 32px;
  }

  .path-card {
    background: var(--abyss);
    border: 1px solid var(--graphite);
    border-radius: var(--radius-lg);
    padding: 40px;
  }

  .path-head {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 18px;
    margin-bottom: 28px;
    flex-wrap: wrap;
  }

  .path-title-group h2 {
    font-family: var(--display);
    font-size: clamp(1.6rem, 3.5vw, 2.4rem);
    font-weight: 500;
    margin: 0 0 8px;
    letter-spacing: -0.02em;
    color: var(--white);
  }

  .path-subtitle {
    color: var(--slate);
    margin: 0;
    font-size: 1rem;
    max-width: 480px;
  }

  .eyebrow {
    display: block;
    font-family: var(--mono);
    font-size: 0.72rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--neon);
    margin-bottom: 12px;
  }

  .quadrant-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 12px;
  }

  .quadrant-card {
    display: flex;
    flex-direction: column;
    gap: 4px;
    background: var(--charcoal);
    border: 1px solid var(--graphite);
    border-radius: var(--radius-md);
    padding: 20px;
    color: var(--white);
    transition: border-color .15s ease, background-color .15s ease;
  }
  .quadrant-card:hover {
    border-color: var(--neon);
    background: var(--neon-soft);
    text-decoration: none;
  }

  .quadrant-label {
    font-family: var(--display);
    font-weight: 500;
    font-size: 1.05rem;
  }

  .quadrant-hint {
    color: var(--slate);
    font-size: 0.82rem;
  }

  /* Sections */
  .section {
    padding: 48px 0 64px;
  }

  .section-head {
    margin-bottom: 40px;
    max-width: 640px;
  }

  .section-head h2 {
    font-family: var(--display);
    font-size: clamp(1.5rem, 3vw, 2.2rem);
    font-weight: 500;
    margin: 0;
    letter-spacing: -0.02em;
    color: var(--white);
  }

  /* Memory section */
  .memory-section {
    background: var(--obsidian);
  }

  /* Roles */
  .roles-section {
    background: var(--mint-frost);
  }
  .roles-section h2,
  .roles-section .eyebrow,
  .roles-section .role-name,
  .roles-section .role-duty { color: var(--charcoal); }
  .roles-section .role-card {
    background: var(--white);
    border-color: var(--fog);
  }

  .role-grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 18px;
  }

  .role-card {
    background: var(--charcoal);
    border: 1px solid var(--graphite);
    border-radius: var(--radius-md);
    padding: 20px;
  }

  .role-name {
    font-family: var(--display);
    font-size: 1.05rem;
    font-weight: 500;
    color: var(--white);
    margin-bottom: 6px;
    display: block;
  }

  .role-duty {
    color: var(--slate);
    font-size: 0.88rem;
    margin: 0;
    line-height: 1.45;
  }

  /* Components */
  .components-section {
    background: var(--obsidian);
  }

  .component-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 18px;
  }

  .component-card {
    display: flex;
    flex-direction: column;
    background: var(--charcoal);
    border: 1px solid var(--graphite);
    border-radius: var(--radius-lg);
    padding: 24px;
    transition: border-color .15s ease, transform .15s ease;
  }
  .component-card:hover {
    border-color: var(--neon);
    text-decoration: none;
    transform: translateY(-2px);
  }

  .component-tag {
    display: inline-block;
    padding: 4px 10px;
    border-radius: 999px;
    background: var(--neon-soft);
    color: var(--neon);
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    font-family: var(--mono);
    align-self: flex-start;
  }

  .component-name {
    font-family: var(--display);
    font-size: 1.25rem;
    font-weight: 500;
    margin: 14px 0 8px;
    color: var(--white);
  }

  .component-desc {
    color: var(--slate);
    font-size: 0.9rem;
    margin: 0 0 18px;
    line-height: 1.5;
    flex: 1;
  }

  .component-links {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .component-link {
    font-size: 0.78rem;
    padding: 5px 10px;
    border-radius: var(--radius-sm);
    background: var(--obsidian);
    border: 1px solid var(--graphite);
    color: var(--slate);
    font-weight: 500;
  }

  /* Footer */
  .site-footer {
    border-top: 1px solid var(--graphite);
    padding: 40px 0;
    color: var(--slate);
    font-size: 0.86rem;
    background: var(--obsidian);
  }

  .footer-row {
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 14px;
  }

  .footer-links a { color: var(--slate); }
  .footer-links a:hover { color: var(--white); }
  .footer-links .sep { margin: 0 6px; color: var(--graphite); }

  /* Responsive */
  @media (max-width: 900px) {
    .hero-wrap { grid-template-columns: 1fr; }
    .hero-visual { order: -1; max-width: 360px; }
    .quadrant-grid { grid-template-columns: repeat(2, 1fr); }
    .role-grid { grid-template-columns: repeat(2, 1fr); }
    .component-grid { grid-template-columns: repeat(2, 1fr); }
  }

  @media (max-width: 640px) {
    .hero { padding: 48px 0 36px; }
    .docs-path { padding: 36px 0 24px; }
    .section { padding: 36px 0 48px; }
    .path-card { padding: 24px; }
    .quadrant-grid { grid-template-columns: 1fr; }
    .role-grid { grid-template-columns: 1fr; }
    .component-grid { grid-template-columns: 1fr; }
    .path-head { flex-direction: column; }
    .path-head .btn { width: 100%; justify-content: center; }
  }
</style>
