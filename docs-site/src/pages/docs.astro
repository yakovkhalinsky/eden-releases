---
// Docs landing page for 0d3sa.com/docs.
// ATP is the hero/default path. Components (eden-memory, eden-relay, eden-team)
// are grouped below for deep configuration.
---

<!DOCTYPE html>
<html lang="en" class="dark">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Docs — 0d3sa</title>
  <meta name="description" content="Agentic Team Protocol documentation, plus component guides for eden-memory, eden-relay, and eden-team." />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;700&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
</head>
<body>
  <header class="site-header">
    <div class="wrap nav">
      <a href="/" class="brand">
        <span class="brand-mark">0</span>
        <span>0d3sa</span>
      </a>
      <nav class="nav-links">
        <a href="/">Home</a>
        <a href="https://github.com/yakovkhalinsky/eden-releases" target="_blank" rel="noreferrer">GitHub</a>
        <a href="/eden-memory/reference/downloads/" class="btn btn-primary">Download</a>
      </nav>
    </div>
  </header>

  <main>
    <section class="hero">
      <div class="wrap">
        <div class="pill">
          <span class="dot"></span>
          <span>Documentation</span>
        </div>
        <h1>Agentic Team Protocol</h1>
        <p class="lead">
          Installable, role-based agent teams for Claude Code. Durable memory, sync, and headless orchestration are provided by the components below.
        </p>
        <div class="hero-actions">
          <a href="/agentic-team-protocol/getting-started/" class="btn btn-primary btn-lg">Install ATP</a>
          <a href="/agentic-team-protocol/" class="btn btn-secondary btn-lg">Read the overview</a>
        </div>
      </div>
    </section>

    <section class="section atp-section">
      <div class="wrap">
        <h2 class="section-title">Start with the protocol</h2>
        <div class="product-grid">
          <div class="product-card product-card-primary">
            <div class="product-meta">
              <span class="product-tag">Installable product</span>
            </div>
            <h3>Agentic Team Protocol</h3>
            <p>Seven-stage lifecycle, role-based collaboration, and durable records inside Claude Code.</p>
            <div class="quadrant-links">
              <a href="/agentic-team-protocol/getting-started/" class="quadrant-link">
                <span class="quadrant-label">Quick start</span>
                <span class="quadrant-hint">Install and ratify</span>
              </a>
              <a href="/agentic-team-protocol/tutorials/first-team-goal/" class="quadrant-link">
                <span class="quadrant-label">Tutorial</span>
                <span class="quadrant-hint">Run your first team goal</span>
              </a>
              <a href="/agentic-team-protocol/lifecycle/" class="quadrant-link">
                <span class="quadrant-label">Concepts</span>
                <span class="quadrant-hint">Lifecycle and roles</span>
              </a>
              <a href="/agentic-team-protocol/reference/agent-prompts/" class="quadrant-link">
                <span class="quadrant-label">Reference</span>
                <span class="quadrant-hint">Agent prompts and commands</span>
              </a>
            </div>
            <a href="/agentic-team-protocol/" class="product-link">Read ATP docs →</a>
          </div>
        </div>
      </div>
    </section>

    <section class="section products-section">
      <div class="wrap">
        <h2 class="section-title">Components</h2>
        <p class="section-lead">Deep docs for the parts that power ATP.</p>
        <div class="component-grid">
          <a href="/eden-memory/" class="component-card">
            <div class="component-meta">
              <span class="component-tag">Memory & sync</span>
            </div>
            <h3>eden-memory</h3>
            <p>Local-first memory with SQLite, vector embeddings, MCP server, and encrypted multi-device sync.</p>
            <div class="component-links">
              <a href="/eden-memory/getting-started/">Quick start</a>
              <a href="/eden-memory/reference/tools/">Tools</a>
              <a href="/eden-memory/multi-device-sync/">Sync overview</a>
            </div>
            <span class="product-link">Read docs →</span>
          </a>

          <a href="/eden-relay/" class="component-card">
            <div class="component-meta">
              <span class="component-tag">Relay server</span>
            </div>
            <h3>eden-relay</h3>
            <p>Dedicated, self-hosted relay for multi-device sync. TLS, systemd, and VPS hardening guides.</p>
            <div class="component-links">
              <a href="/eden-relay/how-to/run-relay-server/">Run a relay</a>
              <a href="/eden-relay/how-to/deploy-public-vps/">Deploy on VPS</a>
            </div>
            <span class="product-link">Read docs →</span>
          </a>

          <a href="/eden-team/" class="component-card">
            <div class="component-meta">
              <span class="component-tag">Headless supervisor</span>
            </div>
            <h3>eden-team</h3>
            <p>Headless ATP supervisor for CI, cron, or automated workflows. JSON output and resumable goals.</p>
            <div class="component-links">
              <a href="/eden-team/tutorials/headless-supervisor/">Set up headless supervisor</a>
            </div>
            <span class="product-link">Read docs →</span>
          </a>
        </div>
      </div>
    </section>
  </main>

  <footer class="site-footer">
    <div class="wrap footer-row">
      <span>© 2026 0d3sa. Open source under Apache-2.0.</span>
      <span class="footer-links">
        <a href="https://github.com/yakovkhalinsky/eden-releases">GitHub</a>
        <span class="sep">·</span>
        <a href="/docs/">Docs</a>
        <span class="sep">·</span>
        <a href="/eden-memory/reference/downloads/">Downloads</a>
        <span class="sep">·</span>
        <a href="https://github.com/yakovkhalinsky/eden-releases/releases">Releases</a>
      </span>
    </div>
  </footer>
</body>
</html>

<style>
  :root {
    --bg: #0b0d10;
    --bg-elevated: #11141a;
    --bg-card: #151922;
    --bg-warm: #18141a;
    --text: #f0f2f6;
    --text-muted: #8b94a7;
    --border: #232834;
    --accent: #2d6a4f;
    --accent-600: #40916c;
    --accent-glow: rgba(45, 106, 79, 0.18);
    --amber: #f2b65a;
    --amber-soft: rgba(242, 182, 90, 0.12);
    --green: #5df0a8;
    --radius: 14px;
    --max: 960px;
  }

  html, body {
    margin: 0;
    padding: 0;
    font-family: Inter, -apple-system, BlinkMacSystemFont, sans-serif;
    color: var(--text);
    background: var(--bg);
    line-height: 1.6;
    -webkit-font-smoothing: antialiased;
  }

  a { color: var(--accent); text-decoration: none; }
  a:hover { text-decoration: underline; }

  .wrap {
    max-width: var(--max);
    margin: 0 auto;
    padding: 0 24px;
  }

  .site-header {
    border-bottom: 1px solid var(--border);
    background: var(--bg);
  }

  .nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 64px;
  }

  .brand {
    font-weight: 700;
    font-size: 1.1rem;
    display: flex;
    align-items: center;
    gap: 10px;
    color: var(--text);
  }

  .brand-mark {
    width: 28px;
    height: 28px;
    border-radius: 8px;
    background: var(--accent);
    color: var(--bg);
    display: grid;
    place-items: center;
    font-family: JetBrains Mono, monospace;
    font-size: 0.85rem;
    font-weight: 700;
  }

  .nav-links {
    display: flex;
    gap: 24px;
    align-items: center;
    font-size: 0.88rem;
  }

  .nav-links a { color: var(--text-muted); font-weight: 500; }
  .nav-links a:hover { color: var(--text); }

  .btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 10px 18px;
    border-radius: 10px;
    font-weight: 600;
    font-size: 0.88rem;
    border: 1px solid transparent;
    cursor: pointer;
    transition: all .12s ease;
    text-decoration: none;
  }

  .btn-primary { background: var(--accent); color: var(--text); }
  .btn-primary:hover { background: var(--accent-600); text-decoration: none; }

  .btn-secondary {
    background: transparent;
    border-color: var(--border);
    color: var(--text);
  }
  .btn-secondary:hover { border-color: var(--accent); color: var(--accent); text-decoration: none; }

  .btn-lg { padding: 14px 24px; font-size: 1rem; }

  .hero { padding: 64px 0 48px; text-align: center; }

  .pill {
    display: inline-flex;
    gap: 8px;
    align-items: center;
    padding: 6px 14px;
    border-radius: 999px;
    background: var(--bg-elevated);
    border: 1px solid var(--border);
    color: var(--text-muted);
    font-size: 0.76rem;
    font-weight: 700;
    margin-bottom: 20px;
  }

  .pill .dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--green);
  }

  h1 {
    font-family: Inter, sans-serif;
    font-size: clamp(2.8rem, 7vw, 4.6rem);
    line-height: 1.05;
    font-weight: 800;
    letter-spacing: -0.03em;
    margin-bottom: 8px;
  }

  .lead {
    font-size: clamp(1rem, 1.6vw, 1.15rem);
    color: var(--text-muted);
    max-width: 640px;
    margin: 0 auto 28px;
  }

  .hero-actions {
    display: flex;
    gap: 14px;
    justify-content: center;
    flex-wrap: wrap;
  }

  .section { padding: 64px 0; }
  .atp-section { background: var(--bg-elevated); border-top: 1px solid var(--border); }
  .products-section { background: var(--bg-warm); border-top: 1px solid var(--border); }

  .section-title {
    text-align: center;
    font-size: 1.3rem;
    margin-bottom: 10px;
  }

  .section-lead {
    text-align: center;
    color: var(--text-muted);
    max-width: 560px;
    margin: 0 auto 28px;
  }

  .product-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: 18px;
    max-width: 820px;
    margin: 0 auto;
  }

  .product-card {
    display: flex;
    flex-direction: column;
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 22px;
    color: var(--text);
  }

  .product-card-primary {
    border-color: var(--accent);
    box-shadow: 0 0 0 1px var(--accent) inset, 0 0 40px var(--accent-glow);
  }

  .product-meta { margin-bottom: 10px; }
  .product-tag {
    display: inline-block;
    padding: 4px 10px;
    border-radius: 999px;
    background: var(--amber-soft);
    color: var(--amber);
    font-size: 0.72rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .product-card h3 {
    font-size: 1.25rem;
    font-weight: 700;
    margin-bottom: 8px;
  }

  .product-card p {
    color: var(--text-muted);
    font-size: 0.92rem;
    margin-bottom: 18px;
  }

  .quadrant-links {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 10px;
    margin-bottom: 18px;
  }

  .quadrant-link {
    display: flex;
    flex-direction: column;
    gap: 2px;
    background: var(--bg-elevated);
    border: 1px solid var(--border);
    border-radius: 10px;
    padding: 12px;
    color: var(--text);
    text-decoration: none;
  }

  .quadrant-link:hover {
    border-color: var(--accent);
    text-decoration: none;
  }

  .quadrant-label {
    font-weight: 600;
    font-size: 0.9rem;
  }

  .quadrant-hint {
    color: var(--text-muted);
    font-size: 0.78rem;
  }

  .component-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 18px;
    max-width: 960px;
    margin: 0 auto;
  }

  .component-card {
    display: flex;
    flex-direction: column;
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 22px;
    color: var(--text);
  }
  .component-card:hover {
    border-color: var(--accent);
    text-decoration: none;
  }

  .component-meta { margin-bottom: 10px; }
  .component-tag {
    display: inline-block;
    padding: 4px 10px;
    border-radius: 999px;
    background: var(--bg-elevated);
    color: var(--text-muted);
    font-size: 0.72rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .component-card h3 {
    font-size: 1.2rem;
    font-weight: 700;
    margin-bottom: 8px;
  }

  .component-card p {
    color: var(--text-muted);
    font-size: 0.92rem;
    margin-bottom: 16px;
  }

  .component-links {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: 16px;
  }

  .component-links a {
    font-size: 0.82rem;
    padding: 5px 10px;
    border-radius: 6px;
    background: var(--bg-elevated);
    border: 1px solid var(--border);
    color: var(--text);
  }
  .component-links a:hover {
    border-color: var(--accent);
    text-decoration: none;
  }

  .product-link {
    color: var(--accent);
    font-size: 0.9rem;
    font-weight: 600;
    margin-top: auto;
  }

  .site-footer {
    border-top: 1px solid var(--border);
    padding: 32px 0;
    color: var(--text-muted);
    font-size: 0.84rem;
    background: var(--bg);
  }

  .footer-row {
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 14px;
  }

  .footer-links .sep { margin: 0 6px; color: var(--text-muted); }

  @media (max-width: 760px) {
    .quadrant-links { grid-template-columns: 1fr; }
    .product-grid { grid-template-columns: 1fr; }
    .component-grid { grid-template-columns: 1fr; }
    .hero { padding: 48px 0 36px; }
    .section { padding: 48px 0; }
    .hero-actions { flex-direction: column; align-items: stretch; }
    .hero-actions .btn { justify-content: center; }
  }
</style>
