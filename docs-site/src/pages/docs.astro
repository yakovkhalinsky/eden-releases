---
// Docs landing page for 0d3sa.com/docs.
// Visual world: Local-first product — light, green, clean product surface.
// ATP is the primary path; components are grouped below for deep configuration.

const roles = [
  { name: 'Dispatcher', duty: 'Assigns goals and routes work' },
  { name: 'Researcher', duty: 'Investigates options and reports' },
  { name: 'Builder', duty: 'Implements the chosen approach' },
  { name: 'Verifier', duty: 'Reviews for correctness and charter compliance' },
  { name: 'Archivist', duty: 'Records lifecycle and manages memory hygiene' },
  { name: 'Runtime', duty: 'Executes operational actions (charter-gated)' },
];

const atpQuadrants = [
  { label: 'Quick start', hint: 'Install and ratify', href: '/agentic-team-protocol/getting-started/' },
  { label: 'Tutorial', hint: 'Run your first team goal', href: '/agentic-team-protocol/tutorials/first-team-goal/' },
  { label: 'Concepts', hint: 'Lifecycle and roles', href: '/agentic-team-protocol/lifecycle/' },
  { label: 'Reference', hint: 'Agent prompts and commands', href: '/agentic-team-protocol/reference/slash-commands/' },
];

const components = [
  {
    tag: 'Memory & sync',
    name: 'eden-memory',
    desc: 'Local-first SQLite memory with vector embeddings, MCP server, and encrypted multi-device sync.',
    links: [
      { label: 'Quick start', href: '/eden-memory/getting-started/' },
      { label: 'Tools', href: '/eden-memory/reference/tools/' },
      { label: 'Sync', href: '/eden-memory/multi-device-sync/' },
    ],
    href: '/eden-memory/',
  },
  {
    tag: 'Relay server',
    name: 'eden-relay',
    desc: 'Self-hosted relay for multi-device sync. TLS, systemd, and VPS hardening guides.',
    links: [
      { label: 'Run a relay', href: '/eden-relay/how-to/run-relay-server/' },
      { label: 'Deploy on VPS', href: '/eden-relay/how-to/deploy-public-vps/' },
    ],
    href: '/eden-relay/',
  },
  {
    tag: 'Headless supervisor',
    name: 'eden-team',
    desc: 'Headless ATP supervisor for CI, cron, or automated agent-team workflows.',
    links: [
      { label: 'Set up headless', href: '/eden-team/tutorials/headless-supervisor/' },
    ],
    href: '/eden-team/',
  },
];
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Docs — 0d3sa</title>
  <meta name="description" content="Agentic Team Protocol documentation, plus component guides for eden-memory, eden-relay, and eden-team." />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;700&display=swap" rel="stylesheet" />
</head>
<body>
  <!--
    THESIS: The docs landing page foregrounds the ATP doc path on a light, green product surface. A developer finds the install reminder, the role roster, and component reference without visual noise.
    OWN-WORLD: White/off-white ground, green primary (#16a34a), soft gray borders, Manrope type, JetBrains Mono for commands, rounded cards with subtle shadow. Generated product-style PNG spot image below the hero lead.
    STORY: A developer looking for docs finds the ATP path immediately, sees the four doc quadrants, and can drop into component reference without losing context.
    FIRST VIEWPORT: Centered product title and lead; below, a clean two-column install-reminder panel with ATP doc quadrants and commands.
    FORM: Local-first product (brief-pinned green/white/product direction).
    FINISH: unreviewed and undocumented is unfinished; this build ends with the finish review, the verdict, and DESIGN.md.
  -->

  <header class="site-header">
    <div class="wrap nav">
      <a href="/" class="brand" aria-label="0d3sa home">
        <img src="/images/brand-icon.png" alt="" class="brand-mark" width="32" height="32" aria-hidden="true" />
        <span class="brand-name">0d3sa</span>
      </a>
      <nav class="nav-links" aria-label="Primary">
        <a href="/">Home</a>
        <a href="https://github.com/yakovkhalinsky/eden-releases" target="_blank" rel="noreferrer">GitHub</a>
        <a href="/eden-memory/reference/downloads/" class="btn btn-sm">Downloads</a>
      </nav>
    </div>
  </header>

  <main>
    <section class="hero" aria-labelledby="hero-title">
      <div class="wrap hero-wrap">
        <div class="product-meta">
          <span class="status-chip ready"><span class="status-dot" aria-hidden="true"></span>Documentation</span>
        </div>
        <h1 id="hero-title">Agentic Team Protocol docs</h1>
        <p class="lead">
          Docs for the protocol, the roles, and the components that power it. Start with the ATP path; drop into eden-memory, eden-relay, or eden-team when you need a specific part.
        </p>
      </div>
    </section>

    <section class="docs-path" aria-labelledby="docs-path-title">
      <div class="wrap">
        <div class="path-card">
          <div class="path-head">
            <div class="path-title-group">
              <h2 id="docs-path-title">Start with the protocol</h2>
              <p class="path-subtitle">Install ATP, ratify the charter, then explore components.</p>
            </div>
            <a href="/agentic-team-protocol/getting-started/" class="btn btn-primary">Install ATP</a>
          </div>

          <div class="path-body">
            <div class="path-block path-block-wide">
              <div class="block-label">Doc quadrants</div>
              <div class="quadrant-grid">
                {atpQuadrants.map(q => (
                  <a href={q.href} class="quadrant-card">
                    <span class="quadrant-label">{q.label}</span>
                    <span class="quadrant-hint">{q.hint}</span>
                  </a>
                ))}
              </div>
            </div>

            <div class="path-block">
              <div class="block-label">How to install</div>
              <p class="reminder-text">
                Install the binaries, wire your project, then restart Claude Code.
              </p>
              <div class="reminder-commands">
                <code class="cmd">curl -fsSL https://0d3sa.com/eden-memory/install.sh | sh</code>
                <code class="cmd">curl -fsSL https://0d3sa.com/agentic-team-protocol/install.sh | sh</code>
                <code class="cmd">cd ~/my-project && eden-memory setup claude</code>
              </div>
              <a href="/agentic-team-protocol/getting-started/" class="reminder-link">Full quick start →</a>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="section roles-section" aria-labelledby="roles-title">
      <div class="wrap">
        <div class="section-head">
          <h2 id="roles-title">Role roster</h2>
          <p class="section-lead">Six roles, each with a scope and a decision right. Read the <a href="/agentic-team-protocol/agents/">agents</a> and <a href="/agentic-team-protocol/lifecycle/">lifecycle</a> pages for the full protocol.</p>
        </div>
        <ul class="role-grid" role="list">
          {roles.map(role => (
            <li class="role-card">
              <div class="role-head">
                <span class="role-name">{role.name}</span>
              </div>
              <p class="role-duty">{role.duty}</p>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <section class="section components-section" aria-labelledby="components-title">
      <div class="wrap">
        <div class="section-head">
          <h2 id="components-title">Component reference</h2>
          <p class="section-lead">Three single-file binaries power the protocol. Pick a component for deep configuration.</p>
        </div>
        <div class="component-grid">
          {components.map(c => (
            <a href={c.href} class="component-card">
              <div class="component-meta">
                <span class="component-tag">{c.tag}</span>
              </div>
              <h3 class="component-name">{c.name}</h3>
              <p class="component-desc">{c.desc}</p>
              <div class="component-links">
                {c.links.map(link => <span class="component-link">{link.label}</span>)}
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>
  </main>

  <footer class="site-footer">
    <div class="wrap footer-row">
      <span class="footer-copy">© 2026 0d3sa. Open source under Apache-2.0.</span>
      <nav class="footer-links" aria-label="Footer">
        <a href="https://github.com/yakovkhalinsky/eden-releases">GitHub</a>
        <span class="sep" aria-hidden="true">·</span>
        <a href="/docs/">Docs</a>
        <span class="sep" aria-hidden="true">·</span>
        <a href="/eden-memory/reference/downloads/">Downloads</a>
        <span class="sep" aria-hidden="true">·</span>
        <a href="https://github.com/yakovkhalinsky/eden-releases/releases">Releases</a>
      </nav>
    </div>
  </footer>
</body>
</html>

<style>
  :root {
    --bg: #fafafa;
    --surface: #ffffff;
    --surface-raised: #f3f4f6;
    --surface-soft: #f0fdf4;
    --border: #e5e7eb;
    --border-subtle: #f3f4f6;
    --text: #111827;
    --text-secondary: #4b5563;
    --text-muted: #6b7280;
    --text-dim: #9ca3af;
    --primary: #16a34a;
    --primary-dark: #15803d;
    --primary-soft: rgba(22, 163, 74, 0.08);
    --primary-soft-border: rgba(22, 163, 74, 0.2);
    --accent: #2563eb;
    --accent-soft: rgba(37, 99, 235, 0.08);
    --ready: #16a34a;
    --restricted: #d97706;
    --radius-sm: 8px;
    --radius: 12px;
    --radius-lg: 16px;
    --max: 1100px;
    --display: Manrope, -apple-system, BlinkMacSystemFont, sans-serif;
    --body: Manrope, -apple-system, BlinkMacSystemFont, sans-serif;
    --mono: JetBrains Mono, ui-monospace, monospace;
    --shadow-sm: 0 1px 2px 0 rgba(0, 0, 0, 0.04);
    --shadow: 0 1px 3px 0 rgba(0, 0, 0, 0.08), 0 1px 2px -1px rgba(0, 0, 0, 0.08);
    --shadow-md: 0 4px 6px -1px rgba(0, 0, 0, 0.06), 0 2px 4px -2px rgba(0, 0, 0, 0.06);
  }

  *, *::before, *::after { box-sizing: border-box; }

  html, body {
    margin: 0;
    padding: 0;
    font-family: var(--body);
    color: var(--text);
    background: var(--bg);
    line-height: 1.6;
    -webkit-font-smoothing: antialiased;
  }

  a {
    color: var(--primary-dark);
    text-decoration: none;
  }
  a:hover { text-decoration: underline; }

  code {
    font-family: var(--mono);
    font-size: 0.9em;
    background: var(--surface-raised);
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    padding: 2px 6px;
    color: var(--text-secondary);
  }

  .wrap {
    max-width: var(--max);
    margin: 0 auto;
    padding: 0 24px;
  }

  /* Header */
  .site-header {
    border-bottom: 1px solid var(--border);
    background: var(--surface);
    position: sticky;
    top: 0;
    z-index: 50;
  }

  .nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 64px;
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 10px;
    color: var(--text);
    font-weight: 700;
    font-size: 1.1rem;
  }
  .brand:hover { text-decoration: none; }

  .brand-mark {
    width: 32px;
    height: 32px;
    border-radius: var(--radius-sm);
    display: block;
    object-fit: cover;
    box-shadow: var(--shadow-sm);
  }

  .nav-links {
    display: flex;
    gap: 24px;
    align-items: center;
    font-size: 0.9rem;
  }

  .nav-links a {
    color: var(--text-secondary);
    font-weight: 500;
  }
  .nav-links a:hover { color: var(--text); text-decoration: none; }

  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    padding: 12px 20px;
    border-radius: var(--radius-sm);
    font-weight: 600;
    font-size: 0.92rem;
    border: 1px solid transparent;
    cursor: pointer;
    transition: background-color .12s ease, border-color .12s ease, color .12s ease, box-shadow .12s ease;
    text-decoration: none;
    line-height: 1;
  }
  .btn:hover { text-decoration: none; }

  .btn-primary {
    background: var(--primary);
    color: #ffffff;
    box-shadow: var(--shadow-sm);
  }
  .btn-primary:hover { background: var(--primary-dark); }

  .btn-secondary {
    background: var(--surface);
    border-color: var(--border);
    color: var(--text-secondary);
  }
  .btn-secondary:hover { border-color: var(--primary); color: var(--primary); }

  .btn-sm {
    padding: 8px 14px;
    font-size: 0.82rem;
    background: var(--surface);
    border-color: var(--border);
    color: var(--text-secondary);
  }
  .btn-sm:hover { border-color: var(--primary); color: var(--primary); background: var(--surface); }

  /* Status chips */
  .status-chip {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 4px 10px;
    border-radius: 999px;
    font-size: 0.72rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.03em;
    border: 1px solid transparent;
    white-space: nowrap;
  }

  .status-chip.ready {
    background: rgba(22, 163, 74, 0.08);
    color: var(--ready);
    border-color: rgba(22, 163, 74, 0.2);
  }

  .status-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: currentColor;
  }

  /* Hero */
  .hero {
    padding: 64px 0 48px;
    text-align: center;
    border-bottom: 1px solid var(--border-subtle);
    background: var(--surface) url('/images/hero-bg.png') center / cover no-repeat;
  }

  .hero-wrap {
    max-width: 720px;
    margin: 0 auto;
  }

  .product-meta {
    display: flex;
    justify-content: center;
    gap: 14px;
    align-items: center;
    margin-bottom: 18px;
    flex-wrap: wrap;
  }

  h1 {
    font-family: var(--display);
    font-size: clamp(2.2rem, 5vw, 3.2rem);
    line-height: 1.1;
    font-weight: 800;
    letter-spacing: -0.03em;
    margin: 0 0 14px;
    color: var(--text);
  }

  .lead {
    font-size: clamp(1.05rem, 1.6vw, 1.2rem);
    color: var(--text-muted);
    margin: 0 auto;
    line-height: 1.55;
    max-width: 640px;
  }

  /* Docs path */
  .docs-path {
    padding: 48px 0 80px;
  }

  .path-card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    padding: 32px;
    box-shadow: var(--shadow);
  }

  .path-head {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 18px;
    margin-bottom: 24px;
    flex-wrap: wrap;
  }

  .path-title-group h2 {
    font-family: var(--display);
    font-size: 1.6rem;
    font-weight: 700;
    margin: 0 0 4px;
    letter-spacing: -0.02em;
    color: var(--text);
  }

  .path-subtitle {
    color: var(--text-muted);
    margin: 0;
    font-size: 0.95rem;
  }

  .path-body {
    display: grid;
    grid-template-columns: 2fr 1fr;
    gap: 20px;
  }

  .path-block {
    background: var(--bg);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 20px;
  }

  .path-block-wide {
    grid-column: 1;
  }

  .block-label {
    font-family: var(--mono);
    font-size: 0.72rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--text-dim);
    margin-bottom: 16px;
    padding-bottom: 10px;
    border-bottom: 1px solid var(--border-subtle);
  }

  .quadrant-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 12px;
  }

  .quadrant-card {
    display: flex;
    flex-direction: column;
    gap: 4px;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    padding: 16px;
    color: var(--text);
    transition: border-color .12s ease, box-shadow .12s ease;
  }
  .quadrant-card:hover {
    border-color: var(--primary-soft-border);
    box-shadow: var(--shadow-sm);
    text-decoration: none;
  }

  .quadrant-label {
    font-weight: 700;
    font-size: 1rem;
  }

  .quadrant-hint {
    color: var(--text-muted);
    font-size: 0.82rem;
  }

  .reminder-text {
    color: var(--text-muted);
    font-size: 0.9rem;
    margin: 0 0 14px;
    line-height: 1.5;
  }

  .reminder-commands {
    display: flex;
    flex-direction: column;
    gap: 10px;
    margin-bottom: 14px;
  }

  .cmd {
    display: block;
    background: var(--surface-raised);
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    padding: 10px 12px;
    font-size: 0.78rem;
    color: var(--text);
    overflow-x: auto;
    white-space: nowrap;
  }

  .reminder-link {
    font-weight: 600;
    font-size: 0.9rem;
    color: var(--primary-dark);
  }

  /* Sections */
  .section {
    padding: 80px 0;
    border-top: 1px solid var(--border-subtle);
  }

  .section-head {
    margin-bottom: 40px;
    text-align: center;
    max-width: 640px;
    margin-left: auto;
    margin-right: auto;
  }

  .section-head h2 {
    font-family: var(--display);
    font-size: clamp(1.5rem, 3vw, 2rem);
    font-weight: 700;
    margin: 0 0 10px;
    letter-spacing: -0.02em;
    color: var(--text);
  }

  .section-lead {
    color: var(--text-muted);
    margin: 0;
    font-size: 1rem;
    line-height: 1.55;
  }

  .section-lead a { color: var(--primary-dark); }

  /* Roles */
  .role-grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 18px;
  }

  .role-card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 20px;
    transition: border-color .12s ease, box-shadow .12s ease;
  }
  .role-card:hover {
    border-color: var(--primary-soft-border);
    box-shadow: var(--shadow);
  }

  .role-head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 10px;
    margin-bottom: 8px;
  }

  .role-name {
    font-family: var(--display);
    font-size: 1.05rem;
    font-weight: 700;
    color: var(--text);
  }

  .role-duty {
    color: var(--text-muted);
    font-size: 0.88rem;
    margin: 0;
    line-height: 1.45;
  }

  /* Components */
  .components-section {
    background: var(--surface);
    border-top: 1px solid var(--border);
  }

  .component-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 18px;
  }

  .component-card {
    display: flex;
    flex-direction: column;
    background: var(--bg);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    padding: 24px;
    color: var(--text);
    transition: border-color .12s ease, box-shadow .12s ease, transform .12s ease;
    box-shadow: var(--shadow-sm);
  }
  .component-card:hover {
    border-color: var(--primary-soft-border);
    box-shadow: var(--shadow-md);
    transform: translateY(-2px);
    text-decoration: none;
  }

  .component-tag {
    display: inline-block;
    padding: 4px 10px;
    border-radius: 999px;
    background: var(--primary-soft);
    color: var(--primary-dark);
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .component-name {
    font-family: var(--display);
    font-size: 1.25rem;
    font-weight: 700;
    margin: 14px 0 8px;
    color: var(--text);
  }

  .component-desc {
    color: var(--text-muted);
    font-size: 0.9rem;
    margin: 0 0 18px;
    line-height: 1.5;
    flex: 1;
  }

  .component-links {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .component-link {
    font-size: 0.78rem;
    padding: 5px 10px;
    border-radius: var(--radius-sm);
    background: var(--surface-raised);
    border: 1px solid var(--border);
    color: var(--text-muted);
    font-weight: 500;
  }

  /* Footer */
  .site-footer {
    border-top: 1px solid var(--border);
    padding: 40px 0;
    color: var(--text-muted);
    font-size: 0.86rem;
    background: var(--surface);
  }

  .footer-row {
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 14px;
  }

  .footer-links a { color: var(--text-muted); }
  .footer-links a:hover { color: var(--text); }
  .footer-links .sep { margin: 0 6px; color: var(--text-dim); }

  /* Responsive */
  @media (max-width: 900px) {
    .path-body { grid-template-columns: 1fr; }
    .path-block-wide { grid-column: auto; }
    .role-grid { grid-template-columns: repeat(2, 1fr); }
    .component-grid { grid-template-columns: repeat(2, 1fr); }
  }

  @media (max-width: 640px) {
    .hero { padding: 48px 0 36px; }
    .docs-path { padding: 36px 0 56px; }
    .path-card { padding: 24px; }
    .section { padding: 56px 0; }
    .quadrant-grid { grid-template-columns: 1fr; }
    .role-grid { grid-template-columns: 1fr; }
    .component-grid { grid-template-columns: 1fr; }
    .path-head { align-items: flex-start; flex-direction: column; }
    .path-head .btn { width: 100%; justify-content: center; }
  }
</style>