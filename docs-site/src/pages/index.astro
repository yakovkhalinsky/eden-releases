---
// Landing page for 0d3sa.com.
// Mode: Product landing → pick a path → install → docs.

const atpCard = {
  tag: 'Agent teams',
  name: 'Agentic Team Protocol',
  desc: 'Role-based agent teams inside Claude Code. Dispatcher, Researcher, Builder, Verifier, Archivist, and Runtime follow a seven-stage lifecycle with durable memory records.',
  href: '/agentic-team-protocol/',
  links: [
    { label: 'Quick start', href: '/agentic-team-protocol/getting-started/' },
    { label: 'Lifecycle', href: '/agentic-team-protocol/lifecycle/' },
    { label: 'Agents', href: '/agentic-team-protocol/agents/' },
  ],
};

const memoryCard = {
  tag: 'Memory & sync',
  name: 'eden-memory',
  desc: 'Local-first SQLite memory with vector embeddings, an MCP server, and encrypted multi-device sync through a self-hosted relay.',
  href: '/eden-memory/',
  links: [
    { label: 'Quick start', href: '/eden-memory/getting-started/' },
    { label: 'Tools', href: '/eden-memory/reference/tools/' },
    { label: 'Dreaming', href: '/eden-memory/concepts/dreaming/' },
  ],
};

const binaries = [
  {
    name: 'eden-memory',
    role: 'Memory, MCP server, sync, and device pairing',
    href: '/eden-memory/',
    size: '~66–107 MB',
  },
  {
    name: 'eden-relay',
    role: 'Self-hosted relay for encrypted multi-device sync',
    href: '/eden-relay/',
    size: '~10–11 MB',
  },
  {
    name: 'eden-team',
    role: 'Headless ATP supervisor for CI and automation',
    href: '/eden-team/',
    size: '~10–11 MB',
  },
];

const atpInstall = 'curl -fsSL https://0d3sa.com/agentic-team-protocol/install.sh | sh';
const memoryInstall = 'curl -fsSL https://0d3sa.com/eden-memory/install.sh | sh';
const setupCmd = 'cd ~/my-project && eden-memory setup claude';
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>0d3sa — Local-first agent infrastructure</title>
  <meta name="description" content="Agentic Team Protocol and eden-memory: local-first, role-based agent teams with durable SQLite memory and encrypted multi-device sync." />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;700&display=swap" rel="stylesheet" />
</head>
<body>
  <header class="site-header">
    <div class="wrap nav">
      <a href="/" class="brand" aria-label="0d3sa home">
        <img src="/images/brand-icon.png" alt="" class="brand-mark" width="32" height="32" aria-hidden="true" />
        <span class="brand-name">0d3sa</span>
      </a>
      <nav class="nav-links" aria-label="Primary">
        <a href="/docs/">Docs</a>
        <a href="https://github.com/yakovkhalinsky/eden-releases" target="_blank" rel="noreferrer">GitHub</a>
        <a href="/eden-memory/reference/downloads/" class="btn btn-sm">Downloads</a>
      </nav>
    </div>
  </header>

  <main>
    <section class="hero" aria-labelledby="hero-title">
      <div class="wrap hero-wrap">
        <div class="product-meta">
          <span class="status-chip ready"><span class="status-dot" aria-hidden="true"></span>Production ready</span>
        </div>
        <h1 id="hero-title">Local-first agent infrastructure</h1>
        <p class="lead">
          Role-based agent teams and durable memory that stay on your machine. No cloud account, no external API for recall, no lock-in.
        </p>
        <div class="hero-actions">
          <a href="#install" class="btn btn-primary">Install ATP</a>
          <a href="/docs/" class="btn btn-secondary">Read the docs</a>
        </div>
      </div>
    </section>

    <section class="section products-section" aria-labelledby="products-title">
      <div class="wrap">
        <div class="section-head">
          <h2 id="products-title">Two paths into the same system</h2>
          <p class="section-lead">Pick the surface that matches what you are building today.</p>
        </div>
        <div class="product-grid">
          <a href={atpCard.href} class="product-card">
            <div class="product-meta">
              <span class="product-tag">{atpCard.tag}</span>
            </div>
            <h3 class="product-name">{atpCard.name}</h3>
            <p class="product-desc">{atpCard.desc}</p>
            <div class="product-links">
              {atpCard.links.map(link => <span class="product-link">{link.label}</span>)}
            </div>
          </a>
          <a href={memoryCard.href} class="product-card">
            <div class="product-meta">
              <span class="product-tag">{memoryCard.tag}</span>
            </div>
            <h3 class="product-name">{memoryCard.name}</h3>
            <p class="product-desc">{memoryCard.desc}</p>
            <div class="product-links">
              {memoryCard.links.map(link => <span class="product-link">{link.label}</span>)}
            </div>
          </a>
        </div>
      </div>
    </section>

    <section class="section binaries-section" aria-labelledby="binaries-title">
      <div class="wrap">
        <div class="section-head">
          <h2 id="binaries-title">Three binaries, one release</h2>
          <p class="section-lead">Every 0d3sa release ships three static Go binaries. Install only the ones you need, or get all three with the ATP installer.</p>
        </div>
        <ul class="binary-list" role="list">
          {binaries.map(b => (
            <li class="binary-card">
              <div class="binary-main">
                <a href={b.href} class="binary-name">{b.name}</a>
                <p class="binary-role">{b.role}</p>
              </div>
              <span class="binary-size">{b.size}</span>
            </li>
          ))}
        </ul>
        <div class="binaries-foot">
          <a href="/eden-memory/reference/downloads/" class="reminder-link">Browse downloads and checksums →</a>
        </div>
      </div>
    </section>

    <section class="section install-section" id="install" aria-labelledby="install-title">
      <div class="wrap">
        <div class="section-head">
          <h2 id="install-title">Install in one command</h2>
          <p class="section-lead">The ATP installer sets up the protocol primitives and expects eden-memory to be on your PATH.</p>
        </div>
        <div class="install-card">
          <div class="install-block">
            <div class="block-label">Install Agentic Team Protocol</div>
            <div class="step-row">
              <code class="cmd">{atpInstall}</code>
              <button class="copy-btn" type="button" data-cmd={atpInstall} aria-label="Copy ATP install command">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path></svg>
              </button>
            </div>
          </div>
          <div class="install-divider"></div>
          <div class="install-block">
            <div class="block-label">Then wire your project</div>
            <div class="step-row">
              <code class="cmd">{setupCmd}</code>
              <button class="copy-btn" type="button" data-cmd={setupCmd} aria-label="Copy setup command">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path></svg>
              </button>
            </div>
            <p class="install-hint">Restart Claude Code after wiring. See the <a href="/agentic-team-protocol/getting-started/">full quick start</a> for the eden-memory install step and project charter setup.</p>
          </div>
        </div>
      </div>
    </section>

    <section class="section decision-section" aria-labelledby="decision-title">
      <div class="wrap">
        <div class="section-head">
          <h2 id="decision-title">Which one do I need?</h2>
          <p class="section-lead">A quick decision map for the two entry points and three binaries.</p>
        </div>
        <div class="decision-grid">
          <div class="decision-card">
            <h3 class="decision-question">I want role-based agent teams in Claude Code</h3>
            <p class="decision-answer">
              Install <a href="/eden-memory/getting-started/">eden-memory</a> first, then run the <a href="/agentic-team-protocol/getting-started/">ATP installer</a>.
              You get the protocol agents, slash commands, and lifecycle records.
            </p>
          </div>
          <div class="decision-card">
            <h3 class="decision-question">I just want MCP memory for my client</h3>
            <p class="decision-answer">
              Install <a href="/eden-memory/getting-started/">eden-memory</a> only, then run <code>eden-memory setup claude</code> (or your client’s equivalent).
            </p>
          </div>
          <div class="decision-card">
            <h3 class="decision-question">I need multi-device sync</h3>
            <p class="decision-answer">
              Use <a href="/eden-relay/how-to/run-relay-server/">eden-relay</a> as a self-hosted relay. eden-memory encrypts contents end-to-end before they reach the relay.
            </p>
          </div>
          <div class="decision-card">
            <h3 class="decision-question">I want headless ATP in CI or cron</h3>
            <p class="decision-answer">
              Use <a href="/eden-team/tutorials/headless-supervisor/">eden-team</a>, the headless supervisor that runs the same role lifecycle non-interactively.
            </p>
          </div>
        </div>
      </div>
    </section>
  </main>

  <footer class="site-footer">
    <div class="wrap footer-row">
      <span class="footer-copy">© 2026 0d3sa. Open source under Apache-2.0.</span>
      <nav class="footer-links" aria-label="Footer">
        <a href="https://github.com/yakovkhalinsky/eden-releases">GitHub</a>
        <span class="sep" aria-hidden="true">·</span>
        <a href="/docs/">Docs</a>
        <span class="sep" aria-hidden="true">·</span>
        <a href="/eden-memory/reference/downloads/">Downloads</a>
        <span class="sep" aria-hidden="true">·</span>
        <a href="https://github.com/yakovkhalinsky/eden-releases/releases">Release notes</a>
      </nav>
    </div>
  </footer>

  <script is:inline>
    (function () {
      var btns = document.querySelectorAll('.copy-btn');
      btns.forEach(function (btn) {
        btn.addEventListener('click', function () {
          var text = btn.getAttribute('data-cmd');
          if (!text) return;
          if (navigator.clipboard) {
            navigator.clipboard.writeText(text).then(function () {
              var old = btn.innerHTML;
              btn.innerHTML = '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"></polyline></svg>';
              btn.setAttribute('aria-label', 'Copied');
              setTimeout(function () {
                btn.innerHTML = old;
                btn.setAttribute('aria-label', 'Copy command');
              }, 1400);
            });
          }
        });
      });
    })();
  </script>
</body>
</html>

<style>
  :root {
    --bg: #fafafa;
    --surface: #ffffff;
    --surface-raised: #f3f4f6;
    --surface-soft: #f0fdf4;
    --border: #e5e7eb;
    --border-subtle: #f3f4f6;
    --text: #111827;
    --text-secondary: #4b5563;
    --text-muted: #6b7280;
    --text-dim: #6b7280;
    --primary: #16a34a;
    --primary-dark: #15803d;
    --primary-soft: rgba(22, 163, 74, 0.08);
    --primary-soft-border: rgba(22, 163, 74, 0.2);
    --accent: #2563eb;
    --accent-soft: rgba(37, 99, 235, 0.08);
    --ready: #16a34a;
    --radius-sm: 8px;
    --radius: 12px;
    --radius-lg: 16px;
    --max: 1100px;
    --display: Manrope, -apple-system, BlinkMacSystemFont, sans-serif;
    --body: Manrope, -apple-system, BlinkMacSystemFont, sans-serif;
    --mono: JetBrains Mono, ui-monospace, monospace;
    --shadow-sm: 0 1px 2px 0 rgba(0, 0, 0, 0.04);
    --shadow: 0 1px 3px 0 rgba(0, 0, 0, 0.08), 0 1px 2px -1px rgba(0, 0, 0, 0.08);
    --shadow-md: 0 4px 6px -1px rgba(0, 0, 0, 0.06), 0 2px 4px -2px rgba(0, 0, 0, 0.06);
  }

  *, *::before, *::after { box-sizing: border-box; }

  html, body {
    margin: 0;
    padding: 0;
    font-family: var(--body);
    color: var(--text);
    background: var(--bg);
    line-height: 1.6;
    -webkit-font-smoothing: antialiased;
  }

  a {
    color: var(--primary-dark);
    text-decoration: none;
  }
  a:hover { text-decoration: underline; }

  code {
    font-family: var(--mono);
    font-size: 0.9em;
    background: var(--surface-raised);
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    padding: 2px 6px;
    color: var(--text-secondary);
  }

  .wrap {
    max-width: var(--max);
    margin: 0 auto;
    padding: 0 24px;
  }

  /* Header */
  .site-header {
    border-bottom: 1px solid var(--border);
    background: var(--surface);
    position: sticky;
    top: 0;
    z-index: 50;
  }

  .nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 64px;
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 10px;
    color: var(--text);
    font-weight: 700;
    font-size: 1.1rem;
  }
  .brand:hover { text-decoration: none; }

  .brand-mark {
    width: 32px;
    height: 32px;
    border-radius: var(--radius-sm);
    display: block;
    object-fit: cover;
    box-shadow: var(--shadow-sm);
  }

  .nav-links {
    display: flex;
    gap: 24px;
    align-items: center;
    font-size: 0.9rem;
  }

  .nav-links a {
    color: var(--text-secondary);
    font-weight: 500;
  }
  .nav-links a:hover { color: var(--text); text-decoration: none; }

  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    padding: 12px 20px;
    border-radius: var(--radius-sm);
    font-weight: 600;
    font-size: 0.92rem;
    border: 1px solid transparent;
    cursor: pointer;
    transition: background-color .12s ease, border-color .12s ease, color .12s ease, box-shadow .12s ease;
    text-decoration: none;
    line-height: 1;
  }
  .btn:hover { text-decoration: none; }

  .btn-primary {
    background: var(--primary);
    color: #ffffff;
    box-shadow: var(--shadow-sm);
  }
  .btn-primary:hover { background: var(--primary-dark); }

  .btn-secondary {
    background: var(--surface);
    border-color: var(--border);
    color: var(--text-secondary);
  }
  .btn-secondary:hover { border-color: var(--primary); color: var(--primary); }

  .btn-sm {
    padding: 8px 14px;
    font-size: 0.82rem;
    background: var(--surface);
    border-color: var(--border);
    color: var(--text-secondary);
  }
  .btn-sm:hover { border-color: var(--primary); color: var(--primary); background: var(--surface); }

  /* Status chips */
  .status-chip {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 4px 10px;
    border-radius: 999px;
    font-size: 0.72rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.03em;
    border: 1px solid transparent;
    white-space: nowrap;
  }

  .status-chip.ready {
    background: rgba(22, 163, 74, 0.08);
    color: var(--ready);
    border-color: rgba(22, 163, 74, 0.2);
  }

  .status-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: currentColor;
  }

  /* Hero */
  .hero {
    padding: 80px 0 64px;
    text-align: center;
    border-bottom: 1px solid var(--border-subtle);
    background: var(--surface) url('/images/hero-bg.png') center / cover no-repeat;
  }

  .hero-wrap {
    max-width: 720px;
    margin: 0 auto;
  }

  .product-meta {
    display: flex;
    justify-content: center;
    gap: 14px;
    align-items: center;
    margin-bottom: 18px;
    flex-wrap: wrap;
  }

  h1 {
    font-family: var(--display);
    font-size: clamp(2.4rem, 5vw, 3.8rem);
    line-height: 1.05;
    font-weight: 800;
    letter-spacing: -0.03em;
    margin: 0 0 18px;
    color: var(--text);
  }

  .lead {
    font-size: clamp(1.05rem, 1.6vw, 1.25rem);
    color: var(--text-muted);
    margin: 0 auto 28px;
    line-height: 1.6;
    max-width: 640px;
  }

  .hero-actions {
    display: flex;
    justify-content: center;
    gap: 14px;
    flex-wrap: wrap;
  }

  /* Sections */
  .section {
    padding: 80px 0;
    border-top: 1px solid var(--border-subtle);
  }

  .section-head {
    margin-bottom: 40px;
    text-align: center;
    max-width: 640px;
    margin-left: auto;
    margin-right: auto;
  }

  .section-head h2 {
    font-family: var(--display);
    font-size: clamp(1.5rem, 3vw, 2.2rem);
    font-weight: 700;
    margin: 0 0 10px;
    letter-spacing: -0.02em;
    color: var(--text);
  }

  .section-lead {
    color: var(--text-muted);
    margin: 0;
    font-size: 1.02rem;
    line-height: 1.55;
  }

  .section-lead a { color: var(--primary-dark); }

  /* Product cards */
  .products-section { background: var(--surface); }

  .product-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 18px;
  }

  .product-card {
    display: flex;
    flex-direction: column;
    background: var(--bg);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    padding: 28px;
    color: var(--text);
    transition: border-color .12s ease, box-shadow .12s ease, transform .12s ease;
    box-shadow: var(--shadow-sm);
  }
  .product-card:hover {
    border-color: var(--primary-soft-border);
    box-shadow: var(--shadow-md);
    transform: translateY(-2px);
    text-decoration: none;
  }

  .product-tag {
    display: inline-block;
    padding: 4px 10px;
    border-radius: 999px;
    background: var(--primary-soft);
    color: var(--primary-dark);
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .product-name {
    font-family: var(--display);
    font-size: 1.5rem;
    font-weight: 700;
    margin: 16px 0 10px;
    color: var(--text);
  }

  .product-desc {
    color: var(--text-muted);
    font-size: 0.95rem;
    margin: 0 0 22px;
    line-height: 1.55;
    flex: 1;
  }

  .product-links {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .product-link {
    font-size: 0.78rem;
    padding: 5px 10px;
    border-radius: var(--radius-sm);
    background: var(--surface-raised);
    border: 1px solid var(--border);
    color: var(--text-muted);
    font-weight: 500;
  }

  /* Binaries */
  .binaries-section { background: var(--bg); }

  .binary-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .binary-card {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 20px 24px;
    transition: border-color .12s ease, box-shadow .12s ease;
  }
  .binary-card:hover {
    border-color: var(--primary-soft-border);
    box-shadow: var(--shadow-sm);
  }

  .binary-name {
    font-family: var(--display);
    font-size: 1.1rem;
    font-weight: 700;
    color: var(--text);
  }
  .binary-name:hover { color: var(--primary-dark); }

  .binary-role {
    color: var(--text-muted);
    font-size: 0.88rem;
    margin: 4px 0 0;
    line-height: 1.45;
  }

  .binary-size {
    font-family: var(--mono);
    font-size: 0.76rem;
    color: var(--text-dim);
    white-space: nowrap;
  }

  .binaries-foot {
    margin-top: 20px;
    text-align: center;
  }

  .reminder-link {
    font-weight: 600;
    font-size: 0.9rem;
    color: var(--primary-dark);
  }

  /* Install */
  .install-section { background: var(--surface); }

  .install-card {
    background: var(--bg);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    padding: 28px;
  }

  .install-block + .install-block { margin-top: 24px; }

  .install-divider {
    height: 1px;
    background: var(--border-subtle);
    margin: 24px 0;
  }

  .block-label {
    font-family: var(--mono);
    font-size: 0.72rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--text-dim);
    margin-bottom: 12px;
  }

  .step-row {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 8px;
    align-items: center;
  }

  .cmd {
    display: block;
    background: var(--surface-raised);
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    padding: 12px 14px;
    font-size: 0.82rem;
    color: var(--text);
    overflow-x: auto;
    white-space: nowrap;
    max-width: 100%;
  }

  .copy-btn {
    flex-shrink: 0;
    width: 40px;
    height: 40px;
    display: grid;
    place-items: center;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    color: var(--text-muted);
    cursor: pointer;
    transition: border-color .12s ease, color .12s ease, background-color .12s ease;
  }
  .copy-btn:hover {
    border-color: var(--primary);
    color: var(--primary);
    background: var(--primary-soft);
  }

  .install-hint {
    color: var(--text-muted);
    font-size: 0.88rem;
    margin: 14px 0 0;
    line-height: 1.5;
  }

  .install-hint a { color: var(--primary-dark); font-weight: 600; }

  /* Decision */
  .decision-section { background: var(--bg); }

  .decision-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 18px;
