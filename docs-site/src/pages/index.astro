---
// Landing page for 0d3sa.com.
// Visual world: Production Call Sheet — the docs are a working call sheet:
// roles, stages, and handoffs laid out for the day's shoot.
// Mode: Read (docs/reference entry point).

const edenMemoryInstall = 'curl -fsSL https://0d3sa.com/eden-memory/install.sh | sh';
const atpInstall = 'curl -fsSL https://0d3sa.com/agentic-team-protocol/install.sh | sh';
const setupCmd = 'eden-memory setup claude';
const localCmd = 'curl -fsSL https://0d3sa.com/agentic-team-protocol/install.sh | sh -s -- --local';
const charterCmd = '/team-charter';
const teamCmd = '/team <your first goal>';
const statusCmd = '/team-status';

const roles = [
  { name: 'Dispatcher', duty: 'Assigns goals and routes work', status: 'active' },
  { name: 'Researcher', duty: 'Investigates options and reports', status: 'active' },
  { name: 'Builder', duty: 'Implements the chosen approach', status: 'active' },
  { name: 'Verifier', duty: 'Reviews for correctness and charter compliance', status: 'active' },
  { name: 'Archivist', duty: 'Records lifecycle and manages memory hygiene', status: 'active' },
  { name: 'Runtime', duty: 'Executes operational actions', status: 'restricted' },
];

const stages = [
  { id: '01', name: 'Goal receipt', owner: 'Dispatcher', desc: 'Capture the request and constraints.' },
  { id: '02', name: 'Routing and assignment', owner: 'Dispatcher', desc: 'Assign target role, owner, deadline, success criteria.' },
  { id: '03', name: 'Context gathering', owner: 'Researcher', desc: 'Record known facts and options considered.' },
  { id: '04', name: 'Action', owner: 'Builder / Runtime', desc: 'Execute and record what was done.' },
  { id: '05', name: 'Verification', owner: 'Verifier', desc: 'Write green, red, or blocked verdict.' },
  { id: '06', name: 'Recording and archival', owner: 'Archivist', desc: 'Ensure final outcome and skill updates are stored.' },
  { id: '07', name: 'Hand-off or closure', owner: 'Archivist', desc: 'Confirm records are complete and transfer ownership if needed.' },
];

const components = [
  {
    tag: 'Memory & sync',
    name: 'eden-memory',
    desc: 'Local-first SQLite memory with vector embeddings, MCP server, and encrypted multi-device sync.',
    links: [
      { label: 'Quick start', href: '/eden-memory/getting-started/' },
      { label: 'Tools', href: '/eden-memory/reference/tools/' },
      { label: 'Sync', href: '/eden-memory/multi-device-sync/' },
    ],
    href: '/eden-memory/',
  },
  {
    tag: 'Relay server',
    name: 'eden-relay',
    desc: 'Self-hosted relay for multi-device sync. TLS, systemd, and VPS hardening guides.',
    links: [
      { label: 'Run a relay', href: '/eden-relay/how-to/run-relay-server/' },
      { label: 'Deploy on VPS', href: '/eden-relay/how-to/deploy-public-vps/' },
    ],
    href: '/eden-relay/',
  },
  {
    tag: 'Headless supervisor',
    name: 'eden-team',
    desc: 'Headless ATP supervisor for CI, cron, or automated agent-team workflows.',
    links: [
      { label: 'Set up headless', href: '/eden-team/tutorials/headless-supervisor/' },
    ],
    href: '/eden-team/',
  },
];
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>0d3sa — Agentic Team Protocol</title>
  <meta name="description" content="Installable, role-based agent teams for Claude Code. Seven-stage lifecycle, durable memory records, and verifiable hand-offs." />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Chakra+Petch:wght@400;500;600;700&family=Saira:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;700&display=swap" rel="stylesheet" />
</head>
<body>
  <!--
    THESIS: The site foregrounds the ATP install/setup path: copyable commands, roles, and lifecycle, all on a dark production-board surface.
    OWN-WORLD: Dark board ground (#0d1117), panel fills (#21262d), hairline borders (#30363d), paper text (#c9d1d9), alert coral for primary actions (#f78166), action blue for links (#58a6ff), status chips with dots. Chakra Petch for display, Saira for body, JetBrains Mono for commands.
    STORY: A developer lands, copies the install commands, sees who does what, and understands the lifecycle before scrolling.
    FIRST VIEWPORT: Left-aligned production title, lead, and two actions at top; below, the install steps panel is the dominant block; role badges sit beneath as a scan line.
    FORM: Production Call Sheet (#7 of 7 grounded directions; seed key 05d59870).
    FINISH: unreviewed and undocumented is unfinished; this build ends with the finish review, the verdict, and DESIGN.md.
  -->

  <header class="site-header">
    <div class="wrap nav">
      <a href="/" class="brand" aria-label="0d3sa home">
        <span class="brand-mark" aria-hidden="true">0</span>
        <span class="brand-name">0d3sa</span>
      </a>
      <nav class="nav-links" aria-label="Primary">
        <a href="/docs/">Docs</a>
        <a href="https://github.com/yakovkhalinsky/eden-releases" target="_blank" rel="noreferrer">GitHub</a>
        <a href="/eden-memory/reference/downloads/" class="btn btn-sm">Downloads</a>
      </nav>
    </div>
  </header>

  <main>
    <section class="hero" aria-labelledby="hero-title">
      <div class="wrap hero-wrap">
        <div class="production-meta">
          <span class="status-chip ready"><span class="status-dot" aria-hidden="true"></span>Production ready</span>
          <span class="production-id">ATP-001</span>
        </div>
        <h1 id="hero-title">AGENTIC TEAM PROTOCOL</h1>
        <p class="lead">
          Installable, role-based agent teams for Claude Code. Dispatch goals, gather context, build, verify, and hand off — with every decision recorded in local durable memory.
        </p>
        <div class="hero-actions">
          <a href="#install-steps" class="btn btn-primary">Install and set up</a>
          <a href="/agentic-team-protocol/getting-started/" class="btn btn-secondary">Full quick start</a>
        </div>
      </div>
    </section>

    <section class="call-sheet" id="install-steps" aria-labelledby="install-steps-title">
      <div class="wrap">
        <div class="sheet-head">
          <div class="sheet-title-group">
            <h2 id="install-steps-title">Install and run</h2>
            <p class="sheet-subtitle">Install ATP in a project, ratify the charter, and dispatch the first goal.</p>
          </div>
          <span class="status-chip ready"><span class="status-dot" aria-hidden="true"></span>Ready</span>
        </div>

        <div class="sheet-body sheet-body-two-col">
          <div class="sheet-block sheet-block-wide">
            <div class="block-label">Install and configure</div>
            <ol class="step-list">
              <li class="step">
                <div class="step-mark" aria-hidden="true">1</div>
                <div class="step-content">
                  <div class="step-row">
                    <code class="cmd">{edenMemoryInstall}</code>
                    <button class="copy-btn" type="button" data-cmd={edenMemoryInstall} aria-label="Copy install command">
                      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path></svg>
                    </button>
                  </div>
                  <span class="step-caption">Install eden-memory (memory, sync, MCP server).</span>
                </div>
              </li>
              <li class="step">
                <div class="step-mark" aria-hidden="true">2</div>
                <div class="step-content">
                  <div class="step-row">
                    <code class="cmd">{atpInstall}</code>
                    <button class="copy-btn" type="button" data-cmd={atpInstall} aria-label="Copy ATP install command">
                      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path></svg>
                    </button>
                  </div>
                  <span class="step-caption">Install ATP global primitives into ~/.claude/.</span>
                </div>
              </li>
              <li class="step">
                <div class="step-mark" aria-hidden="true">3</div>
                <div class="step-content">
                  <div class="step-row">
                    <code class="cmd">cd ~/my-project && {setupCmd}</code>
                    <button class="copy-btn" type="button" data-cmd={`cd ~/my-project
${setupCmd}`} aria-label="Copy setup command">
                      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path></svg>
                    </button>
                  </div>
                  <span class="step-caption">Wire the eden-memory MCP server and install project-local templates.</span>
                </div>
              </li>
            </ol>
          </div>

          <div class="sheet-block sheet-block-right">
            <div class="block-label">Run</div>
            <ol class="step-list" start="4">
              <li class="step">
                <div class="step-mark" aria-hidden="true">4</div>
                <div class="step-content">
                  <div class="step-row">
                    <code class="cmd cmd-inline">{charterCmd}</code>
                    <span class="step-note">after editing .claude/agentic-team-charter.md</span>
                  </div>
                  <span class="step-caption">Ratify the project charter in durable memory.</span>
                </div>
              </li>
              <li class="step">
                <div class="step-mark" aria-hidden="true">5</div>
                <div class="step-content">
                  <div class="step-row">
                    <code class="cmd cmd-inline">{teamCmd}</code>
                    <span class="step-note">replace with your first goal</span>
                  </div>
                  <span class="step-caption">Dispatch the first goal to the team.</span>
                </div>
              </li>
              <li class="step">
                <div class="step-mark" aria-hidden="true">6</div>
                <div class="step-content">
                  <div class="step-row">
                    <code class="cmd cmd-inline">{statusCmd}</code>
                  </div>
                  <span class="step-caption">Check where each goal stands.</span>
                </div>
              </li>
            </ol>
          </div>
        </div>

        <div class="sheet-foot">
          <p>Restart Claude Code completely after step 2 (<code>/exit</code>, then reopen). Full walkthrough: <a href="/agentic-team-protocol/getting-started/">Quick start</a>.</p>
        </div>
      </div>
    </section>

    <section class="section roles-section" aria-labelledby="roles-title">
      <div class="wrap">
        <div class="section-head">
          <h2 id="roles-title">Team roles</h2>
          <p class="section-lead">Six roles, each with a scope and a decision right. Runtime is gated until a charter authorises it.</p>
        </div>
        <ul class="role-grid" role="list">
          {roles.map(role => (
            <li class="role-card">
              <div class="role-head">
                <span class="role-name">{role.name}</span>
                <span class={`status-chip ${role.status === 'restricted' ? 'restricted' : 'ready'}`}>
                  <span class="status-dot" aria-hidden="true"></span>{role.status}
                </span>
              </div>
              <p class="role-duty">{role.duty}</p>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <section class="section stages-section" aria-labelledby="stages-title">
      <div class="wrap">
        <div class="section-head">
          <h2 id="stages-title">Seven-stage lifecycle</h2>
          <p class="section-lead">Every goal moves through the same stages. Each stage produces a record in eden-memory.</p>
        </div>
        <ol class="stage-lanes" role="list">
          {stages.map((stage, i) => (
            <li class="stage-card">
              <div class="stage-id" aria-hidden="true">{stage.id}</div>
              <div class="stage-body">
                <div class="stage-meta">
                  <span class="stage-owner">{stage.owner}</span>
                  {i === stages.length - 1 && <span class="status-chip ready"><span class="status-dot" aria-hidden="true"></span>Closure</span>}
                </div>
                <h3 class="stage-name">{stage.name}</h3>
                <p class="stage-desc">{stage.desc}</p>
              </div>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <section class="section components-section" aria-labelledby="components-title">
      <div class="wrap">
        <div class="section-head">
          <h2 id="components-title">Components</h2>
          <p class="section-lead">Three single-file binaries power the protocol. Install ATP and you get all three; dive deeper when you need a specific part.</p>
        </div>
        <div class="component-grid">
          {components.map(c => (
            <a href={c.href} class="component-card">
              <div class="component-meta">
                <span class="component-tag">{c.tag}</span>
              </div>
              <h3 class="component-name">{c.name}</h3>
              <p class="component-desc">{c.desc}</p>
              <div class="component-links">
                {c.links.map(link => <span class="component-link">{link.label}</span>)}
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>
  </main>

  <footer class="site-footer">
    <div class="wrap footer-row">
      <span class="footer-copy">© 2026 0d3sa. Open source under Apache-2.0.</span>
      <nav class="footer-links" aria-label="Footer">
        <a href="https://github.com/yakovkhalinsky/eden-releases">GitHub</a>
        <span class="sep" aria-hidden="true">·</span>
        <a href="/docs/">Docs</a>
        <span class="sep" aria-hidden="true">·</span>
        <a href="/eden-memory/reference/downloads/">Downloads</a>
        <span class="sep" aria-hidden="true">·</span>
        <a href="https://github.com/yakovkhalinsky/eden-releases/releases">Releases</a>
      </nav>
    </div>
  </footer>

  <script is:inline>
    (function () {
      var btns = document.querySelectorAll('.copy-btn');
      btns.forEach(function (btn) {
        btn.addEventListener('click', function () {
          var text = btn.getAttribute('data-cmd');
          if (!text) return;
          if (navigator.clipboard) {
            navigator.clipboard.writeText(text).then(function () {
              var old = btn.innerHTML;
              btn.innerHTML = '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"></polyline></svg>';
              btn.setAttribute('aria-label', 'Copied');
              setTimeout(function () {
                btn.innerHTML = old;
                btn.setAttribute('aria-label', 'Copy command');
              }, 1400);
            });
          }
        });
      });
    })();
  </script>
</body>
</html>

<style>
  :root {
    --board: #0d1117;
    --panel: #161b22;
    --panel-raised: #21262d;
    --border: #30363d;
    --border-subtle: #21262d;
    --text: #c9d1d9;
    --text-muted: #8b949e;
    --text-dim: #6e7681;
    --alert: #f78166;
    --alert-soft: rgba(247, 129, 102, 0.12);
    --action: #58a6ff;
    --action-soft: rgba(88, 166, 255, 0.12);
    --ready: #3fb950;
    --restricted: #d29922;
    --blocked: #f85149;
    --radius-sm: 8px;
    --radius: 12px;
    --radius-lg: 16px;
    --max: 1100px;
    --display: Chakra Petch, Saira, -apple-system, BlinkMacSystemFont, sans-serif;
    --body: Saira, -apple-system, BlinkMacSystemFont, sans-serif;
    --mono: JetBrains Mono, ui-monospace, monospace;
  }

  *, *::before, *::after { box-sizing: border-box; }

  html, body {
    margin: 0;
    padding: 0;
    font-family: var(--body);
    color: var(--text);
    background: var(--board);
    line-height: 1.6;
    -webkit-font-smoothing: antialiased;
  }

  a {
    color: var(--action);
    text-decoration: none;
  }
  a:hover { text-decoration: underline; }

  code {
    font-family: var(--mono);
    font-size: 0.92em;
    background: var(--panel-raised);
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    padding: 2px 6px;
  }

  .wrap {
    max-width: var(--max);
    margin: 0 auto;
    padding: 0 24px;
  }

  /* Header */
  .site-header {
    border-bottom: 1px solid var(--border);
    background: var(--board);
    position: sticky;
    top: 0;
    z-index: 50;
  }

  .nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 60px;
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 10px;
    color: var(--text);
    font-weight: 700;
    font-size: 1.05rem;
  }
  .brand:hover { text-decoration: none; }

  .brand-mark {
    width: 28px;
    height: 28px;
    border-radius: var(--radius-sm);
    background: var(--alert);
    color: var(--board);
    display: grid;
    place-items: center;
    font-family: var(--mono);
    font-size: 0.85rem;
    font-weight: 700;
  }

  .nav-links {
    display: flex;
    gap: 22px;
    align-items: center;
    font-size: 0.88rem;
  }

  .nav-links a {
    color: var(--text-muted);
    font-weight: 500;
  }
  .nav-links a:hover { color: var(--text); text-decoration: none; }

  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    padding: 12px 20px;
    border-radius: var(--radius-sm);
    font-weight: 600;
    font-size: 0.92rem;
    border: 1px solid transparent;
    cursor: pointer;
    transition: background-color .12s ease, border-color .12s ease, color .12s ease;
    text-decoration: none;
    line-height: 1;
  }
  .btn:hover { text-decoration: none; }

  .btn-primary {
    background: var(--alert);
    color: var(--board);
  }
  .btn-primary:hover { background: #ff9a80; }

  .btn-secondary {
    background: transparent;
    border-color: var(--border);
    color: var(--text);
  }
  .btn-secondary:hover { border-color: var(--action); color: var(--action); }

  .btn-sm {
    padding: 8px 14px;
    font-size: 0.82rem;
    background: var(--panel-raised);
    border-color: var(--border);
    color: var(--text);
  }
  .btn-sm:hover { border-color: var(--alert); color: var(--alert); background: var(--panel-raised); }

  /* Status chips */
  .status-chip {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 4px 10px;
    border-radius: 999px;
    font-size: 0.72rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.03em;
    border: 1px solid transparent;
    white-space: nowrap;
  }

  .status-chip.ready {
    background: rgba(63, 185, 80, 0.12);
    color: var(--ready);
    border-color: rgba(63, 185, 80, 0.25);
  }

  .status-chip.restricted {
    background: rgba(210, 153, 34, 0.12);
    color: var(--restricted);
    border-color: rgba(210, 153, 34, 0.25);
  }

  .status-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: currentColor;
  }

  /* Hero */
  .hero {
    padding: 56px 0 40px;
    border-bottom: 1px solid var(--border-subtle);
  }

  .hero-wrap {
    max-width: 860px;
  }

  .production-meta {
    display: flex;
    gap: 14px;
    align-items: center;
    margin-bottom: 18px;
    flex-wrap: wrap;
  }

  .production-id {
    font-family: var(--mono);
    font-size: 0.78rem;
    color: var(--text-dim);
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  h1 {
    font-family: var(--display);
    font-size: clamp(2.6rem, 7vw, 4.8rem);
    line-height: 0.95;
    font-weight: 700;
    letter-spacing: -0.03em;
    margin: 0 0 16px;
    color: var(--text);
  }

  .lead {
    font-size: clamp(1.05rem, 1.8vw, 1.25rem);
    color: var(--text-muted);
    max-width: 680px;
    margin: 0 0 28px;
    line-height: 1.55;
  }

  .hero-actions {
    display: flex;
    gap: 14px;
    flex-wrap: wrap;
  }

  /* Call sheet */
  .call-sheet {
    padding: 40px 0 64px;
  }

  .sheet-head {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 18px;
    margin-bottom: 22px;
    flex-wrap: wrap;
  }

  .sheet-title-group h2 {
    font-family: var(--display);
    font-size: 1.6rem;
    font-weight: 700;
    margin: 0 0 4px;
    letter-spacing: -0.02em;
  }

  .sheet-subtitle {
    color: var(--text-muted);
    margin: 0;
    font-size: 0.95rem;
  }

  .sheet-body {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 18px;
  }

  .sheet-body-two-col .sheet-block-wide {
    grid-column: 1;
  }

  .sheet-body-two-col .sheet-block-right {
    grid-column: 2;
  }

  .sheet-block {
    background: var(--panel);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 20px;
    min-width: 0;
  }

  .block-label {
    font-family: var(--mono);
    font-size: 0.72rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--text-dim);
    margin-bottom: 16px;
    padding-bottom: 10px;
    border-bottom: 1px solid var(--border-subtle);
  }

  .step-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .step {
    display: flex;
    gap: 12px;
    align-items: flex-start;
  }

  .step-mark {
    flex-shrink: 0;
    width: 24px;
    height: 24px;
    border-radius: 50%;
    background: var(--panel-raised);
    border: 1px solid var(--border);
    display: grid;
    place-items: center;
    font-family: var(--mono);
    font-size: 0.7rem;
    font-weight: 700;
    color: var(--text-muted);
    margin-top: 2px;
  }

  .step-content {
    flex: 1;
    min-width: 0;
  }

  .step-row {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 8px;
    align-items: center;
    margin-bottom: 6px;
  }

  .cmd {
    flex: 1 1 auto;
    display: block;
    background: var(--board);
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    padding: 10px 12px;
    font-size: 0.82rem;
    color: var(--text);
    overflow-x: auto;
    white-space: pre-wrap;
    word-break: break-word;
    min-width: 0;
    max-width: 100%;
  }

  .cmd-inline {
    width: auto;
