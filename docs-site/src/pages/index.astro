---
// Minimal landing page for 0d3sa.com.
// This page replaces the default Starlight splash homepage for the root path only.

const mcpJsonConfig = `{
  "mcpServers": {
    "eden-memory": {
      "command": "eden-memory",
      "args": ["--db", "/home/yourname/.eden-memory/default.db"]
    }
  }
}`;
const mcpJsonConfigHtml = `<pre class="mono"><code id="mcp-json-config">${mcpJsonConfig.replace(/&/g, '&amp;').replace(/</g, '&lt;')}</code></pre>`;
---

<!DOCTYPE html>
<html lang="en" class="dark">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>0d3sa — local-first AI tools</title>
  <meta name="description" content="0d3sa publishes local-first AI tools and agent protocols." />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;700&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
</head>
<body>
  <header class="site-header">
    <div class="wrap nav">
      <a href="/" class="brand">
        <span class="brand-mark">0</span>
        <span>0d3sa — local-first AI tools</span>
      </a>
      <nav class="nav-links">
        <a href="#install">Install</a>
        <a href="https://github.com/yakovkhalinsky/eden-releases" target="_blank" rel="noreferrer">GitHub</a>
        <a href="/docs/" class="btn btn-primary">Docs</a>
      </nav>
    </div>
  </header>

  <main>
    <section class="hero">
      <div class="wrap">
        <div class="pill">
          <span class="dot"></span>
          <span>Open source · Apache-2.0 · macOS + Linux</span>
        </div>
        <h1>0d3sa</h1>
        <p class="lead">
          Local-first AI tools and agent protocols.
        </p>

        <div class="terminal-hero">
          <div class="terminal-head">
            <span class="dot dot-red"></span>
            <span class="dot dot-yellow"></span>
            <span class="dot dot-green"></span>
          </div>
          <div class="terminal-body mono" id="terminal-commands">
            <div class="terminal-step">
              <span class="step-label">Step 1 — required base</span>
              <div class="line">
                <span class="prompt">$ </span>
                <span class="cmd">curl -fsSL https://0d3sa.com/eden-memory/install.sh | sh</span>
              </div>
              <span class="comment">Install eden-memory, the local-first memory server.</span>
            </div>
            <div class="terminal-step">
              <span class="step-label">Step 2 — optional add-on</span>
              <div class="line">
                <span class="prompt">$ </span>
                <span class="cmd">curl -fsSL https://0d3sa.com/agentic-team-protocol/install.sh | sh</span>
              </div>
              <span class="comment">Add the Agentic Team Protocol inside Claude Code.</span>
            </div>
          </div>
          <div class="copy-row">
            <span class="mono hint">ATP requires eden-memory on your PATH.</span>
            <div class="copy-row-btns">
              <button class="copy-btn" data-cmd="curl -fsSL https://0d3sa.com/eden-memory/install.sh | sh">Copy step 1</button>
              <button class="copy-btn" data-cmd="curl -fsSL https://0d3sa.com/agentic-team-protocol/install.sh | sh">Copy step 2</button>
              <button class="copy-btn" data-target="terminal-commands">Copy both</button>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="section" id="install">
      <div class="wrap">
        <h2>Get started</h2>
        <div class="steps">
          <div class="step">
            <div class="step-num">1</div>
            <div class="step-body">
              <h3>Install the binary</h3>
              <p>The installer downloads the latest release for your platform, verifies the checksum, and places it in your PATH.</p>
              <code class="mono">curl -fsSL https://0d3sa.com/eden-memory/install.sh | sh</code>
            </div>
          </div>

          <div class="step">
            <div class="step-num">2</div>
            <div class="step-body">
              <h3>Check version and health</h3>
              <p>Confirm the binary is on your PATH and can open its SQLite database.</p>
              <code class="mono">eden-memory version</code>
              <code class="mono">eden-memory health</code>
            </div>
          </div>

          <div class="step">
            <div class="step-num">3</div>
            <div class="step-body">
              <h3>Wire your client</h3>
              <p>Pick the client you use. Restart it after adding the server.</p>
              <div class="client-grid">
                <a href="/eden-memory/skills/eden-memory-claude/" class="client client-link">
                  <span class="client-name">◈ Claude Code</span>
                  <span class="client-hint">See setup →</span>
                </a>
                <a href="/eden-memory/skills/eden-memory-cursor/" class="client client-link">
                  <span class="client-name">✦ Cursor</span>
                  <span class="client-hint">See setup →</span>
                </a>
              </div>
              <p class="client-hint" style="margin-top:14px">For any other MCP client, use this server command:</p>
              <code class="mono">eden-memory --db /home/yourname/.eden-memory/default.db</code>
              <p class="client-hint" style="margin-top:10px">Or this JSON shape:</p>
              <div class="code-block">
                <Fragment set:html={mcpJsonConfigHtml} />
                <button class="copy-btn" data-target="mcp-json-config">Copy</button>
              </div>
            </div>
          </div>

          <div class="step">
            <div class="step-num">4</div>
            <div class="step-body">
              <h3>Verify it works</h3>
              <p>Tell the agent to remember something, then start a new session and ask it back.</p>
              <code class="mono">Remember that I prefer Python examples and short sentences.</code>
              <code class="mono">What do you know about my communication preferences?</code>
            </div>
          </div>

          <div class="step">
            <div class="step-num">5</div>
            <div class="step-body">
              <h3>Add the Agentic Team Protocol</h3>
              <p>This step is only for Claude Code. It installs the global slash commands and agent prompts.</p>
              <code class="mono">curl -fsSL https://0d3sa.com/agentic-team-protocol/install.sh | sh</code>
            </div>
          </div>

          <div class="step">
            <div class="step-num">6</div>
            <div class="step-body">
              <h3>Restart Claude Code</h3>
              <p>Exit the current session and reopen it so the protocol commands register in every workspace.</p>
              <code class="mono">/exit</code>
              <p class="client-hint" style="margin-top:10px">Then reopen Claude Code in your project directory.</p>
            </div>
          </div>

          <div class="step">
            <div class="step-num">7</div>
            <div class="step-body">
              <h3>Ratify your team charter</h3>
              <p>Run the charter command to create a durable ratification record in eden-memory. Then optionally check team status.</p>
              <code class="mono">/team-charter</code>
              <code class="mono">/team-status</code>
              <p class="client-hint" style="margin-top:10px">Read the <a href="/agentic-team-protocol/getting-started/">getting started</a> guide and <a href="/agentic-team-protocol/charter-anatomy/">charter anatomy</a> for the full setup.</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="section section-alt">
      <div class="wrap">
        <div class="feature-split">
          <div class="feature-copy">
            <h2>What it does</h2>
            <p>eden-memory stores facts and context your agents collect in a local SQLite database. Each memory gets a 256-dimensional embedding. When your agent asks a question, eden-memory runs cosine-similarity search over the vectors and returns the most relevant results. Keyword search is also available. Everything stays on your machine.</p>
            <ul class="checklist">
              <li>One static binary with embedded Python runtime and model weights</li>
              <li>MCP server over stdio — works with any client</li>
              <li>Semantic and keyword search over memories</li>
              <li>Everything stored in <code class="mono">~/.eden-memory/default.db</code></li>
            </ul>
          </div>
          <div class="art-frame">
            <img src="/assets/hero-device.jpg" alt="A small local device on a desk, representing local-first agent memory" />
          </div>
        </div>
      </div>
    </section>

    <section class="section section-alt">
      <div class="wrap feature-single">
        <div class="feature-copy">
          <h2>What the protocol does</h2>
          <p>agentic-team-protocol runs structured agent teams inside Claude Code. It assigns a role to each stage of a goal, stores every milestone in eden-memory, and keeps a mandatory Verifier gate before anything is closed.</p>
          <ul class="checklist">
            <li>Durable goal, dispatch, context, action, verdict, and archival records</li>
            <li>Six default roles: Dispatcher, Researcher, Builder, Verifier, Archivist, Runtime</li>
            <li>Seven-stage lifecycle from goal receipt to hand-off or closure</li>
            <li>Built on eden-memory — everything stays on your machine</li>
          </ul>
        </div>
      </div>
    </section>

    <section class="section products-section">
      <div class="wrap">
        <h2 class="section-title">Products on <strong>0d3sa</strong></h2>
        <div class="product-grid">
          <a href="/eden-memory/" class="product-card">
            <div class="product-meta">
              <span class="product-tag">MCP memory server</span>
            </div>
            <h3>eden-memory</h3>
            <p>Local-first memory layer for AI agents. Install one binary and wire it to any MCP client.</p>
            <span class="product-link">Read docs →</span>
          </a>
          <a href="/agentic-team-protocol/" class="product-card">
            <div class="product-meta">
              <span class="product-tag">Claude Code team workflow</span>
            </div>
            <h3>agentic-team-protocol</h3>
            <p>Role-based agent teams with a seven-stage lifecycle and eden-memory as the durable substrate.</p>
            <ul class="role-list">
              <li><strong>Roles:</strong> Dispatcher, Researcher, Builder, Verifier, Archivist, Runtime</li>
              <li><strong>Lifecycle:</strong> goal receipt → routing → context → action → verification → archival → closure</li>
            </ul>
            <span class="product-link">Read docs →</span>
          </a>
        </div>
      </div>
    </section>

    <section class="section section-alt" id="which-one">
      <div class="wrap">
        <div class="section-title-with-link">
          <h2 class="section-title">Which one do I need?</h2>
          <a href="#which-one" class="anchor-link" aria-label="Link to Which one do I need?">#</a>
        </div>
        <div class="decision-grid">
          <div class="decision-card">
            <h3>Just want memory?</h3>
            <p>Use <a href="/eden-memory/">eden-memory</a>. One binary, any MCP client, and every memory stays on your machine.</p>
          </div>
          <div class="decision-card">
            <h3>Want a team workflow?</h3>
            <p>Use <a href="/agentic-team-protocol/">agentic-team-protocol</a>. It runs on top of eden-memory and adds Dispatcher, Researcher, Builder, Verifier, Archivist, and Runtime roles inside Claude Code.</p>
          </div>
          <div class="decision-card decision-answer">
            <h3>Short answer</h3>
            <p>Install eden-memory first. If you work in Claude Code and want structured role-based collaboration, add the protocol.</p>
          </div>
        </div>
      </div>
    </section>
  </main>

  <footer class="site-footer">
    <div class="wrap footer-row">
      <span>© 2026 0d3sa. Open source under Apache-2.0.</span>
      <span class="footer-links">
        <a href="https://github.com/yakovkhalinsky/eden-releases">GitHub</a>
        <span class="sep">·</span>
        <a href="/docs/">Docs</a>
        <span class="sep">·</span>
        <a href="https://github.com/yakovkhalinsky/eden-releases/releases">Releases</a>
      </span>
    </div>
  </footer>

  <script is:inline>
    (function () {
      function getCopyText(btn) {
        var cmd = btn.getAttribute('data-cmd');
        if (cmd) return cmd;
        var targetId = btn.getAttribute('data-target');
        if (!targetId) return '';
        var target = document.getElementById(targetId);
        if (!target) return '';
        var lines = target.querySelectorAll('.line');
        if (lines.length > 0) {
          return Array.from(lines).map(function (line) {
            return line.textContent.trim();
          }).join('\n');
        }
        return target.textContent
          .replace(/^\n+|\n+$/g, '')
          .replace(/\n{2,}/g, '\n')
          .trim();
      }
      var btns = document.querySelectorAll('.copy-btn');
      btns.forEach(function (btn) {
        btn.addEventListener('click', function () {
          var text = getCopyText(btn);
          if (!text) return;
          if (navigator.clipboard) {
            navigator.clipboard.writeText(text).then(function () {
              var old = btn.textContent;
              btn.textContent = 'Copied';
              setTimeout(function () { btn.textContent = old; }, 1200);
            });
          }
        });
      });
    })();
  </script>
</body>
</html>

<style>
  :root {
    --bg: #0b0d10;
    --bg-elevated: #11141a;
    --bg-card: #151922;
    --bg-warm: #18141a;
    --text: #f0f2f6;
    --text-muted: #8b94a7;
    --border: #232834;
    --accent: #2d6a4f;
    --accent-600: #40916c;
    --accent-glow: rgba(45, 106, 79, 0.18);
    --amber: #f2b65a;
    --amber-soft: rgba(242, 182, 90, 0.12);
    --green: #5df0a8;
    --radius: 14px;
    --max: 960px;
  }

  html, body {
    margin: 0;
    padding: 0;
    font-family: Inter, -apple-system, BlinkMacSystemFont, sans-serif;
    color: var(--text);
    background: var(--bg);
    line-height: 1.6;
    -webkit-font-smoothing: antialiased;
  }

  .mono { font-family: JetBrains Mono, ui-monospace, monospace; }

  a { color: var(--accent); text-decoration: none; }
  a:hover { text-decoration: underline; }

  .wrap {
    max-width: var(--max);
    margin: 0 auto;
    padding: 0 24px;
  }

  .site-header {
    border-bottom: 1px solid var(--border);
    background: var(--bg);
  }

  .nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 64px;
  }

  .brand {
    font-weight: 700;
    font-size: 1.1rem;
    display: flex;
    align-items: center;
    gap: 10px;
    color: var(--text);
  }

  .brand-mark {
    width: 28px;
    height: 28px;
    border-radius: 8px;
    background: var(--accent);
    color: var(--bg);
    display: grid;
    place-items: center;
    font-family: JetBrains Mono, monospace;
    font-size: 0.85rem;
    font-weight: 700;
  }

  .nav-links {
    display: flex;
    gap: 24px;
    align-items: center;
    font-size: 0.88rem;
  }

  .nav-links a { color: var(--text-muted); font-weight: 500; }
  .nav-links a:hover { color: var(--text); }

  .btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 10px 18px;
    border-radius: 10px;
    font-weight: 600;
    font-size: 0.88rem;
    border: 1px solid transparent;
    cursor: pointer;
    transition: all .12s ease;
    text-decoration: none;
  }

  .btn-primary { background: var(--accent); color: var(--text); }
  .btn-primary:hover { background: var(--accent-600); text-decoration: none; }

  .hero { padding: 64px 0 48px; text-align: center; }

  .pill {
    display: inline-flex;
    gap: 8px;
    align-items: center;
    padding: 6px 14px;
    border-radius: 999px;
    background: var(--bg-elevated);
    border: 1px solid var(--border);
    color: var(--text-muted);
    font-size: 0.76rem;
    font-weight: 700;
    margin-bottom: 20px;
  }

  .pill .dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--green);
  }

  h1 {
    font-family: Inter, sans-serif;
    font-size: clamp(3rem, 7vw, 5rem);
    line-height: 1.05;
    font-weight: 800;
    letter-spacing: -0.03em;
    margin-bottom: 8px;
  }

  .product-label {
    color: var(--text-muted);
    font-size: 0.85rem;
    font-weight: 600;
    margin-bottom: 8px;
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .lead {
    font-size: clamp(1rem, 1.6vw, 1.15rem);
    color: var(--text-muted);
    max-width: 620px;
    margin: 0 auto 32px;
  }

  .terminal-hero {
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    overflow: hidden;
    box-shadow: 0 0 60px var(--accent-glow);
    max-width: 700px;
    margin: 0 auto;
    text-align: left;
  }

  .terminal-head {
    background: var(--bg-elevated);
    padding: 12px 16px;
    display: flex;
    gap: 8px;
  }

  .dot { width: 12px; height: 12px; border-radius: 50%; }
  .dot-red { background: #ff5f57; }
  .dot-yellow { background: #febc2e; }
  .dot-green { background: #28c840; }

  .terminal-body {
    padding: 20px 24px;
    font-size: 0.92rem;
    line-height: 1.85;
  }

  .line { display: flex; gap: 10px; }
  .prompt { color: var(--green); white-space: nowrap; }
  .cmd { color: var(--text); }
  .comment { color: var(--text-muted); }

  .copy-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 12px 16px;
    border-top: 1px solid var(--border);
    background: var(--bg-elevated);
  }

  .copy-row .hint {
    color: var(--text-muted);
    font-size: 0.84rem;
  }

  .copy-btn {
    background: var(--bg-card);
    border: 1px solid var(--text-muted);
    color: var(--text);
    padding: 7px 14px;
    border-radius: 8px;
    font-size: 0.8rem;
    cursor: pointer;
    font-weight: 700;
    font-family: Inter, sans-serif;
  }

  .copy-btn:hover { background: var(--accent-600); color: var(--text); border-color: var(--accent); }

  .section { padding: 64px 0; }
  .section-alt { background: var(--bg-warm); }

  .steps {
    display: flex;
    flex-direction: column;
    gap: 18px;
    max-width: 760px;
    margin: 0 auto;
  }

  .step {
    display: grid;
    grid-template-columns: 40px 1fr;
    gap: 18px;
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 22px;
  }

  .step-num {
    width: 40px;
    height: 40px;
    border-radius: 10px;
    background: var(--bg-elevated);
    border: 1px solid var(--border);
    display: grid;
    place-items: center;
    color: var(--accent);
    font-weight: 700;
    font-size: 1rem;
  }

  .step-body p {
    color: var(--text-muted);
    font-size: 0.94rem;
    margin-bottom: 12px;
  }

  .step-body code {
    display: inline-block;
    background: var(--bg-elevated);
    border: 1px solid var(--border);
    border-radius: 10px;
    padding: 12px 14px;
    font-size: 0.82rem;
    color: var(--text);
    overflow-x: auto;
    max-width: 100%;
    white-space: nowrap;
  }

  .client-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 12px;
  }

  .client {
    background: var(--bg-elevated);
    border: 1px solid var(--border);
    border-radius: 10px;
    padding: 14px;
    display: flex;
    flex-direction: column;
    gap: 6px;
    text-decoration: none;
  }

  .client-link:hover {
    border-color: var(--accent);
  }

  .client-name {
    display: block;
    font-weight: 600;
    font-size: 0.9rem;
    color: var(--text);
  }

  .client code {
    display: block;
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 10px;
    font-size: 0.75rem;
    color: var(--text-muted);
    overflow-x: auto;
    white-space: nowrap;
  }

  .client-hint {
    color: var(--text-muted);
    font-size: 0.85rem;
    line-height: 1.5;
  }

  .feature-split {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: 40px;
    align-items: center;
  }
  .feature-copy h2 { font-size: 1.7rem; margin-bottom: 12px; }
  .feature-copy h3 { font-size: 1rem; font-weight: 600; margin-bottom: 6px; }
  .feature-copy p { color: var(--text-muted); margin-bottom: 16px; }

  .products-section { background: var(--bg-elevated); border-top: 1px solid var(--border); }
  .section-title {
    text-align: center;
    font-size: 1.3rem;
    margin-bottom: 28px;
  }
  .section-title strong { color: var(--text); }

  .product-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 18px;
    max-width: 640px;
    margin: 0 auto;
  }

  .product-card {
    display: flex;
    flex-direction: column;
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 22px;
    color: var(--text);
  }
  .product-card:hover {
    border-color: var(--accent);
    text-decoration: none;
  }

  .product-meta { margin-bottom: 10px; }
  .product-tag {
    display: inline-block;
    padding: 4px 10px;
    border-radius: 999px;
    background: var(--amber-soft);
    color: var(--amber);
    font-size: 0.72rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .product-card h3 {
    font-size: 1.15rem;
    font-weight: 700;
    margin-bottom: 8px;
  }
  .product-card p {
    color: var(--text-muted);
    font-size: 0.92rem;
    margin-bottom: 14px;
  }
  .product-link {
    color: var(--accent);
    font-size: 0.9rem;
    font-weight: 600;
    margin-top: auto;
  }

  .decision-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 18px;
    max-width: 860px;
    margin: 0 auto;
  }

  .decision-card {
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 22px;
  }

  .decision-card h3 {
    font-size: 1rem;
    font-weight: 700;
    margin-bottom: 8px;
  }

  .decision-card p {
    color: var(--text-muted);
    font-size: 0.92rem;
    margin: 0;
  }

  .decision-answer {
    border-color: var(--accent);
    box-shadow: 0 0 0 1px var(--accent) inset;
  }

  .section-title-with-link {
    display: flex;
    align-items: center;
    justify-content: center;
