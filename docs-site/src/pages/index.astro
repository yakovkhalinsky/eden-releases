---
// Landing page for 0d3sa.com.
// Short, product-focused entry point. Detailed install steps live in Starlight docs.

const installCmd = 'curl -fsSL https://0d3sa.com/eden-memory/install.sh | sh';
---

<!DOCTYPE html>
<html lang="en" class="dark">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>0d3sa — local-first AI tools</title>
  <meta name="description" content="Local-first memory and agent-team protocols for AI agents. One binary, any MCP client, everything on your machine." />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;700&family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
</head>
<body>
  <header class="site-header">
    <div class="wrap nav">
      <a href="/" class="brand">
        <span class="brand-mark">0</span>
        <span>0d3sa</span>
      </a>
      <nav class="nav-links">
        <a href="/docs/">Docs</a>
        <a href="https://github.com/yakovkhalinsky/eden-releases" target="_blank" rel="noreferrer">GitHub</a>
        <a href="/eden-memory/reference/downloads/" class="btn btn-primary">Download</a>
      </nav>
    </div>
  </header>

  <main>
    <section class="hero">
      <div class="wrap">
        <div class="pill">
          <span class="dot"></span>
          <span>Open source · Apache-2.0 · macOS + Linux</span>
        </div>
        <h1>Local-first memory for AI agents</h1>
        <p class="lead">
          eden-memory stores facts, preferences, and context in a local SQLite database with vector search. Add the Agentic Team Protocol on top for structured role-based collaboration inside Claude Code.
        </p>
        <div class="hero-actions">
          <a href="/eden-memory/getting-started/" class="btn btn-primary btn-lg">Get started</a>
          <a href="/docs/" class="btn btn-secondary btn-lg">Read the docs</a>
        </div>
      </div>
    </section>

    <section class="section install-section">
      <div class="wrap">
        <div class="install-card">
          <div class="install-head">
            <div>
              <span class="install-label">Install the base binary</span>
              <p class="install-hint">One command. No Python or package manager required.</p>
            </div>
            <button class="copy-btn" data-cmd={installCmd}>Copy</button>
          </div>
          <code class="mono install-cmd">{installCmd}</code>
          <p class="install-more">
            Also available: <a href="/eden-memory/reference/downloads/">eden-relay</a> and <a href="/eden-memory/reference/downloads/">eden-team</a>.
          </p>
        </div>
      </div>
    </section>

    <section class="section products-section">
      <div class="wrap">
        <h2 class="section-title">Choose a product</h2>
        <div class="product-grid">
          <a href="/eden-memory/" class="product-card">
            <div class="product-meta">
              <span class="product-tag">MCP memory server</span>
            </div>
            <h3>eden-memory</h3>
            <p>Local-first memory layer for AI agents. One static binary with an embedded Python runtime and model weights. Works with any stdio MCP client.</p>
            <ul class="feature-list">
              <li>SQLite + 256-dim vector embeddings</li>
              <li>Semantic and keyword search</li>
              <li>Optional encrypted multi-device sync</li>
            </ul>
            <span class="product-link">Read docs →</span>
          </a>

          <a href="/agentic-team-protocol/" class="product-card">
            <div class="product-meta">
              <span class="product-tag">Claude Code team workflow</span>
            </div>
            <h3>agentic-team-protocol</h3>
            <p>Role-based agent teams with a seven-stage lifecycle and eden-memory as the durable substrate.</p>
            <ul class="feature-list">
              <li>Dispatcher, Researcher, Builder, Verifier, Archivist, Runtime</li>
              <li>Mandatory Verifier gate before closure</li>
              <li>Resumable goals across sessions</li>
            </ul>
            <span class="product-link">Read docs →</span>
          </a>
        </div>
      </div>
    </section>

    <section class="section section-alt">
      <div class="wrap">
        <h2 class="section-title">Three binaries, one release</h2>
        <p class="section-lead">Each release ships three single-file Go binaries. Pick the one that matches the job.</p>
        <div class="binary-grid">
          <div class="binary-card">
            <div class="binary-icon">M</div>
            <div class="binary-body">
              <h3>eden-memory</h3>
              <p>The full CLI: MCP server, memory tools, sync, pairing, and the legacy relay-server subcommand.</p>
            </div>
          </div>
          <div class="binary-card">
            <div class="binary-icon">R</div>
            <div class="binary-body">
              <h3>eden-relay</h3>
              <p>A dedicated, lightweight relay server for multi-device sync. No MCP or memory subcommands.</p>
            </div>
          </div>
          <div class="binary-card">
            <div class="binary-icon">T</div>
            <div class="binary-body">
              <h3>eden-team</h3>
              <p>Headless ATP supervisor for CI, cron, or automated agent-team workflows.</p>
            </div>
          </div>
        </div>
        <div class="downloads-cta">
          <a href="/eden-memory/reference/downloads/" class="btn btn-secondary">See downloads and checksums →</a>
        </div>
      </div>
    </section>

    <section class="section" id="which-one">
      <div class="wrap">
        <div class="section-title-with-link">
          <h2 class="section-title">Which one do I need?</h2>
          <a href="#which-one" class="anchor-link" aria-label="Link to Which one do I need?">#</a>
        </div>
        <div class="decision-grid">
          <div class="decision-card">
            <h3>Just want memory?</h3>
            <p>Install <a href="/eden-memory/">eden-memory</a>. One binary, any MCP client, and every memory stays on your machine.</p>
          </div>
          <div class="decision-card">
            <h3>Want a team workflow?</h3>
            <p>Add <a href="/agentic-team-protocol/">agentic-team-protocol</a>. It runs on top of eden-memory and adds structured role-based collaboration inside Claude Code.</p>
          </div>
          <div class="decision-card decision-answer">
            <h3>Short answer</h3>
            <p>Install eden-memory first. If you work in Claude Code and want structured team workflows, add the protocol.</p>
          </div>
        </div>
      </div>
    </section>
  </main>

  <footer class="site-footer">
    <div class="wrap footer-row">
      <span>© 2026 0d3sa. Open source under Apache-2.0.</span>
      <span class="footer-links">
        <a href="https://github.com/yakovkhalinsky/eden-releases">GitHub</a>
        <span class="sep">·</span>
        <a href="/docs/">Docs</a>
        <span class="sep">·</span>
        <a href="/eden-memory/reference/downloads/">Downloads</a>
        <span class="sep">·</span>
        <a href="https://github.com/yakovkhalinsky/eden-releases/releases">Releases</a>
      </span>
    </div>
  </footer>

  <script is:inline>
    (function () {
      var btns = document.querySelectorAll('.copy-btn');
      btns.forEach(function (btn) {
        btn.addEventListener('click', function () {
          var text = btn.getAttribute('data-cmd');
          if (!text) return;
          if (navigator.clipboard) {
            navigator.clipboard.writeText(text).then(function () {
              var old = btn.textContent;
              btn.textContent = 'Copied';
              setTimeout(function () { btn.textContent = old; }, 1200);
            });
          }
        });
      });
    })();
  </script>
</body>
</html>

<style>
  :root {
    --bg: #0b0d10;
    --bg-elevated: #11141a;
    --bg-card: #151922;
    --bg-warm: #18141a;
    --text: #f0f2f6;
    --text-muted: #8b94a7;
    --border: #232834;
    --accent: #2d6a4f;
    --accent-600: #40916c;
    --accent-glow: rgba(45, 106, 79, 0.18);
    --amber: #f2b65a;
    --amber-soft: rgba(242, 182, 90, 0.12);
    --green: #5df0a8;
    --radius: 14px;
    --max: 980px;
  }

  html, body {
    margin: 0;
    padding: 0;
    font-family: Inter, -apple-system, BlinkMacSystemFont, sans-serif;
    color: var(--text);
    background: var(--bg);
    line-height: 1.6;
    -webkit-font-smoothing: antialiased;
  }

  .mono { font-family: JetBrains Mono, ui-monospace, monospace; }

  a { color: var(--accent); text-decoration: none; }
  a:hover { text-decoration: underline; }

  .wrap {
    max-width: var(--max);
    margin: 0 auto;
    padding: 0 24px;
  }

  .site-header {
    border-bottom: 1px solid var(--border);
    background: var(--bg);
  }

  .nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 64px;
  }

  .brand {
    font-weight: 800;
    font-size: 1.15rem;
    display: flex;
    align-items: center;
    gap: 10px;
    color: var(--text);
  }

  .brand-mark {
    width: 28px;
    height: 28px;
    border-radius: 8px;
    background: var(--accent);
    color: var(--bg);
    display: grid;
    place-items: center;
    font-family: JetBrains Mono, monospace;
    font-size: 0.85rem;
    font-weight: 700;
  }

  .nav-links {
    display: flex;
    gap: 22px;
    align-items: center;
    font-size: 0.88rem;
  }

  .nav-links a { color: var(--text-muted); font-weight: 500; }
  .nav-links a:hover { color: var(--text); text-decoration: none; }

  .btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 10px 18px;
    border-radius: 10px;
    font-weight: 600;
    font-size: 0.88rem;
    border: 1px solid transparent;
    cursor: pointer;
    transition: all .12s ease;
    text-decoration: none;
  }

  .btn-primary { background: var(--accent); color: var(--text); }
  .btn-primary:hover { background: var(--accent-600); text-decoration: none; }

  .btn-secondary {
    background: transparent;
    border-color: var(--border);
    color: var(--text);
  }
  .btn-secondary:hover { border-color: var(--accent); color: var(--accent); text-decoration: none; }

  .btn-lg { padding: 14px 24px; font-size: 1rem; }

  .hero { padding: 72px 0 48px; text-align: center; }

  .pill {
    display: inline-flex;
    gap: 8px;
    align-items: center;
    padding: 6px 14px;
    border-radius: 999px;
    background: var(--bg-elevated);
    border: 1px solid var(--border);
    color: var(--text-muted);
    font-size: 0.76rem;
    font-weight: 700;
    margin-bottom: 20px;
  }

  .pill .dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--green);
  }

  h1 {
    font-family: Inter, sans-serif;
    font-size: clamp(2.6rem, 6vw, 4.2rem);
    line-height: 1.08;
    font-weight: 800;
    letter-spacing: -0.03em;
    margin: 0 0 12px;
  }

  .lead {
    font-size: clamp(1.05rem, 1.8vw, 1.25rem);
    color: var(--text-muted);
    max-width: 680px;
    margin: 0 auto 28px;
  }

  .hero-actions {
    display: flex;
    gap: 14px;
    justify-content: center;
    flex-wrap: wrap;
  }

  .section { padding: 64px 0; }
  .section-alt { background: var(--bg-warm); }

  .install-section { padding-top: 24px; }

  .install-card {
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 22px;
    max-width: 760px;
    margin: 0 auto;
    box-shadow: 0 0 60px var(--accent-glow);
  }

  .install-head {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 16px;
    margin-bottom: 14px;
    flex-wrap: wrap;
  }

  .install-label {
    display: block;
    font-weight: 700;
    font-size: 1rem;
    margin-bottom: 4px;
  }

  .install-hint {
    color: var(--text-muted);
    font-size: 0.88rem;
    margin: 0;
  }

  .install-cmd {
    display: block;
    background: var(--bg-elevated);
    border: 1px solid var(--border);
    border-radius: 10px;
    padding: 14px 16px;
    font-size: 0.9rem;
    color: var(--text);
    overflow-x: auto;
    white-space: nowrap;
    margin-bottom: 14px;
  }

  .install-more {
    color: var(--text-muted);
    font-size: 0.88rem;
    margin: 0;
  }

  .copy-btn {
    background: var(--bg-elevated);
    border: 1px solid var(--text-muted);
    color: var(--text);
    padding: 8px 14px;
    border-radius: 8px;
    font-size: 0.8rem;
    cursor: pointer;
    font-weight: 700;
    font-family: Inter, sans-serif;
  }
  .copy-btn:hover { background: var(--accent-600); color: var(--text); border-color: var(--accent); }

  .section-title {
    text-align: center;
    font-size: 1.4rem;
    margin-bottom: 10px;
  }

  .section-lead {
    text-align: center;
    color: var(--text-muted);
    max-width: 560px;
    margin: 0 auto 28px;
  }

  .products-section { background: var(--bg-elevated); border-top: 1px solid var(--border); }

  .product-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: 18px;
    max-width: 820px;
    margin: 0 auto;
  }

  .product-card {
    display: flex;
    flex-direction: column;
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 24px;
    color: var(--text);
  }
  .product-card:hover {
    border-color: var(--accent);
    text-decoration: none;
  }

  .product-meta { margin-bottom: 10px; }
  .product-tag {
    display: inline-block;
    padding: 4px 10px;
    border-radius: 999px;
    background: var(--amber-soft);
    color: var(--amber);
    font-size: 0.72rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .product-card h3 {
    font-size: 1.3rem;
    font-weight: 700;
    margin-bottom: 10px;
  }
  .product-card p {
    color: var(--text-muted);
    font-size: 0.95rem;
    margin-bottom: 16px;
  }

  .feature-list {
    list-style: none;
    padding: 0;
    margin: 0 0 18px;
  }
  .feature-list li {
    display: flex;
    gap: 10px;
    align-items: baseline;
    color: var(--text-muted);
    font-size: 0.9rem;
    margin-bottom: 8px;
  }
  .feature-list li::before {
    content: "✓";
    color: var(--green);
    font-weight: 700;
  }

  .product-link {
    color: var(--accent);
    font-size: 0.95rem;
    font-weight: 600;
    margin-top: auto;
  }

  .binary-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
    max-width: 860px;
    margin: 0 auto 24px;
  }

  .binary-card {
    display: flex;
    gap: 16px;
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 20px;
  }

  .binary-icon {
    flex-shrink: 0;
    width: 44px;
    height: 44px;
    border-radius: 10px;
    background: var(--bg-elevated);
    border: 1px solid var(--border);
    display: grid;
    place-items: center;
    font-family: JetBrains Mono, monospace;
    font-weight: 700;
    color: var(--accent);
    font-size: 1.1rem;
  }

  .binary-body h3 {
    font-size: 1.05rem;
    font-weight: 700;
    margin-bottom: 6px;
  }
  .binary-body p {
    color: var(--text-muted);
    font-size: 0.88rem;
    margin: 0;
  }

  .downloads-cta {
    text-align: center;
  }

  .decision-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 18px;
    max-width: 900px;
    margin: 0 auto;
  }

  .decision-card {
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 22px;
  }

  .decision-card h3 {
    font-size: 1rem;
    font-weight: 700;
    margin-bottom: 8px;
  }

  .decision-card p {
    color: var(--text-muted);
    font-size: 0.92rem;
    margin: 0;
  }

  .decision-answer {
    border-color: var(--accent);
    box-shadow: 0 0 0 1px var(--accent) inset;
  }

  .section-title-with-link {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    margin-bottom: 28px;
  }

  .section-title-with-link .section-title {
    margin: 0;
  }

  .anchor-link {
    color: var(--text-muted);
    font-size: 1.1rem;
    font-weight: 700;
    text-decoration: none;
    opacity: 0.6;
  }
  .anchor-link:hover { color: var(--accent); opacity: 1; }

  .site-footer {
    border-top: 1px solid var(--border);
    padding: 32px 0;
    color: var(--text-muted);
    font-size: 0.84rem;
    background: var(--bg);
  }

  .footer-row {
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 14px;
  }

  .footer-links .sep { margin: 0 6px; color: var(--text-muted); }

  @media (max-width: 800px) {
    .binary-grid { grid-template-columns: 1fr; }
    .decision-grid { grid-template-columns: 1fr; }
    .product-grid { grid-template-columns: 1fr; }
    .hero { padding: 56px 0 40px; }
    .section { padding: 48px 0; }
    .hero-actions { flex-direction: column; align-items: stretch; }
    .hero-actions .btn { justify-content: center; }
  }
</style>
