---
// Landing page for 0d3sa.com.
// Conversion-focused: hero, install steps, product split, binaries, decision map.

const atpCard = {
  tag: 'Agent teams',
  name: 'Agentic Team Protocol',
  desc: 'Role-based agent teams inside Claude Code. Dispatcher, Researcher, Builder, Verifier, Archivist, and Runtime follow a seven-stage lifecycle with durable memory records.',
  href: '/agentic-team-protocol/',
  links: [
    { label: 'Quick start', href: '/agentic-team-protocol/getting-started/' },
    { label: 'Lifecycle', href: '/agentic-team-protocol/lifecycle/' },
    { label: 'Agents', href: '/agentic-team-protocol/agents/' },
  ],
};

const memoryCard = {
  tag: 'Memory & sync',
  name: 'eden-memory',
  desc: 'Local-first SQLite memory with vector embeddings, an MCP server, and encrypted multi-device sync through a self-hosted relay.',
  href: '/eden-memory/',
  links: [
    { label: 'Quick start', href: '/eden-memory/getting-started/' },
    { label: 'Tools', href: '/eden-memory/reference/tools/' },
    { label: 'Dreaming', href: '/eden-memory/concepts/dreaming/' },
  ],
};

const binaries = [
  { name: 'eden-memory', role: 'Memory, MCP server, sync, and device pairing', href: '/eden-memory/', size: '~66–107 MB' },
  { name: 'eden-relay', role: 'Self-hosted relay for encrypted multi-device sync', href: '/eden-relay/', size: '~10–11 MB' },
  { name: 'eden-team', role: 'Headless ATP supervisor for CI and automation', href: '/eden-team/', size: '~10–11 MB' },
];

const atpInstall = 'curl -fsSL https://0d3sa.com/agentic-team-protocol/install.sh | sh';
const memoryInstall = 'curl -fsSL https://0d3sa.com/eden-memory/install.sh | sh';
const setupCmd = 'cd ~/my-project && eden-memory setup claude';
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>0d3sa — Local-first agent infrastructure</title>
  <meta name="description" content="Agentic Team Protocol and eden-memory: local-first, role-based agent teams with durable SQLite memory and encrypted multi-device sync." />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Chakra+Petch:wght@400;500;700&family=Saira:wght@400;500;700&family=JetBrains+Mono:wght@400;500;700&display=swap" rel="stylesheet" />
</head>
<body>
  <header class="site-header">
    <div class="wrap nav">
      <a href="/" class="brand" aria-label="0d3sa home">
        <img src="/images/brand-mark.svg" alt="" class="brand-mark" width="32" height="32" aria-hidden="true" />
        <span class="brand-name">0d3sa</span>
      </a>
      <nav class="nav-links" aria-label="Primary">
        <a href="/docs/">Docs</a>
        <a href="https://github.com/yakovkhalinsky/eden-releases" target="_blank" rel="noreferrer">GitHub</a>
        <a href="/eden-memory/reference/downloads/" class="btn btn-sm">Downloads</a>
      </nav>
    </div>
  </header>

  <main>
    <section class="hero" aria-labelledby="hero-title">
      <div class="wrap hero-wrap">
        <div class="hero-text">
          <div class="product-meta">
            <span class="status-chip ready"><span class="status-dot" aria-hidden="true"></span>Production ready</span>
            <span class="call-sheet-id">Call sheet ATP-001</span>
          </div>
          <h1 id="hero-title">Agentic Team Protocol</h1>
          <p class="lead">
            Installable, role-based agent teams for Claude Code. Dispatch goals, gather context, build, verify, and hand off — with every decision recorded in local durable memory.
          </p>
          <div class="hero-actions">
            <a href="#install" class="btn btn-primary">Install in moments</a>
            <a href="/docs/" class="btn btn-secondary">Read the docs</a>
          </div>
        </div>
        <div class="hero-visual" aria-hidden="true">
          <svg viewBox="0 0 520 360" width="100%" height="auto" xmlns="http://www.w3.org/2000/svg">
            <defs>
              <linearGradient id="board" x1="0" y1="0" x2="1" y2="1">
                <stop offset="0%" stop-color="#0e1a19" />
                <stop offset="100%" stop-color="#132322" />
              </linearGradient>
            </defs>
            <rect x="40" y="220" width="440" height="100" rx="16" fill="url(#board)" stroke="#424f4f" stroke-width="1.5" />

            <g transform="translate(70, 130)">
              <path d="M0 40 L70 10 L140 40 L70 70 Z" fill="#0e1a19" stroke="#3ddc91" stroke-width="1.5" />
              <path d="M0 40 L0 90 L70 120 L70 70 Z" fill="#132322" stroke="#3ddc91" stroke-width="1.5" />
              <path d="M70 70 L70 120 L140 90 L140 40 Z" fill="#0a1615" stroke="#3ddc91" stroke-width="1.5" />
              <text x="70" y="50" text-anchor="middle" font-family="JetBrains Mono, ui-monospace, monospace" font-size="11" font-weight="700" fill="#3ddc91">DISPATCH</text>
            </g>

            <g transform="translate(200, 80)">
              <path d="M0 40 L70 10 L140 40 L70 70 Z" fill="#0e1a19" stroke="#97ddbc" stroke-width="1.5" />
              <path d="M0 40 L0 90 L70 120 L70 70 Z" fill="#132322" stroke="#97ddbc" stroke-width="1.5" />
              <path d="M70 70 L70 120 L140 90 L140 40 Z" fill="#0a1615" stroke="#97ddbc" stroke-width="1.5" />
              <text x="70" y="50" text-anchor="middle" font-family="JetBrains Mono, ui-monospace, monospace" font-size="11" font-weight="700" fill="#97ddbc">RESEARCH</text>
            </g>

            <g transform="translate(330, 130)">
              <path d="M0 40 L70 10 L140 40 L70 70 Z" fill="#0e1a19" stroke="#ffcd48" stroke-width="1.5" />
              <path d="M0 40 L0 90 L70 120 L70 70 Z" fill="#132322" stroke="#ffcd48" stroke-width="1.5" />
              <path d="M70 70 L70 120 L140 90 L140 40 Z" fill="#0a1615" stroke="#ffcd48" stroke-width="1.5" />
              <text x="70" y="50" text-anchor="middle" font-family="JetBrains Mono, ui-monospace, monospace" font-size="11" font-weight="700" fill="#ffcd48">BUILD</text>
            </g>

            <g transform="translate(140, 210)">
              <path d="M0 40 L70 10 L140 40 L70 70 Z" fill="#0e1a19" stroke="#ffffff" stroke-width="1.5" />
              <path d="M0 40 L0 90 L70 120 L70 70 Z" fill="#132322" stroke="#ffffff" stroke-width="1.5" />
              <path d="M70 70 L70 120 L140 90 L140 40 Z" fill="#0a1615" stroke="#ffffff" stroke-width="1.5" />
              <text x="70" y="50" text-anchor="middle" font-family="JetBrains Mono, ui-monospace, monospace" font-size="11" font-weight="700" fill="#ffffff">VERIFY</text>
            </g>

            <path d="M175 200 L235 150" stroke="#424f4f" stroke-width="1.5" stroke-dasharray="4 4" />
            <path d="M305 200 L370 155" stroke="#424f4f" stroke-width="1.5" stroke-dasharray="4 4" />
            <circle cx="235" cy="150" r="4" fill="#3ddc91" />
            <circle cx="370" cy="155" r="4" fill="#ffcd48" />
          </svg>
        </div>
      </div>
    </section>

    <section class="section install-section" id="install" aria-labelledby="install-title">
      <div class="wrap">
        <div class="install-card">
          <div class="install-head">
            <div class="install-title-group">
              <span class="eyebrow">Today's call sheet</span>
              <h2 id="install-title">Install in moments</h2>
              <p class="install-subtitle">Install ATP, wire your project, restart Claude Code, then ratify the charter.</p>
            </div>
            <span class="status-chip ready"><span class="status-dot" aria-hidden="true"></span>Ready to shoot</span>
          </div>

          <ol class="install-list" role="list">
            <li class="install-block">
              <div class="block-label">1. Install eden-memory</div>
              <div class="step-row">
                <code class="cmd">{memoryInstall}</code>
                <button class="copy-btn" type="button" data-cmd={memoryInstall} aria-label="Copy eden-memory install command">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path></svg>
                </button>
              </div>
              <p class="install-hint">Memory, sync, and the MCP server.</p>
            </li>
            <li class="install-block">
              <div class="block-label">2. Install Agentic Team Protocol</div>
              <div class="step-row">
                <code class="cmd">{atpInstall}</code>
                <button class="copy-btn" type="button" data-cmd={atpInstall} aria-label="Copy ATP install command">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path></svg>
                </button>
              </div>
              <p class="install-hint">Global ATP primitives into ~/.claude/.</p>
            </li>
            <li class="install-block">
              <div class="block-label">3. Wire your project</div>
              <div class="step-row">
                <code class="cmd">{setupCmd}</code>
                <button class="copy-btn" type="button" data-cmd={setupCmd} aria-label="Copy setup command">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path></svg>
                </button>
              </div>
              <p class="install-hint">Connects the MCP server to this project.</p>
            </li>
            <li class="install-block">
              <div class="block-label">4. Restart Claude Code</div>
              <p class="install-hint">Run <code>/exit</code>, then reopen so the ATP agents and slash commands load.</p>
            </li>
            <li class="install-block">
              <div class="block-label">5. Ratify the project charter</div>
              <p class="install-hint">
                Follow the <a href="/agentic-team-protocol/getting-started/">ATP quick start</a> to edit and ratify your charter, then run your first team goal.
              </p>
            </li>
          </ol>
        </div>
      </div>
    </section>

    <section class="section products-section" aria-labelledby="products-title">
      <div class="wrap">
        <div class="section-head">
          <span class="eyebrow">Two paths into the same system</span>
          <h2 id="products-title">Pick the surface that matches what you are building today.</h2>
        </div>
        <div class="product-grid">
          <a href={atpCard.href} class="product-card">
            <span class="product-tag">{atpCard.tag}</span>
            <h3 class="product-name">{atpCard.name}</h3>
            <p class="product-desc">{atpCard.desc}</p>
            <div class="product-links">
              {atpCard.links.map(link => <span class="product-link">{link.label}</span>)}
            </div>
          </a>
          <a href={memoryCard.href} class="product-card">
            <span class="product-tag">{memoryCard.tag}</span>
            <h3 class="product-name">{memoryCard.name}</h3>
            <p class="product-desc">{memoryCard.desc}</p>
            <div class="product-links">
              {memoryCard.links.map(link => <span class="product-link">{link.label}</span>)}
            </div>
          </a>
        </div>
      </div>
    </section>

    <section class="section binaries-section" aria-labelledby="binaries-title">
      <div class="wrap">
        <div class="section-head">
          <span class="eyebrow">Three binaries, one release</span>
          <h2 id="binaries-title">Every release ships three static Go binaries.</h2>
        </div>
        <ul class="binary-list" role="list">
          {binaries.map(b => (
            <li class="binary-card">
              <div class="binary-main">
                <a href={b.href} class="binary-name">{b.name}</a>
                <p class="binary-role">{b.role}</p>
              </div>
              <span class="binary-size">{b.size}</span>
            </li>
          ))}
        </ul>
        <div class="binaries-foot">
          <a href="/eden-memory/reference/downloads/" class="reminder-link">Browse downloads and checksums →</a>
        </div>
      </div>
    </section>

    <section class="section decision-section" aria-labelledby="decision-title">
      <div class="wrap">
        <div class="section-head">
          <span class="eyebrow">Decision map</span>
          <h2 id="decision-title">Which one do I need?</h2>
        </div>
        <div class="decision-grid">
          <div class="decision-card">
            <h3 class="decision-question">I want role-based agent teams in Claude Code</h3>
            <p class="decision-answer">
              Install <a href="/eden-memory/getting-started/">eden-memory</a> first, then run the <a href="/agentic-team-protocol/getting-started/">ATP installer</a>.
            </p>
          </div>
          <div class="decision-card">
            <h3 class="decision-question">I just want MCP memory for my client</h3>
            <p class="decision-answer">
              Install <a href="/eden-memory/getting-started/">eden-memory</a> only, then run <code>eden-memory setup claude</code>.
            </p>
          </div>
          <div class="decision-card">
            <h3 class="decision-question">I need multi-device sync</h3>
            <p class="decision-answer">
              Use <a href="/eden-relay/how-to/run-relay-server/">eden-relay</a> as a self-hosted relay. Contents are encrypted end-to-end.
            </p>
          </div>
          <div class="decision-card">
            <h3 class="decision-question">I want headless ATP in CI or cron</h3>
            <p class="decision-answer">
              Use <a href="/eden-team/tutorials/headless-supervisor/">eden-team</a>, the headless supervisor.
            </p>
          </div>
        </div>
      </div>
    </section>
  </main>

  <footer class="site-footer">
    <div class="wrap footer-row">
      <span class="footer-copy">© 2026 0d3sa. Open source under Apache-2.0.</span>
      <nav class="footer-links" aria-label="Footer">
        <a href="https://github.com/yakovkhalinsky/eden-releases">GitHub</a>
        <span class="sep" aria-hidden="true">·</span>
        <a href="/docs/">Docs</a>
        <span class="sep" aria-hidden="true">·</span>
        <a href="/eden-memory/reference/downloads/">Downloads</a>
        <span class="sep" aria-hidden="true">·</span>
        <a href="https://github.com/yakovkhalinsky/eden-releases/releases">Release notes</a>
      </nav>
    </div>
  </footer>

  <script is:inline>
    (function () {
      var btns = document.querySelectorAll('.copy-btn');
      btns.forEach(function (btn) {
        btn.addEventListener('click', function () {
          var text = btn.getAttribute('data-cmd');
          if (!text) return;
          if (navigator.clipboard) {
            navigator.clipboard.writeText(text).then(function () {
              var old = btn.innerHTML;
              btn.innerHTML = '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"></polyline></svg>';
              btn.setAttribute('aria-label', 'Copied');
              setTimeout(function () {
                btn.innerHTML = old;
                btn.setAttribute('aria-label', 'Copy command');
              }, 1400);
            });
          }
        });
      });
    })();
  </script>
</body>
</html>

<style>
  :root {
    --obsidian: #132322;
    --abyss: #0e1a19;
    --charcoal: #070f0f;
    --neon: #3ddc91;
    --mint: #97ddbc;
    --yellow: #ffcd48;
    --white: #ffffff;
    --slate: #828786;
    --graphite: #424f4f;
    --fog: #d0d3d3;
    --mint-frost: #edf7f5;
    --neon-soft: rgba(61, 220, 145, 0.12);
    --neon-border: rgba(61, 220, 145, 0.3);
    --radius-sm: 10px;
    --radius-md: 20px;
    --radius-lg: 60px;
    --radius-pill: 56px;
    --max: 1200px;
    --display: "Chakra Petch", "Saira", -apple-system, BlinkMacSystemFont, sans-serif;
    --body: "Saira", -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    --mono: "JetBrains Mono", ui-monospace, monospace;
    --shadow: 0 1px 0 rgba(0, 0, 0, 0.04);
  }

  *, *::before, *::after { box-sizing: border-box; }

  html, body {
    margin: 0;
    padding: 0;
    font-family: var(--body);
    color: var(--white);
    background: var(--obsidian);
    line-height: 1.6;
    -webkit-font-smoothing: antialiased;
  }

  a {
    color: var(--neon);
    text-decoration: none;
  }
  a:hover { text-decoration: underline; }

  code {
    font-family: var(--mono);
    font-size: 0.9em;
    background: var(--abyss);
    border: 1px solid var(--graphite);
    border-radius: var(--radius-sm);
    padding: 2px 6px;
    color: var(--white);
  }

  .wrap {
    max-width: var(--max);
    margin: 0 auto;
    padding: 0 24px;
  }

  /* Header */
  .site-header {
    border-bottom: 1px solid var(--graphite);
    background: var(--obsidian);
    position: sticky;
    top: 0;
    z-index: 50;
  }

  .nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 64px;
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 10px;
    color: var(--white);
    font-weight: 500;
    font-size: 1.1rem;
    font-family: var(--display);
  }
  .brand:hover { text-decoration: none; }

  .brand-mark {
    width: 32px;
    height: 32px;
    border-radius: var(--radius-sm);
    display: block;
  }

  .nav-links {
    display: flex;
    gap: 28px;
    align-items: center;
    font-size: 0.92rem;
  }

  .nav-links a {
    color: var(--slate);
    font-weight: 400;
  }
  .nav-links a:hover { color: var(--white); text-decoration: none; }

  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    padding: 14px 28px;
    border-radius: var(--radius-pill);
    font-weight: 500;
    font-size: 0.92rem;
    border: 1.5px solid transparent;
    cursor: pointer;
    transition: background-color .15s ease, border-color .15s ease, color .15s ease;
    text-decoration: none;
    line-height: 1;
    font-family: var(--body);
  }
  .btn:hover { text-decoration: none; }

  .btn-primary {
    background: var(--neon);
    color: var(--obsidian);
  }
  .btn-primary:hover { background: var(--mint); }

  .btn-secondary {
    background: transparent;
    border-color: var(--white);
    color: var(--white);
  }
  .btn-secondary:hover { background: rgba(255, 255, 255, 0.08); }

  .btn-sm {
    padding: 8px 16px;
    font-size: 0.82rem;
    background: var(--abyss);
    border-color: var(--graphite);
    color: var(--slate);
  }
  .btn-sm:hover { border-color: var(--neon); color: var(--neon); background: var(--abyss); }

  /* Status chips */
  .status-chip {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 4px 10px;
    border-radius: 999px;
    font-size: 0.72rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    border: 1px solid transparent;
    white-space: nowrap;
    font-family: var(--mono);
  }

  .status-chip.ready {
    background: rgba(61, 220, 145, 0.12);
    color: var(--neon);
    border-color: var(--neon-border);
  }

  .status-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: currentColor;
  }

  /* Hero */
  .hero {
    padding: 80px 0 64px;
    border-bottom: 1px solid var(--graphite);
    background: var(--obsidian);
  }

  .hero-wrap {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 48px;
    align-items: center;
  }

  .product-meta {
    display: flex;
    gap: 14px;
    align-items: center;
    margin-bottom: 18px;
    flex-wrap: wrap;
  }

  .call-sheet-id {
    font-family: var(--mono);
    font-size: 0.72rem;
    color: var(--slate);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  h1 {
    font-family: var(--display);
    font-size: clamp(2.6rem, 6vw, 4.2rem);
    line-height: 1.05;
    font-weight: 500;
    letter-spacing: -0.03em;
    margin: 0 0 18px;
    color: var(--white);
    text-transform: uppercase;
  }

  .lead {
    font-size: clamp(1.05rem, 1.8vw, 1.25rem);
    color: var(--slate);
    margin: 0 0 28px;
    line-height: 1.55;
    max-width: 540px;
  }

  .hero-actions {
    display: flex;
    gap: 14px;
    flex-wrap: wrap;
  }

  .hero-visual svg {
    width: 100%;
    height: auto;
    max-width: 520px;
  }

  /* Sections */
  .section {
    padding: 80px 0;
  }

  .section-head {
    margin-bottom: 48px;
    max-width: 640px;
  }

  .eyebrow {
    display: block;
    font-family: var(--mono);
    font-size: 0.72rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--neon);
    margin-bottom: 12px;
  }

  .section-head h2 {
    font-family: var(--display);
    font-size: clamp(1.5rem, 3vw, 2.2rem);
    font-weight: 500;
    line-height: 1.1;
    margin: 0;
    letter-spacing: -0.02em;
    color: var(--white);
  }

  /* Install card */
  .install-section { background: var(--obsidian); }

  .install-card {
    background: var(--abyss);
    border: 1px solid var(--graphite);
    border-radius: var(--radius-lg);
    padding: 40px;
  }

  .install-head {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 18px;
    margin-bottom: 32px;
    flex-wrap: wrap;
  }

  .install-title-group h2 {
    font-family: var(--display);
    font-size: clamp(1.6rem, 3.5vw, 2.4rem);
    font-weight: 500;
    margin: 0 0 8px;
    letter-spacing: -0.02em;
    color: var(--white);
  }

  .install-subtitle {
    color: var(--slate);
    margin: 0;
    font-size: 1rem;
    max-width: 520px;
  }

  .install-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .install-block {
    background: var(--charcoal);
    border: 1px solid var(--graphite);
