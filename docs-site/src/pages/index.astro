---
// Landing page for 0d3sa.com.
// ATP-first product entry point. Detailed install steps live in Starlight docs.

const edenMemoryInstall = 'curl -fsSL https://0d3sa.com/eden-memory/install.sh | sh';
const atpInstall = 'curl -fsSL https://0d3sa.com/agentic-team-protocol/install.sh | sh';
---

<!DOCTYPE html>
<html lang="en" class="dark">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>0d3sa — installable agent teams for Claude Code</title>
  <meta name="description" content="Agentic Team Protocol: installable, role-based agent teams for Claude Code. Durable memory, sync, and headless orchestration included." />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;700&family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
</head>
<body>
  <header class="site-header">
    <div class="wrap nav">
      <a href="/" class="brand">
        <span class="brand-mark">0</span>
        <span>0d3sa</span>
      </a>
      <nav class="nav-links">
        <a href="/docs/">Docs</a>
        <a href="https://github.com/yakovkhalinsky/eden-releases" target="_blank" rel="noreferrer">GitHub</a>
        <a href="/eden-memory/reference/downloads/" class="btn btn-primary">Download</a>
      </nav>
    </div>
  </header>

  <main>
    <section class="hero">
      <div class="wrap">
        <div class="pill">
          <span class="dot"></span>
          <span>Open source · Apache-2.0 · macOS + Linux</span>
        </div>
        <h1>Installable agent teams for Claude Code</h1>
        <p class="lead">
          The Agentic Team Protocol gives Claude Code a structured, role-based team workflow with a seven-stage lifecycle and durable memory. eden-memory, eden-relay, and eden-team are the components that make it work.
        </p>
        <div class="hero-actions">
          <a href="/agentic-team-protocol/getting-started/" class="btn btn-primary btn-lg">Install ATP</a>
          <a href="/docs/" class="btn btn-secondary btn-lg">Explore components</a>
        </div>
      </div>
    </section>

    <section class="section install-section">
      <div class="wrap">
        <div class="install-card">
          <div class="install-head">
            <div>
              <span class="install-label">Install in two commands</span>
              <p class="install-hint">No package manager required. Each binary is a single static file.</p>
            </div>
          </div>
          <div class="install-steps">
            <div class="install-step">
              <span class="step-badge">1</span>
              <code class="mono install-cmd">{edenMemoryInstall}</code>
              <span class="step-caption">Install the memory & sync layer</span>
            </div>
            <div class="install-step">
              <span class="step-badge">2</span>
              <code class="mono install-cmd">{atpInstall}</code>
              <span class="step-caption">Install the Agentic Team Protocol</span>
            </div>
          </div>
          <p class="install-more">
            Then run <code>eden-memory setup claude</code> in your project and restart Claude Code. Also available: <a href="/eden-memory/reference/downloads/">downloads and checksums</a>.
          </p>
        </div>
      </div>
    </section>

    <section class="section products-section">
      <div class="wrap">
        <h2 class="section-title">What you get</h2>
        <div class="product-grid">
          <a href="/agentic-team-protocol/" class="product-card product-card-primary">
            <div class="product-meta">
              <span class="product-tag">Installable product</span>
            </div>
            <h3>Agentic Team Protocol</h3>
            <p>Role-based agent teams inside Claude Code. Dispatcher, Researcher, Builder, Verifier, Archivist, and Runtime with a seven-stage lifecycle and durable memory records.</p>
            <ul class="feature-list">
              <li>Structured role-based collaboration</li>
              <li>Mandatory Verifier gate before closure</li>
              <li>Resumable goals across sessions</li>
            </ul>
            <span class="product-link">Get started →</span>
          </a>

          <a href="/eden-memory/" class="product-card">
            <div class="product-meta">
              <span class="product-tag">Memory & sync component</span>
            </div>
            <h3>eden-memory</h3>
            <p>The durable memory layer for ATP. Local SQLite + 256-dim vector embeddings, semantic/keyword recall, optional encrypted multi-device sync.</p>
            <ul class="feature-list">
              <li>Local-first SQLite store</li>
              <li>Semantic and keyword search</li>
              <li>MCP server for any stdio client</li>
            </ul>
            <span class="product-link">Read docs →</span>
          </a>

          <a href="/eden-relay/" class="product-card">
            <div class="product-meta">
              <span class="product-tag">Infrastructure component</span>
            </div>
            <h3>eden-relay</h3>
            <p>Self-hosted relay server for encrypted multi-device sync. Lightweight, no MCP or memory subcommands.</p>
            <ul class="feature-list">
              <li>Self-hosted fleet relay</li>
              <li>TLS, systemd, VPS hardening guides</li>
              <li>Devices stay opaque to the relay</li>
            </ul>
            <span class="product-link">Read docs →</span>
          </a>

          <a href="/eden-team/" class="product-card">
            <div class="product-meta">
              <span class="product-tag">Infrastructure component</span>
            </div>
            <h3>eden-team</h3>
            <p>Headless ATP supervisor for CI, cron, or automated agent-team workflows. Spawns role subagents and writes durable lifecycle records.</p>
            <ul class="feature-list">
              <li>Headless goal execution</li>
              <li>JSON output for automation</li>
              <li>Resume interrupted goals</li>
            </ul>
            <span class="product-link">Read docs →</span>
          </a>
        </div>
      </div>
    </section>

    <section class="section section-alt">
      <div class="wrap">
        <h2 class="section-title">Three binaries, one release</h2>
        <p class="section-lead">Each release ships three single-file Go binaries. You usually install all three through the ATP installer; pick the component docs for deep configuration.</p>
        <div class="binary-grid">
          <div class="binary-card">
            <div class="binary-icon">M</div>
            <div class="binary-body">
              <h3>eden-memory</h3>
              <p>Memory, MCP server, sync, pairing, and the legacy relay-server subcommand.</p>
            </div>
          </div>
          <div class="binary-card">
            <div class="binary-icon">R</div>
            <div class="binary-body">
              <h3>eden-relay</h3>
              <p>Dedicated, lightweight relay server for multi-device sync.</p>
            </div>
          </div>
          <div class="binary-card">
            <div class="binary-icon">T</div>
            <div class="binary-body">
              <h3>eden-team</h3>
              <p>Headless ATP supervisor for automated agent-team workflows.</p>
            </div>
          </div>
        </div>
        <div class="downloads-cta">
          <a href="/eden-memory/reference/downloads/" class="btn btn-secondary">See downloads and checksums →</a>
        </div>
      </div>
    </section>

    <section class="section" id="which-one">
      <div class="wrap">
        <div class="section-title-with-link">
          <h2 class="section-title">Which one do I need?</h2>
          <a href="#which-one" class="anchor-link" aria-label="Link to Which one do I need?">#</a>
        </div>
        <div class="decision-grid">
          <div class="decision-card">
            <h3>Want a team workflow in Claude Code?</h3>
            <p>Install <a href="/agentic-team-protocol/">Agentic Team Protocol</a>. It wires eden-memory as the durable substrate and gives you structured role-based collaboration.</p>
          </div>
          <div class="decision-card">
            <h3>Just want memory or sync?</h3>
            <p>Go straight to the <a href="/eden-memory/">eden-memory</a> component docs. You can add ATP later without reinstalling.</p>
          </div>
          <div class="decision-card decision-answer">
            <h3>Short answer</h3>
            <p>Install ATP. It brings eden-memory with it. Add eden-relay only if you need multi-device sync, and eden-team only for headless automation.</p>
          </div>
        </div>
      </div>
    </section>
  </main>

  <footer class="site-footer">
    <div class="wrap footer-row">
      <span>© 2026 0d3sa. Open source under Apache-2.0.</span>
      <span class="footer-links">
        <a href="https://github.com/yakovkhalinsky/eden-releases">GitHub</a>
        <span class="sep">·</span>
        <a href="/docs/">Docs</a>
        <span class="sep">·</span>
        <a href="/eden-memory/reference/downloads/">Downloads</a>
        <span class="sep">·</span>
        <a href="https://github.com/yakovkhalinsky/eden-releases/releases">Releases</a>
      </span>
    </div>
  </footer>

  <script is:inline>
    (function () {
      var btns = document.querySelectorAll('.copy-btn');
      btns.forEach(function (btn) {
        btn.addEventListener('click', function () {
          var text = btn.getAttribute('data-cmd');
          if (!text) return;
          if (navigator.clipboard) {
            navigator.clipboard.writeText(text).then(function () {
              var old = btn.textContent;
              btn.textContent = 'Copied';
              setTimeout(function () { btn.textContent = old; }, 1200);
            });
          }
        });
      });
    })();
  </script>
</body>
</html>

<style>
  :root {
    --bg: #0b0d10;
    --bg-elevated: #11141a;
    --bg-card: #151922;
    --bg-warm: #18141a;
    --text: #f0f2f6;
    --text-muted: #8b94a7;
    --border: #232834;
    --accent: #2d6a4f;
    --accent-600: #40916c;
    --accent-glow: rgba(45, 106, 79, 0.18);
    --amber: #f2b65a;
    --amber-soft: rgba(242, 182, 90, 0.12);
    --green: #5df0a8;
    --radius: 14px;
    --max: 980px;
  }

  html, body {
    margin: 0;
    padding: 0;
    font-family: Inter, -apple-system, BlinkMacSystemFont, sans-serif;
    color: var(--text);
    background: var(--bg);
    line-height: 1.6;
    -webkit-font-smoothing: antialiased;
  }

  .mono { font-family: JetBrains Mono, ui-monospace, monospace; }

  a { color: var(--accent); text-decoration: none; }
  a:hover { text-decoration: underline; }

  .wrap {
    max-width: var(--max);
    margin: 0 auto;
    padding: 0 24px;
  }

  .site-header {
    border-bottom: 1px solid var(--border);
    background: var(--bg);
  }

  .nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 64px;
  }

  .brand {
    font-weight: 800;
    font-size: 1.15rem;
    display: flex;
    align-items: center;
    gap: 10px;
    color: var(--text);
  }

  .brand-mark {
    width: 28px;
    height: 28px;
    border-radius: 8px;
    background: var(--accent);
    color: var(--bg);
    display: grid;
    place-items: center;
    font-family: JetBrains Mono, monospace;
    font-size: 0.85rem;
    font-weight: 700;
  }

  .nav-links {
    display: flex;
    gap: 22px;
    align-items: center;
    font-size: 0.88rem;
  }

  .nav-links a { color: var(--text-muted); font-weight: 500; }
  .nav-links a:hover { color: var(--text); text-decoration: none; }

  .btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 10px 18px;
    border-radius: 10px;
    font-weight: 600;
    font-size: 0.88rem;
    border: 1px solid transparent;
    cursor: pointer;
    transition: all .12s ease;
    text-decoration: none;
  }

  .btn-primary { background: var(--accent); color: var(--text); }
  .btn-primary:hover { background: var(--accent-600); text-decoration: none; }

  .btn-secondary {
    background: transparent;
    border-color: var(--border);
    color: var(--text);
  }
  .btn-secondary:hover { border-color: var(--accent); color: var(--accent); text-decoration: none; }

  .btn-lg { padding: 14px 24px; font-size: 1rem; }

  .hero { padding: 72px 0 48px; text-align: center; }

  .pill {
    display: inline-flex;
    gap: 8px;
    align-items: center;
    padding: 6px 14px;
    border-radius: 999px;
    background: var(--bg-elevated);
    border: 1px solid var(--border);
    color: var(--text-muted);
    font-size: 0.76rem;
    font-weight: 700;
    margin-bottom: 20px;
  }

  .pill .dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--green);
  }

  h1 {
    font-family: Inter, sans-serif;
    font-size: clamp(2.6rem, 6vw, 4.2rem);
    line-height: 1.08;
    font-weight: 800;
    letter-spacing: -0.03em;
    margin: 0 0 12px;
  }

  .lead {
    font-size: clamp(1.05rem, 1.8vw, 1.25rem);
    color: var(--text-muted);
    max-width: 720px;
    margin: 0 auto 28px;
  }

  .hero-actions {
    display: flex;
    gap: 14px;
    justify-content: center;
    flex-wrap: wrap;
  }

  .section { padding: 64px 0; }
  .section-alt { background: var(--bg-warm); }

  .install-section { padding-top: 24px; }

  .install-card {
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 22px;
    max-width: 760px;
    margin: 0 auto;
    box-shadow: 0 0 60px var(--accent-glow);
  }

  .install-head {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 16px;
    margin-bottom: 18px;
    flex-wrap: wrap;
  }

  .install-label {
    display: block;
    font-weight: 700;
    font-size: 1rem;
    margin-bottom: 4px;
  }

  .install-hint {
    color: var(--text-muted);
    font-size: 0.88rem;
    margin: 0;
  }

  .install-steps {
    display: flex;
    flex-direction: column;
    gap: 14px;
    margin-bottom: 14px;
  }

  .install-step {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 12px;
    align-items: center;
  }

  .step-badge {
    grid-row: span 2;
    width: 28px;
    height: 28px;
    border-radius: 50%;
    background: var(--accent);
    color: var(--text);
    display: grid;
    place-items: center;
    font-size: 0.8rem;
    font-weight: 700;
  }

  .install-cmd {
    display: block;
    background: var(--bg-elevated);
    border: 1px solid var(--border);
    border-radius: 10px;
    padding: 12px 14px;
    font-size: 0.85rem;
    color: var(--text);
    overflow-x: auto;
    white-space: nowrap;
  }

  .step-caption {
    color: var(--text-muted);
    font-size: 0.82rem;
  }

  .install-more {
    color: var(--text-muted);
    font-size: 0.88rem;
    margin: 0;
  }

  .copy-btn {
    background: var(--bg-elevated);
    border: 1px solid var(--text-muted);
    color: var(--text);
    padding: 8px 14px;
    border-radius: 8px;
    font-size: 0.8rem;
    cursor: pointer;
    font-weight: 700;
    font-family: Inter, sans-serif;
  }
  .copy-btn:hover { background: var(--accent-600); color: var(--text); border-color: var(--accent); }

  .section-title {
    text-align: center;
    font-size: 1.4rem;
    margin-bottom: 10px;
  }

  .section-lead {
    text-align: center;
    color: var(--text-muted);
    max-width: 560px;
    margin: 0 auto 28px;
  }

  .products-section { background: var(--bg-elevated); border-top: 1px solid var(--border); }

  .product-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: 18px;
    max-width: 960px;
    margin: 0 auto;
  }

  .product-card {
    display: flex;
    flex-direction: column;
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 24px;
    color: var(--text);
  }
  .product-card:hover {
    border-color: var(--accent);
    text-decoration: none;
  }

  .product-card-primary {
    border-color: var(--accent);
    box-shadow: 0 0 0 1px var(--accent) inset, 0 0 40px var(--accent-glow);
  }

  .product-meta { margin-bottom: 10px; }
  .product-tag {
    display: inline-block;
    padding: 4px 10px;
    border-radius: 999px;
    background: var(--amber-soft);
    color: var(--amber);
    font-size: 0.72rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .product-card h3 {
    font-size: 1.3rem;
    font-weight: 700;
    margin-bottom: 10px;
  }
  .product-card p {
    color: var(--text-muted);
    font-size: 0.95rem;
    margin-bottom: 16px;
  }

  .feature-list {
    list-style: none;
    padding: 0;
    margin: 0 0 18px;
  }
  .feature-list li {
    display: flex;
    gap: 10px;
    align-items: baseline;
    color: var(--text-muted);
    font-size: 0.9rem;
    margin-bottom: 8px;
  }
  .feature-list li::before {
    content: "✓";
    color: var(--green);
    font-weight: 700;
  }

  .product-link {
    color: var(--accent);
    font-size: 0.95rem;
    font-weight: 600;
    margin-top: auto;
  }

  .binary-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
    max-width: 860px;
    margin: 0 auto 24px;
  }

  .binary-card {
    display: flex;
    gap: 16px;
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 20px;
  }

  .binary-icon {
    flex-shrink: 0;
    width: 44px;
    height: 44px;
    border-radius: 10px;
    background: var(--bg-elevated);
    border: 1px solid var(--border);
    display: grid;
    place-items: center;
    font-family: JetBrains Mono, monospace;
    font-weight: 700;
    color: var(--accent);
    font-size: 1.1rem;
  }

  .binary-body h3 {
    font-size: 1.05rem;
    font-weight: 700;
    margin-bottom: 6px;
  }
  .binary-body p {
    color: var(--text-muted);
    font-size: 0.88rem;
    margin: 0;
  }

  .downloads-cta {
    text-align: center;
  }

  .decision-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 18px;
    max-width: 900px;
    margin: 0 auto;
  }

  .decision-card {
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 22px;
  }

  .decision-card h3 {
    font-size: 1rem;
    font-weight: 700;
    margin-bottom: 8px;
  }

  .decision-card p {
    color: var(--text-muted);
    font-size: 0.92rem;
    margin: 0;
  }

  .decision-answer {
    border-color: var(--accent);
    box-shadow: 0 0 0 1px var(--accent) inset;
  }

  .section-title-with-link {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    margin-bottom: 28px;
  }

  .section-title-with-link .section-title {
    margin: 0;
  }

  .anchor-link {
    color: var(--text-muted);
    font-size: 1.1rem;
    font-weight: 700;
    text-decoration: none;
    opacity: 0.6;
  }
  .anchor-link:hover { color: var(--accent); opacity: 1; }

  .site-footer {
    border-top: 1px solid var(--border);
    padding: 32px 0;
    color: var(--text-muted);
    font-size: 0.84rem;
    background: var(--bg);
  }

  .footer-row {
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 14px;
  }

  .footer-links .sep { margin: 0 6px; color: var(--text-muted); }

  @media (max-width: 800px) {
    .binary-grid { grid-template-columns: 1fr; }
    .decision-grid { grid-template-columns: 1fr; }
    .product-grid { grid-template-columns: 1fr; }
    .hero { padding: 56px 0 40px; }
    .section { padding: 48px 0; }
    .hero-actions { flex-direction: column; align-items: stretch; }
    .hero-actions .btn { justify-content: center; }
    .install-step { grid-template-columns: auto 1fr; }
  }
</style>
