---
// Landing page for 0d3sa.com.
// Visual world: Local-first product — clean, light, developer-product surface
// that foregrounds install and the protocol lifecycle.
// Mode: Persuade (landing → install → docs).

const edenMemoryInstall = 'curl -fsSL https://0d3sa.com/eden-memory/install.sh | sh';
const atpInstall = 'curl -fsSL https://0d3sa.com/agentic-team-protocol/install.sh | sh';
const setupCmd = 'eden-memory setup claude';
const charterCmd = '/team-charter';
const teamCmd = '/team <your first goal>';

const roles = [
  { name: 'Dispatcher', duty: 'Assigns goals and routes work', status: 'active' },
  { name: 'Researcher', duty: 'Investigates options and reports', status: 'active' },
  { name: 'Builder', duty: 'Implements the chosen approach', status: 'active' },
  { name: 'Verifier', duty: 'Reviews for correctness and charter compliance', status: 'active' },
  { name: 'Archivist', duty: 'Records lifecycle and manages memory hygiene', status: 'active' },
  { name: 'Runtime', duty: 'Executes operational actions', status: 'restricted' },
];

const stages = [
  { id: '01', name: 'Goal receipt', owner: 'Dispatcher', desc: 'Capture the request and constraints.' },
  { id: '02', name: 'Routing and assignment', owner: 'Dispatcher', desc: 'Assign target role, owner, deadline, success criteria.' },
  { id: '03', name: 'Context gathering', owner: 'Researcher', desc: 'Record known facts and options considered.' },
  { id: '04', name: 'Action', owner: 'Builder / Runtime', desc: 'Execute and record what was done.' },
  { id: '05', name: 'Verification', owner: 'Verifier', desc: 'Write green, red, or blocked verdict.' },
  { id: '06', name: 'Recording and archival', owner: 'Archivist', desc: 'Ensure final outcome and skill updates are stored.' },
  { id: '07', name: 'Hand-off or closure', owner: 'Archivist', desc: 'Confirm records are complete and transfer ownership if needed.' },
];

const components = [
  {
    tag: 'Memory & sync',
    name: 'eden-memory',
    desc: 'Local-first SQLite memory with vector embeddings, MCP server, and encrypted multi-device sync.',
    links: [
      { label: 'Quick start', href: '/eden-memory/getting-started/' },
      { label: 'Tools', href: '/eden-memory/reference/tools/' },
      { label: 'Sync', href: '/eden-memory/multi-device-sync/' },
    ],
    href: '/eden-memory/',
  },
  {
    tag: 'Relay server',
    name: 'eden-relay',
    desc: 'Self-hosted relay for multi-device sync. TLS, systemd, and VPS hardening guides.',
    links: [
      { label: 'Run a relay', href: '/eden-relay/how-to/run-relay-server/' },
      { label: 'Deploy on VPS', href: '/eden-relay/how-to/deploy-public-vps/' },
    ],
    href: '/eden-relay/',
  },
  {
    tag: 'Headless supervisor',
    name: 'eden-team',
    desc: 'Headless ATP supervisor for CI, cron, or automated agent-team workflows.',
    links: [
      { label: 'Set up headless', href: '/eden-team/tutorials/headless-supervisor/' },
    ],
    href: '/eden-team/',
  },
];
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>0d3sa — Agentic Team Protocol</title>
  <meta name="description" content="Installable, role-based agent teams for Claude Code. Seven-stage lifecycle, durable memory records, and verifiable hand-offs." />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;700&display=swap" rel="stylesheet" />
</head>
<body>
  <!--
    THESIS: The site foregrounds the ATP install/setup path on a clean, light product surface. The visitor sees what ATP is, copies the commands, and understands the role flow before scrolling.
    OWN-WORLD: White and off-white ground, green primary (#16a34a), subtle gray borders, soft shadows, Manrope display and body, JetBrains Mono for commands. Clean product cards with rounded corners and generous spacing. Generated product-style PNG hero image replaces the inline SVG terminal mockup.
    STORY: A developer lands, sees the protocol as a product, copies install commands, and recognizes the role lifecycle.
    FIRST VIEWPORT: Left-aligned product title and lead with green CTAs; right side shows a stylized product terminal mockup. Below, a clean install-steps card is the dominant block.
    FORM: Local-first product (brief-pinned direction; green palette, white background, product-style imagery).
    FINISH: unreviewed and undocumented is unfinished; this build ends with the finish review, the verdict, and DESIGN.md.
  -->

  <header class="site-header">
    <div class="wrap nav">
      <a href="/" class="brand" aria-label="0d3sa home">
        <img src="/images/brand-icon.png" alt="" class="brand-mark" width="32" height="32" aria-hidden="true" />
        <span class="brand-name">0d3sa</span>
      </a>
      <nav class="nav-links" aria-label="Primary">
        <a href="/docs/">Docs</a>
        <a href="https://github.com/yakovkhalinsky/eden-releases" target="_blank" rel="noreferrer">GitHub</a>
        <a href="/eden-memory/reference/downloads/" class="btn btn-sm">Downloads</a>
      </nav>
    </div>
  </header>

  <main>
    <section class="hero" aria-labelledby="hero-title">
      <div class="wrap hero-wrap">
        <div class="hero-copy">
          <div class="product-meta">
            <span class="status-chip ready"><span class="status-dot" aria-hidden="true"></span>Production ready</span>
          </div>
          <h1 id="hero-title">Agentic Team Protocol</h1>
          <p class="lead">
            Installable, role-based agent teams for Claude Code. Dispatch goals, gather context, build, verify, and hand off — with every decision recorded in local durable memory.
          </p>
          <div class="hero-actions">
            <a href="#install-steps" class="btn btn-primary">Install and set up</a>
            <a href="/agentic-team-protocol/getting-started/" class="btn btn-secondary">Full quick start</a>
          </div>
        </div>
      </div>
    </section>

    <section class="install-section" id="install-steps" aria-labelledby="install-steps-title">
      <div class="wrap">
        <div class="section-head">
          <h2 id="install-steps-title">Install in minutes</h2>
          <p class="section-lead">Install the binaries, wire your project, ratify the charter, and dispatch the first goal.</p>
        </div>

        <div class="install-card">
          <ol class="step-list">
            <li class="step">
              <div class="step-num" aria-hidden="true">1</div>
              <div class="step-content">
                <h3 class="step-title">Install eden-memory</h3>
                <p class="step-desc">Memory, sync, and MCP server in one static binary.</p>
                <div class="step-row">
                  <code class="cmd">{edenMemoryInstall}</code>
                  <button class="copy-btn" type="button" data-cmd={edenMemoryInstall} aria-label="Copy install command">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path></svg>
                  </button>
                </div>
              </div>
            </li>
            <li class="step">
              <div class="step-num" aria-hidden="true">2</div>
              <div class="step-content">
                <h3 class="step-title">Install ATP global primitives</h3>
                <p class="step-desc">Role contracts, slash commands, and charter templates into ~/.claude/.</p>
                <div class="step-row">
                  <code class="cmd">{atpInstall}</code>
                  <button class="copy-btn" type="button" data-cmd={atpInstall} aria-label="Copy ATP install command">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path></svg>
                  </button>
                </div>
              </div>
            </li>
            <li class="step">
              <div class="step-num" aria-hidden="true">3</div>
              <div class="step-content">
                <h3 class="step-title">Wire the project</h3>
                <p class="step-desc">Configure the MCP server and project-local templates.</p>
                <div class="step-row">
                  <code class="cmd">cd ~/my-project && {setupCmd}</code>
                  <button class="copy-btn" type="button" data-cmd={`cd ~/my-project\n${setupCmd}`} aria-label="Copy setup command">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path></svg>
                  </button>
                </div>
              </div>
            </li>
            <li class="step">
              <div class="step-num" aria-hidden="true">4</div>
              <div class="step-content">
                <h3 class="step-title">Ratify and dispatch</h3>
                <p class="step-desc">Restart Claude Code, then ratify your charter and run the first goal.</p>
                <div class="step-row">
                  <code class="cmd cmd-inline">{charterCmd}</code>
                  <span class="step-note">after editing the charter</span>
                </div>
                <div class="step-row">
                  <code class="cmd cmd-inline">{teamCmd}</code>
                </div>
              </div>
            </li>
          </ol>
        </div>

        <div class="install-foot">
          <p>Restart Claude Code completely after step 2 (<code>/exit</code>, then reopen). Read the <a href="/agentic-team-protocol/getting-started/">full quick start</a> for details.</p>
        </div>
      </div>
    </section>

    <section class="section roles-section" aria-labelledby="roles-title">
      <div class="wrap">
        <div class="section-head">
          <h2 id="roles-title">Six roles, one lifecycle</h2>
          <p class="section-lead">Each role owns a scope and a decision right. Runtime stays gated until a charter authorises it.</p>
        </div>
        <ul class="role-grid" role="list">
          {roles.map(role => (
            <li class="role-card">
              <div class="role-head">
                <span class="role-name">{role.name}</span>
                <span class={`status-chip ${role.status === 'restricted' ? 'restricted' : 'ready'}`}>
                  <span class="status-dot" aria-hidden="true"></span>{role.status}
                </span>
              </div>
              <p class="role-duty">{role.duty}</p>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <section class="section stages-section" aria-labelledby="stages-title">
      <div class="wrap">
        <div class="section-head">
          <h2 id="stages-title">Seven stages, durable records</h2>
          <p class="section-lead">Every goal moves through the same stages. Each stage writes a record to eden-memory.</p>
        </div>
        <ol class="stage-lanes" role="list">
          {stages.map((stage, i) => (
            <li class="stage-card">
              <div class="stage-header">
                <span class="stage-id" aria-hidden="true">{stage.id}</span>
                <span class="stage-owner">{stage.owner}</span>
                {i === stages.length - 1 && <span class="status-chip ready"><span class="status-dot" aria-hidden="true"></span>Closure</span>}
              </div>
              <h3 class="stage-name">{stage.name}</h3>
              <p class="stage-desc">{stage.desc}</p>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <section class="section components-section" aria-labelledby="components-title">
      <div class="wrap">
        <div class="section-head">
          <h2 id="components-title">Three binaries, one system</h2>
          <p class="section-lead">Install ATP and you get all three. Dive deeper when you need a specific part.</p>
        </div>
        <div class="component-grid">
          {components.map(c => (
            <a href={c.href} class="component-card">
              <div class="component-meta">
                <span class="component-tag">{c.tag}</span>
              </div>
              <h3 class="component-name">{c.name}</h3>
              <p class="component-desc">{c.desc}</p>
              <div class="component-links">
                {c.links.map(link => <span class="component-link">{link.label}</span>)}
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>
  </main>

  <footer class="site-footer">
    <div class="wrap footer-row">
      <span class="footer-copy">© 2026 0d3sa. Open source under Apache-2.0.</span>
      <nav class="footer-links" aria-label="Footer">
        <a href="https://github.com/yakovkhalinsky/eden-releases">GitHub</a>
        <span class="sep" aria-hidden="true">·</span>
        <a href="/docs/">Docs</a>
        <span class="sep" aria-hidden="true">·</span>
        <a href="/eden-memory/reference/downloads/">Downloads</a>
        <span class="sep" aria-hidden="true">·</span>
        <a href="https://github.com/yakovkhalinsky/eden-releases/releases">Releases</a>
      </nav>
    </div>
  </footer>

  <script is:inline>
    (function () {
      var btns = document.querySelectorAll('.copy-btn');
      btns.forEach(function (btn) {
        btn.addEventListener('click', function () {
          var text = btn.getAttribute('data-cmd');
          if (!text) return;
          if (navigator.clipboard) {
            navigator.clipboard.writeText(text).then(function () {
              var old = btn.innerHTML;
              btn.innerHTML = '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"></polyline></svg>';
              btn.setAttribute('aria-label', 'Copied');
              setTimeout(function () {
                btn.innerHTML = old;
                btn.setAttribute('aria-label', 'Copy command');
              }, 1400);
            });
          }
        });
      });
    })();
  </script>
</body>
</html>

<style>
  :root {
    --bg: #fafafa;
    --surface: #ffffff;
    --surface-raised: #f3f4f6;
    --surface-soft: #f0fdf4;
    --border: #e5e7eb;
    --border-subtle: #f3f4f6;
    --text: #111827;
    --text-secondary: #4b5563;
    --text-muted: #6b7280;
    --text-dim: #9ca3af;
    --primary: #16a34a;
    --primary-dark: #15803d;
    --primary-soft: rgba(22, 163, 74, 0.08);
    --primary-soft-border: rgba(22, 163, 74, 0.2);
    --accent: #2563eb;
    --accent-soft: rgba(37, 99, 235, 0.08);
    --ready: #16a34a;
    --restricted: #d97706;
    --blocked: #dc2626;
    --radius-sm: 8px;
    --radius: 12px;
    --radius-lg: 16px;
    --max: 1100px;
    --display: Manrope, -apple-system, BlinkMacSystemFont, sans-serif;
    --body: Manrope, -apple-system, BlinkMacSystemFont, sans-serif;
    --mono: JetBrains Mono, ui-monospace, monospace;
    --shadow-sm: 0 1px 2px 0 rgba(0, 0, 0, 0.04);
    --shadow: 0 1px 3px 0 rgba(0, 0, 0, 0.08), 0 1px 2px -1px rgba(0, 0, 0, 0.08);
    --shadow-md: 0 4px 6px -1px rgba(0, 0, 0, 0.06), 0 2px 4px -2px rgba(0, 0, 0, 0.06);
  }

  *, *::before, *::after { box-sizing: border-box; }

  html, body {
    margin: 0;
    padding: 0;
    font-family: var(--body);
    color: var(--text);
    background: var(--bg);
    line-height: 1.6;
    -webkit-font-smoothing: antialiased;
  }

  a {
    color: var(--primary-dark);
    text-decoration: none;
  }
  a:hover { text-decoration: underline; }

  code {
    font-family: var(--mono);
    font-size: 0.9em;
    background: var(--surface-raised);
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    padding: 2px 6px;
    color: var(--text-secondary);
  }

  .wrap {
    max-width: var(--max);
    margin: 0 auto;
    padding: 0 24px;
  }

  /* Header */
  .site-header {
    border-bottom: 1px solid var(--border);
    background: var(--surface);
    position: sticky;
    top: 0;
    z-index: 50;
  }

  .nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 64px;
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 10px;
    color: var(--text);
    font-weight: 700;
    font-size: 1.1rem;
  }
  .brand:hover { text-decoration: none; }

  .brand-mark {
    width: 32px;
    height: 32px;
    border-radius: var(--radius-sm);
    display: block;
    object-fit: cover;
    box-shadow: var(--shadow-sm);
  }

  .nav-links {
    display: flex;
    gap: 24px;
    align-items: center;
    font-size: 0.9rem;
  }

  .nav-links a {
    color: var(--text-secondary);
    font-weight: 500;
  }
  .nav-links a:hover { color: var(--text); text-decoration: none; }

  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    padding: 12px 20px;
    border-radius: var(--radius-sm);
    font-weight: 600;
    font-size: 0.92rem;
    border: 1px solid transparent;
    cursor: pointer;
    transition: background-color .12s ease, border-color .12s ease, color .12s ease, box-shadow .12s ease;
    text-decoration: none;
    line-height: 1;
  }
  .btn:hover { text-decoration: none; }

  .btn-primary {
    background: var(--primary);
    color: #ffffff;
    box-shadow: var(--shadow-sm);
  }
  .btn-primary:hover { background: var(--primary-dark); }

  .btn-secondary {
    background: var(--surface);
    border-color: var(--border);
    color: var(--text-secondary);
  }
  .btn-secondary:hover { border-color: var(--primary); color: var(--primary); }

  .btn-sm {
    padding: 8px 14px;
    font-size: 0.82rem;
    background: var(--surface);
    border-color: var(--border);
    color: var(--text-secondary);
  }
  .btn-sm:hover { border-color: var(--primary); color: var(--primary); background: var(--surface); }

  /* Status chips */
  .status-chip {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 4px 10px;
    border-radius: 999px;
    font-size: 0.72rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.03em;
    border: 1px solid transparent;
    white-space: nowrap;
  }

  .status-chip.ready {
    background: rgba(22, 163, 74, 0.08);
    color: var(--ready);
    border-color: rgba(22, 163, 74, 0.2);
  }

  .status-chip.restricted {
    background: rgba(217, 119, 6, 0.08);
    color: var(--restricted);
    border-color: rgba(217, 119, 6, 0.2);
  }

  .status-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: currentColor;
  }

  /* Hero */
  .hero {
    padding: 80px 0 64px;
    border-bottom: 1px solid var(--border-subtle);
    background: var(--surface) url('/images/hero-bg.png') center / cover no-repeat;
  }

  .hero-wrap {
    display: block;
    text-align: center;
  }

  .hero-copy {
    max-width: 720px;
    margin: 0 auto;
  }

  .product-meta {
    display: flex;
    gap: 14px;
    align-items: center;
    margin-bottom: 18px;
    flex-wrap: wrap;
  }

  h1 {
    font-family: var(--display);
    font-size: clamp(2.4rem, 5vw, 3.8rem);
    line-height: 1.05;
    font-weight: 800;
    letter-spacing: -0.03em;
    margin: 0 0 18px;
    color: var(--text);
  }

  .hero-copy .lead {
    margin: 0 auto 28px;
  }

  .lead {
    font-size: clamp(1.05rem, 1.6vw, 1.2rem);
    color: var(--text-muted);
    margin: 0 0 28px;
    line-height: 1.6;
  }

  .hero-actions {
    display: flex;
    justify-content: center;
    gap: 14px;
    flex-wrap: wrap;
  }

  .product-meta {
    justify-content: center;
  }

  /* Section head */
  .section-head {
    margin-bottom: 40px;
    text-align: center;
    max-width: 640px;
    margin-left: auto;
    margin-right: auto;
  }

  .section-head h2 {
    font-family: var(--display);
    font-size: clamp(1.6rem, 3vw, 2.2rem);
    font-weight: 700;
    margin: 0 0 10px;
    letter-spacing: -0.02em;
    color: var(--text);
  }

  .section-lead {
    color: var(--text-muted);
    margin: 0;
    font-size: 1.02rem;
    line-height: 1.55;
  }

  /* Install section */
  .install-section {
    padding: 64px 0 80px;
    background: var(--bg) url('/images/install-bg.png') center / cover no-repeat;
    border-top: 1px solid var(--border-subtle);
    border-bottom: 1px solid var(--border-subtle);
  }

  .install-card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    padding: 32px;
    box-shadow: var(--shadow);
  }

  .step-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 32px;
  }

  .step {
    display: flex;
    gap: 14px;
    align-items: flex-start;
  }

  .step-num {
    flex-shrink: 0;
    width: 28px;
    height: 28px;
    border-radius: 50%;
    background: var(--primary);
    color: #ffffff;
    display: grid;
    place-items: center;
    font-family: var(--mono);
    font-size: 0.75rem;
    font-weight: 700;
    margin-top: 2px;
  }

  .step-content {
    flex: 1;
    min-width: 0;
  }

  .step-title {
    font-family: var(--display);
    font-size: 1.05rem;
    font-weight: 700;
    margin: 0 0 4px;
    color: var(--text);
  }

  .step-desc {
    color: var(--text-muted);
    font-size: 0.9rem;
    margin: 0 0 12px;
    line-height: 1.45;
  }

  .step-row {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 8px;
    align-items: center;
  }

  .cmd {
    flex: 1 1 auto;
    display: block;
    background: var(--surface-raised);
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    padding: 10px 12px;
    font-size: 0.78rem;
    color: var(--text);
    overflow-x: auto;
    white-space: pre-wrap;
    word-break: break-word;
    min-width: 0;
    max-width: 100%;
  }

  .cmd-inline {
    width: auto;
    flex: 0 1 auto;
    max-width: 100%;
  }

  .step-note {
    color: var(--text-dim);
    font-size: 0.76rem;
    grid-column: 1 / -1;
    margin-top: 4px;
  }

  .copy-btn {
    flex-shrink: 0;
    flex-grow: 0;
    width: 36px;
    height: 36px;
    display: grid;
    place-items: center;
    background: var(--surface);
    border: 1px solid var(--border);
